customAttribute attribute_01 (
    apexlangName: downloadLink
    attribute: 1
    name: Download Link
    scope: app
    appearance {
        sequence: 10
    }
    dependingOn {
        attribute: @attribute_02/app
        conditionType: isNotNull
    }
    help {
        helpText: The download link when the maximum attachment size is reached. Typically this is a public REST endpoint URL.
    }
)

customAttribute attribute_01 (
    apexlangName: reportType
    attribute: 1
    name: Report Type
    type: checkboxes
    validation {
        required: true
    }
    appearance {
        sequence: 110
    }
    default {
        value: pdf:xlsx:docx:html
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: =
        value: INIT
    }
    help {
        helpText:
            ```
            This attribute defines the possible report types which can be generated by the end-user. 
            If only a single value is selected by a developer, then the <strong>Report Type</strong> item will not visible in the plug-in dialog (the selected option will be used by default).
            ```
    }

    entry aopJson (
        sequence: 130
        display: AOP JSON
        return: aop_json
        help {
            helpText:
                ```
                <p>
                Retrieves the JSON that is being sent to the AOP Server. The JSON file is very useful for debugging. If you are sending a support request to the AOP Team, please include this JSON file in your message. 
                </p>
                <p>
                AOP JSON is automatically added to the <strong>Report Type</strong> dialog item when application debug mode is enabled (independent of the selection in page designer).
                </p>
                ```
        }
    )

    entry aopTemplate (
        sequence: 120
        display: AOP Template
        return: aop_template
        help {
            helpText: Generates an AOP template based on the given region source.
        }
    )

    entry csv (
        sequence: 50
        display: CSV
        return: csv
    )

    entry excel (
        sequence: 20
        display: Excel
        return: xlsx
    )

    entry html (
        sequence: 40
        display: HTML
        return: html
    )

    entry markdown (
        sequence: 100
        display: Markdown
        return: md
    )

    entry openDocumentPresentation (
        sequence: 90
        display: Open Document Presentation
        return: odp
    )

    entry openDocumentSpreadscheet (
        sequence: 80
        display: Open Document Spreadscheet
        return: ods
    )

    entry openDocumentText (
        sequence: 70
        display: Open Document Text
        return: odt
    )

    entry pdf (
        sequence: 10
        display: PDF
        return: pdf
    )

    entry powerpoint (
        sequence: 60
        display: Powerpoint
        return: pptx
    )

    entry word (
        sequence: 30
        display: Word
        return: docx
    )

)

customAttribute attribute_02 (
    apexlangName: maximumAttachmentSizeKb
    attribute: 2
    name: Maximum Attachment Size (KB)
    scope: app
    type: number
    appearance {
        sequence: 5
    }
    builder {
        unit: KB
    }
    help {
        helpText: Some email providers don’t allow attachments over a certain size. When the maximum attachment size is reached, instead of attaching the file, a download link is put in the email instead.
    }
)

customAttribute attribute_02 (
    apexlangName: templatesSqlQuery
    attribute: 2
    name: Templates (SQL Query)
    type: sqlQuery
    validation {
        required: true
    }
    appearance {
        sequence: 200
    }
    default {
        value:
            ```
            select
              to_char(id)     as template_id,
              title             as template_name,
              template_blob     as template_blob,
              mime_type         as mime_type,
              template_default  as template_default  
            from
              aop_downsubscr_template
            
            ```
    }
    dependingOn {
        attribute: @attribute_11/component
        conditionType: inList
        list: SQL_QUERY
    }
    help {
        helpText:
            ```
            This attribute defines what templates can be used by the end-user to generate a report. The SQL Query has to return a specific set of columns: 
            <ul>
              <li>template_id</li>
              <li>template_name</li>
              <li>template_blob</li>
              <li>mime_type </li>
              <li>template_default (0 or 1)</li>
            </ul>
            <p>
            When the end-user selects a report type, the plug-in fetches the available templates via an AJAX call. The templates that are returned are filtered based on the selected report type and template MIME type.
            </p>
            <dl>
              <dt>PDF</dt>
              <dd>
                <ul>
                  <li>application/vnd.openxmlformats-officedocument.wordprocessingml.document</li>
                  <li>application/vnd.openxmlformats-officedocument.spreadsheetml.sheet</li>
                  <li>text/html</li>
                  <li>text/markdown</li>
                </ul>
              </dd>
            </dl>
            <dl>
              <dt>Excel</dt>
              <dd>
                <ul>
                  <li>application/vnd.openxmlformats-officedocument.spreadsheetml.sheet</li>
                  <li>application/vnd.oasis.opendocument.spreadsheet</li>
                </ul>
              </dd>
            </dl>
            <dl>
              <dt>Word</dt>
              <dd>
                <ul>
                  <li>application/vnd.openxmlformats-officedocument.wordprocessingml.document</li>
                  <li>application/vnd.oasis.opendocument.text</li>
                </ul>
              </dd>
            </dl>
            
            <dl>
              <dt>HTML</dt>
              <dd>
                <ul>
                  <li>text/html</li>
                </ul>
              </dd>
            </dl>
            <dl>
              <dt>CSV</dt>
              <dd>
                <ul>
                  <li>text/csv</li>
                </ul>
              </dd>
            </dl>
            <dl>
              <dt>PowerPoint</dt>
              <dd>
                <ul>
                  <li>application/vnd.openxmlformats-officedocument.presentationml.presentation</li>
                </ul>
              </dd>
            </dl>
            <dl>
              <dt>Open Document Text (ODT)</dt>
              <dd>
                <ul>
                  <li>application/vnd.openxmlformats-officedocument.wordprocessingml.document</li>
                  <li>application/vnd.oasis.opendocument.text</li>
                </ul>
              </dd>
            </dl>
            <dl>
              <dt>Open Document Spreadsheet (ODS)</dt>
              <dd>
                <ul>
                  <li>application/vnd.openxmlformats-officedocument.spreadsheetml.sheet</li>
                  <li>application/vnd.oasis.opendocument.spreadsheet</li>
                </ul>
              </dd>
            </dl>
            <dl>
              <dt>Open Document Presentation (ODP)</dt>
              <dd>
                <ul>
                  <li>application/vnd.openxmlformats-officedocument.presentationml.presentation</li>
                </ul>
              </dd>
            </dl>
            <dl>
              <dt>Markdown</dt>
              <dd>
                <ul>
                  <li>text/markdown</li>
                </ul>
              </dd>
            </dl>
            <dl>
              <dt>AOP Template</dt>
              <dd>
                <ul>
                  <li>Not applicable.</li>
                </ul>
              </dd>
            </dl>
            <dl>
              <dt>AOP JSON</dt>
              <dd>
                <ul>
                  <li>All</li>
                </ul>
              </dd>
            </dl>
            ```
    }
    examples {
        examples:
            ```
            By default, the plug-in queries the AOP_DOWNSUBSCR_TEMPLATE table:
            <code><pre>select
              to_char(id)       as template_id,
              title             as template_name,
              template_blob     as template_blob,
              mime_type         as mime_type,        
              template_default  as template_default
            from
              AOP_DOWNSUBSCR_TEMPLATE</pre></code>
            ```
    }
)

customAttribute attribute_03 (
    apexlangName: saveLog
    attribute: 3
    name: Save Log
    scope: app
    type: yesNo
    appearance {
        sequence: 30
    }
    help {
        helpText: Setting <strong>Save Log</strong> to <strong>Yes</strong> enables you to track how the plug-in is used and what downloads have taken  place. Every request is stored in the table AOP_DOWNSUBSCR_LOG
    }
)

customAttribute attribute_03 (
    apexlangName: defaultTemplate
    attribute: 3
    name: Default Template
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 190
    }
    default {
        value: AOP
    }
    dependingOn {
        attribute: @attribute_11/component
        conditionType: isNotNull
    }

    entry aopReport (
        sequence: 10
        display: AOP Report
        return: AOP
        help {
            helpText: AOP Report is selected by default in the plug-in item <strong>Choose your template</strong>.
        }
    )

    entry apexReport (
        sequence: 20
        display: APEX Report
        return: APEX
        help {
            helpText: APEX Report is selected by default in the plug-in item <strong>Choose your template</strong>.
        }
    )

    entry apexReportDataOnly (
        sequence: 25
        display: APEX Report (Data Only)
        return: APEX_REPORT_DATA_ONLY
        help {
            helpText: APEX Report (Data Only) is selected by default in the plug-in item <strong>Choose your template</strong>.
        }
    )

    entry basedOnTheDefaultTemplateColumn (
        sequence: 30
        display: Based on the default template column
        return: COLUMN_DEFAULT
        help {
            helpText: A default template is selected from the templates returned by the query defined in <strong>Templates (SQL Query)</strong> and based on the  template_default column.
        }
    )

)

customAttribute attribute_04 (
    apexlangName: eMailFrom
    attribute: 4
    name: E-mail From
    scope: app
    validation {
        required: true
    }
    appearance {
        sequence: 0
    }
    help {
        helpText: The email address which from which emails are being sent, when the plug-in attribute <strong>Output To \ Email</strong> is selected.
    }
)

customAttribute attribute_04 (
    apexlangName: action
    attribute: 4
    name: Action
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 100
    }
    default {
        value: INIT
    }
    help {
        helpText:
            ```
            This attribute defines the plug-in action when the dynamic action is executed. 
            A dynamic action implementing the plug-in should always implement the <strong>Initialize</strong> action, which can be optionally followed with true actions implementing the plug-in action <strong>Add a new “Output To” tile</strong> or <strong>Add an Additional Region Source</strong>. 
            The <strong>Download File (Background)</strong> action is a standalone action and should be used to force the download of a generated file after a database job has finished.
            ```
    }

    entry addANewOutputToTile (
        sequence: 20
        display: Add a new "Output To" tile
        return: ADD_OUTPUT_TO
        help {
            helpText:
                ```
                Creates a custom tile in the <strong>Output To</strong> item. 
                A new <strong>Output To tile</strong> is created based on the <strong>Tile Text</strong> and <strong>Tile Icon</strong> attributes. 
                The <strong>Procedure Name</strong> attribute is used to handle the file generated by AOP.
                ```
        }
    )

    entry addAnAdditionalRegionSource (
        sequence: 30
        display: Add an Additional Region Source
        return: ADD_REGION_SOURCE
        help {
            helpText: Adds an additional region source that can be used within the AOP template.  Supported region types are Classic Report, Interactive Report and Interactive Grid.
        }
    )

    entry downloadFile (
        sequence: 40
        display: Download File
        return: DOWNLOAD_FILE_BACKGROUND
        help {
            helpText:
                ```
                Download the file that was generated by the job referenced in the <strong>this.data.jobName</strong> dynamic action event data. 
                A job must be finished before this action can be called.
                ```
        }
    )

    entry initialize (
        sequence: 10
        display: Initialize
        return: INIT
        help {
            helpText: Initializes the plug-in based on the <strong>Settings</strong>, <strong>Report Type</strong>, <strong>Template Selection</strong>, <strong>Output To</strong>, <strong>When</strong>, <strong>Default Template</strong>, <strong>Templates (SQL Query)</strong> and <strong>Initialize PL/SQL Code</strong> attributes.
        }
    )

)

customAttribute attribute_05 (
    apexlangName: tileText
    attribute: 5
    name: Tile Text
    validation {
        required: true
    }
    appearance {
        sequence: 500
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: =
        value: ADD_OUTPUT_TO
    }
    help {
        helpText: The given text is used to set the text of a new tile that will be visible to the end-user.
    }
)

customAttribute attribute_06 (
    apexlangName: tileIcon
    attribute: 6
    name: Tile Icon
    type: icon
    validation {
        required: true
    }
    appearance {
        sequence: 600
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: =
        value: ADD_OUTPUT_TO
    }
    help {
        helpText: The given icon is used to set an icon of a new tile that will be visible to the end-user.
    }
)

customAttribute attribute_07 (
    apexlangName: procedureName
    attribute: 7
    name: Procedure Name
    validation {
        required: true
    }
    appearance {
        sequence: 700
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: =
        value: ADD_OUTPUT_TO
    }
    help {
        helpText:
            ```
            The given procedure is executed when AOP finishes rendering a report and it is used to handle the generated report. 
            The procedure in the database needs to be structured with the parameters:
            <ul>
              <li>p_output_blob in BLOB - the generated report BLOB.</li>
              <li>p_output_filename in VARCHAR2 - the generated report filename.</li>
              <li>p_output_mime_type in VARCHAR2 - The generated report mime type.</li>
            </ul>
            The procedure can be named whatever you like, but the parameters need to match exactly as in the example. You can add other parameters with a default value.
            ```
    }
    examples {
        examples:
            ```
            <code><pre>create procedure send_email_prc(
              p_output_blob      in blob,
              p_output_filename  in varchar2,
              p_output_mime_type in varchar2
            ) is
              l_id number;
            begin
              l_id := apex_mail.send( 
                p_to => 'support@apexofficeprint.com', 
                p_from => 'support@apexofficeprint.com', 
                p_subj => 'Mail from APEX with attachment', 
                p_body => 'Please review the attachment.', 
                p_body_html => 'Please review the attachment.'
              );
            
              apex_mail.add_attachment( 
                p_mail_id    => l_id, 
                p_attachment => p_output_blob, 
                p_filename   => p_output_filename, 
                p_mime_type  => p_output_mime_type
              );
            
              commit;    
              
            end send_email_prc;</pre></code>
            ```
    }
)

customAttribute attribute_08 (
    apexlangName: outputTo
    attribute: 8
    name: Output To
    type: checkboxes
    validation {
        required: true
    }
    appearance {
        sequence: 140
    }
    default {
        value: BROWSER:TABLE:EMAIL
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: =
        value: INIT
    }
    help {
        helpText:
            ```
            <p>
            This attribute defines what happens with a generated report. A report can be downloaded to the browser (Browser), inserted into an output table (Table), sent as an attachment via e-mail (E-mail), or saved on the database filesystem (Filesystem  DB Directory) or AOP file system (Filesystem AOP Directory).
            </p>
            <p>
            If only one value is selected by a developer, then the Output To dialog item is not visible (the selected option is used by default).
            </p>
            <p>
            Handling of the end-user's selection in the Output to item varies depending on the selection in the When item.
            </p>
            ```
    }

    entry apexOfficeEditAoe (
        sequence: 55
        display: APEX Office Edit (AOE)
        return: APEX_OFFICE_EDIT
        help {
            helpText: APEX Office Edit (AOE) gives your users the possibility to view and edit the generated document straight in the AOE region. No need to download the document and open it locally anymore. AOE can show any type of document; Word, Excel, Powerpoint, OpenDocument, Text and PDF.
        }
    )

    entry browser (
        sequence: 10
        display: Browser
        return: BROWSER
        help {
            helpText:
                ```
                <dl>
                  <dt>Now</dt>
                  <dd>
                    The plug-in initializes the generation of a file and the end-user has to wait for the result. Once the file is generated, it is transferred to the  browser for the user to  download. 
                  </dd>
                  <dt>Background</dt>
                  <dd>
                    The plug-in initializes the generation of a file in the background using a job.
                  </dd>
                
                </dl>
                ```
        }
    )

    entry custom (
        sequence: 60
        display: Custom
        return: CUSTOM
        help {
            helpText:
                ```
                <p>
                  When selected, you should use the <strong>Add a new “Output to” tile</strong> action to specify the output type.</strong>. 
                </p>
                <p>
                  <i>This option is not mandatory and custom output locations can be added regardless if this option is checked.  The benefit to using this option when custom output locations are used is that the AOP Modal will be able to correctly identify when a singular option is provided to the end-user - when this happens the AOP Modal automatically hides the Output To selection in the modal displayed to the end-user and the singular select option is taken as default.</i>
                </p>
                ```
        }
    )

    entry eMail (
        sequence: 30
        display: E-mail
        return: EMAIL
        help {
            helpText:
                ```
                <p>
                  The e-mail address of the sender is set to the value given in the <strong>E-mail From</strong> component attribute.
                </p>
                <dl>
                  <dt>Now</dt>
                  <dd>
                    The plug-in initializes the generation of a file and the end-user has to wait for the result. Once the file is generated,it is sent as an attachment in an e-mail created based on the user’s selections.
                  </dd>
                </dl>  
                <dl>
                  <dt>Background</dt>
                  <dd>
                  The plug-in initializes the generation of a file in the background using a job. Once the file is generated, it is sent as an attachment in an e-mail created based on the user’s selections.
                  </dd>
                </dl>  
                <dl>
                  <dt>Scheduled</dt>
                  <dd>
                  The plug-in initializes the generation of a file using a database scheduler job based on the user’s selections. All files generated by this job are  sent as an attachment in an e-mail created based on the user’s selections.
                  </dd>
                </dl>
                ```
        }
    )

    entry filesystemAopDirectory (
        sequence: 50
        display: Filesystem (AOP Directory)
        return: FILE_AOP_DIR
        help {
            helpText:
                ```
                <dl>
                  <dt>Now</dt>
                  <dd>
                    The plug-in initializes the generation of a file and the end-user has to wait for the result. Once the file is generated, it is sent to the specified directory on the AOP Server in <strong>AOP directory > outputfiles</strong>.
                  </dd>
                </dl>  
                <dl>
                  <dt>Background</dt>
                  <dd>
                    The plug-in initializes the generation of a file in the background using a job.
                    Once the file is generated, it is sent to the specified directory on the AOP Server in <strong>AOP directory > outputfiles</strong>.
                  </dd>
                </dl>  
                <dl>
                  <dt>Scheduled</dt>
                  <dd>
                    The plug-in initializes the generation of a file using a database scheduler job based on the user’s selections.  All files generated by this job are sent to the specified directory on the AOP Server in <strong>AOP directory > outputfiles</strong>.
                  </dd>
                </dl>
                ```
        }
    )

    entry filesystemDbDirectory (
        sequence: 40
        display: Filesystem (DB Directory)
        return: FILE_DB_DIR
        help {
            helpText:
                ```
                <p>
                  Create the database directory with the following command: <code>CREATE DIRECTORY AOP_DOWNSUBSCR_DIR AS '/home/oracle/aop/';</code>
                </p>
                <dl>
                  <dt>Now</dt>
                  <dd>
                    The plug-in initializes the generation of a file and the end-user has to wait for the result. Once the file is generated,  it is save in the AOP_DOWNSUBSCR_DIR database directory.
                  </dd>
                </dl>  
                <dl>
                  <dt>Background</dt>
                  <dd>
                    The plug-in initializes the generation of a file in the background using a job. Once the file is generated, it is sent to the  AOP_DOWNSUBSCR_DIR database directory.
                  </dd>
                </dl>  
                <dl>
                  <dt>Scheduled</dt>
                  <dd>
                    The plug-in initializes the generation of a file using a database scheduler job based on the user’s selections. All files generated by this job are sent to the AOP_DOWNSUBSCR_DIR database directory.
                  </dd>
                </dl>
                ```
        }
    )

    entry table (
        sequence: 20
        display: Table
        return: TABLE
        help {
            helpText:
                ```
                <dl>
                  <dt>Now</dt>
                  <dd>
                    The plug-in initializes the generation of a file and the end-user has to wait for the result. Once the file is generated, it is inserted into the AOP_DOWNSUBSCR_OUTPUT table. 
                  </dd>
                </dl>  
                <dl>
                  <dt>Background</dt>
                  <dd>
                    The plug-in initializes the generation of a file in the background using a job. Once the file is generated, it is inserted into the AOP_DOWNSUBSCR_OUTPUT table. 
                  </dd>
                </dl>  
                <dl>
                  <dt>Scheduled</dt>
                  <dd>
                  The plug-in initializes the generation of a file using a database scheduler job based on the user’s selections. All files generated by this job are inserted into the AOP_DOWNSUBSCR_OUTPUT table.
                  </dd>
                </dl>
                ```
        }
    )

)

customAttribute attribute_09 (
    apexlangName: initializePlSqlCode
    attribute: 9
    name: Initialize PL/SQL Code
    type: plsqlCode
    appearance {
        sequence: 900
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: =
        value: INIT
    }
    help {
        helpText:
            ```
            <p>
            This attribute can be used to define variables used by the AOP to generate a file. A complete list of all variables can be found in the plug-in documentation <strong>The plug-in \ Custom Attributes \ Component \ Initialize PL/SQL Code</strong>.
            </p>
            <p>
            Learn more about possible variables from AOP documentation: <code>http://www.apexofficeprint.com/docs/plsql/aop_api20_pkg.html</code>
            </p>
            ```
    }
    examples {
        examples:
            ```
            <code><pre>aop_api_pkg.g_output_filename      := 'output';
            aop_api_pkg.g_output_filename      := v('P1_FILENAME');
            aop_api_pkg.g_rpt_header_font_size := '12';
            aop_api_pkg.g_rpt_header_font_size := '12';
            aop_api_pkg.g_prepend_files_sql    := q'[select filename, mime_type, template_blob as file_blob from aop_template where filename like 'PREPEND%' order by filename]';
            aop_api_pkg.g_append_files_sql     := q'[select filename, mime_type, template_blob as file_blob from aop_template where filename like 'APPEND%' order by filename]';</pre></code>
            ```
    }
)

customAttribute attribute_10 (
    apexlangName: when
    attribute: 10
    name: When
    type: checkboxes
    validation {
        required: true
    }
    appearance {
        sequence: 150
    }
    default {
        value: NOW:SCHEDULED:BACKGROUND
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: =
        value: INIT
    }
    help {
        helpText:
            ```
            <p>
            This attribute defines when file generation should happen. A report can be generated immediately (<strong>Now</strong>) or by using a database scheduler job - either at a specific point in time or at an interval (Scheduled) or in the background (<strong>Background</strong>).
            </p>
            <p?
            If only one value is selected by a developer, then the  When dialog item will not be visible to the end-user (the selected option will be used by default).
            </p>
            ```
    }

    entry background (
        sequence: 30
        display: Background
        return: BACKGROUND
        help {
            helpText:
                ```
                <p>
                  File generation starts immediately, but the end-user is not forced to wait for the document to 
                finish. 
                </p>
                <p>
                After the plug-in processes the request to create a new job, the <strong>AOP: Report Generating in the Background</strong> event is triggered.
                </p>
                ```
        }
    )

    entry now (
        sequence: 10
        display: Now
        return: NOW
        help {
            helpText: File generation starts immediately and the end-user waits for the result.  After the file is generated, the plug-in triggers the <strong>AOP: Report Generated (Now)</strong> event.
        }
    )

    entry scheduled (
        sequence: 20
        display: Scheduled
        return: SCHEDULED
        help {
            helpText:
                ```
                A file is generated at a specific time as defined by the end-user’s selection:
                <ul>
                  <li>Starts (Now/On specific date)</li>
                  <li>Start Date</li>
                  <li>Repeat Every</li>
                  <li>Frequency (Minute/Hour/Day/Week/Month/Year)</li>
                  <li>Days of the week (Mon/Tue/Wed/Thu/Fri/Sat/Sun)</li>
                </ul>  
                  After the plug-in processes the request to create a new scheduled report, the AOP: Report Generation Scheduled event is triggered.
                ```
        }
    )

)

customAttribute attribute_11 (
    apexlangName: templateSelection
    attribute: 11
    name: Template Selection
    type: checkboxes
    validation {
        required: true
    }
    appearance {
        sequence: 185
    }
    default {
        value: AOP_REPORT:APEX_REPORT:SQL_QUERY
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: =
        value: INIT
    }
    help {
        helpText: This attribute describes the possible template types that can be used  to generate reports. Template selection is dynamic, dependent on the selected report type. When the report type is changed, the list of available templates is fetched via an AJAX call. If only one template is returned then the <strong>Template Selection</strong> item  is not shown in the dialog (the returned template is used by default).
    }

    entry aopReport (
        sequence: 10
        display: AOP Report
        return: AOP_REPORT
        help {
            helpText:
                ```
                <p>
                The default template used by AOP. AOP generates the report based on the print attributes of the region and any global variables that have been set using <strong>Initialize PL/SQL Code</strong> attribute. 
                </p>
                <p>
                For example, to set the background color of the heading, specify <code>aop_api_pkg.g_rpt_header_back_color := '#FF0000';</code>
                </p>
                <p>
                To learn about other variables please read the plug-in documentation
                </p>
                ```
        }
    )

    entry apexReport (
        sequence: 20
        display: APEX Report
        return: APEX_REPORT
        help {
            helpText: The default template used by APEX. The report will be generated using the built-in functionality of APEX.Supported only starting with APEX 20.2.
        }
    )

    entry apexReportDataOnly (
        sequence: 40
        display: APEX Report (Data Only)
        return: APEX_REPORT_DATA_ONLY
        help {
            helpText: A generated report contains only data. All visual enhancements such as highlighting, grouping etc. is removed.
        }
    )

    entry templateFromAopTable (
        sequence: 50
        display: Template from AOP Table
        return: AOP_TABLE
        help {
            helpText: A developer must specify SQL Query returning templates to be picked by the end-user.
        }
    )

    entry templateFromSqlQuery (
        sequence: 60
        display: Template from SQL Query
        return: SQL_QUERY
        help {
            helpText: Templates are fetched from supporting application tables AOP_DOWNSUBSCR_TEMPLATE and AOP_DOWNSUBSCR_TEMPLATE_APP.  A developer can’t change the SQL Query but can add/modify existing templates using the supporting application.
        }
    )

)

customAttribute attribute_12 (
    apexlangName: settings
    attribute: 12
    name: Settings
    type: checkboxes
    appearance {
        sequence: 105
    }
    default {
        value: DISPLAY_MESSAGE:DISPLAY_SPINNER:AOP_JSON_DEBUG
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: =
        value: INIT
    }
    help {
        helpText: This attribute defines the plug-in functionalities.
    }

    entry addAopJsonInDebugMode (
        sequence: 5
        display: Add AOP JSON in debug mode
        return: AOP_JSON_DEBUG
        help {
            helpText: When checked, the plug-in renders report type <strong>AOP JSON</strong> when APEX debug mode is enabled irrespectively to selection in the plug-in attribute <strong>Report Type</strong>.
        }
    )

    entry displayMessage (
        sequence: 10
        display: Display Message
        return: DISPLAY_MESSAGE
        help {
            helpText: When checked, the plug-in displays the success message depending on the Output To and When values selected by the end-user. The messages can be customized using APEX text messages and the plug-in substitution string.
        }
    )

    entry displaySpinner (
        sequence: 20
        display: Display Spinner
        return: DISPLAY_SPINNER
        help {
            helpText: When checked,  the APEX spinner is displayed while AOP is generating the document.
        }
    )

    entry enableSaveLog (
        sequence: 25
        display: Enable Save Log
        return: ENABLE_SAVE_LOG
        help {
            helpText:
                ```
                When checked, the plug-in enables AOP logging for this instance ignoring the value set on the application level (Component Settings). 
                Otherwise, the value set on application level value is used.
                ```
        }
    )

    entry hideNativeApexPrint (
        sequence: 30
        display: Hide Native APEX Print
        return: HIDE_NATIVE_PRINT
        help {
            helpText:
                ```
                <p>
                  When checked, the plug-in removes native print functionalities from Classic Report, Interactive Report and Interactive Grid.
                </p>
                
                <ul>
                  <li>
                    Classic Report - native anchor <code>Print</code> is removed from the footer of a report.
                  </li>
                  <li>
                    Interactive Report - actions menu entries <code>Download</code> and <code>Subscription</code> are hidden.
                  </li>
                  <li>
                    Interactive Grid - actions menu entry <code>Download</code> is hidden.
                  </li>
                </ul>
                ```
        }
    )

)

customAttribute attribute_13 (
    apexlangName: pageItemSToSubmit
    attribute: 13
    name: Page Item(s) to Submit
    type: pageItems
    appearance {
        sequence: 930
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: =
        value: INIT
    }
    help {
        helpText:
            ```
            This attribute describes a list of page items to be sent along with the AJAX call to generate a report.
            By default, the plug-in fetches the page item(s) to be sent from the region attribute <strong>Source \ Page Items to Submit</strong>.
            ```
    }
)

customAttribute attribute_14 (
    apexlangName: settings2
    attribute: 14
    name: Settings
    type: checkboxes
    appearance {
        sequence: 140
    }
    dependingOn {
        attribute: @attribute_04/component
        conditionType: =
        value: ADD_OUTPUT_TO
    }

    entry showEMailForm (
        sequence: 20
        display: Show E-mail Form
        return: SHOW_EMAIL_FORM
    )

)
