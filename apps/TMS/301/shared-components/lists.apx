            plsqlExpression: AUTH_PKG.CAN_READ_SQL('ReadAbsence') = 1 or AUTH_PKG.CAN_READ_SQL('ReadTimesheet') = 1 or AUTH_PKG.CAN_READ_SQL('ReadTransactions') = 1
