            target: {
                page: 10
            }
        }
    )

    entry employees (
        label: Employees
        icon {
            imageIconCssClasses: fa-users
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.CAN_READ_SQL('ReadEmployees') = 1 or AUTH_PKG.CAN_READ_SQL('ReadVacations') = 1 or AUTH_PKG.CAN_READ_SQL('ReadMissions') = 1 or AUTH_PKG.CAN_READ_SQL('ReadTrainings') = 1 or AUTH_PKG.CAN_READ_SQL('ReadPermissions') = 1 or AUTH_PKG.CAN_READ_SQL('ReadOvertime') = 1
        }
    )

    entry employees-list (
