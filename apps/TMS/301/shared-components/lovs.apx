lov lov-emp-number (
    name: LOV-EMP-NUMBER
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select EMPLOYEE_NUMBER || ' - ' || NAME as display_value, EMPLOYEE_NUMBER as return_value
