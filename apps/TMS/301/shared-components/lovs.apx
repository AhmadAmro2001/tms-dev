lov lov-years (
    name: LOV-YEARS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            SELECT EXTRACT(YEAR FROM SYSDATE) - LEVEL + 1 AS display_value,
                   EXTRACT(YEAR FROM SYSDATE) - LEVEL + 1 AS return_value
            FROM dual
            CONNECT BY LEVEL <= 100
            ORDER BY 1 DESC;
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }
)

