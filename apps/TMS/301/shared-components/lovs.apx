lov boolean (
    name: BOOLEAN
    source {
        location: staticValues
    }

    entry false (
        sequence: 2
        display: No
        return: FALSE
    )

    entry true (
        sequence: 1
        display: Yes
        return: TRUE
    )

)

lov copy-of-devices-types2 (
    name: TRANSACTION-TYPE
    source {
        location: staticValues
    }

    entry in (
        sequence: 2
        display: Out
        return: 1
    )

    entry in-out (
        sequence: 1
        display: In
        return: 0
    )

)

lov department (
    name: LOV-DEPARTMENT
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select NAME as display_value, ID as return_value
              from DEPARTMENT
             order by NAME
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }
)

lov device (
    name: LOV-DEVICE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select NAME as display_value, to_char(ID) as return_value
              from DEVICE
             order by NAME
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }
)

lov devices-types2 (
    name: DEVICES_TYPES2
    source {
        location: staticValues
    }

    entry in (
        sequence: 2
        display: In
        return: 1
    )

    entry in-out (
        sequence: 1
        display: In/Out
        return: 0
    )

    entry out (
        sequence: 3
        display: Out
        return: 2
    )

)

lov employee (
    name: LOV-EMPLOYEE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select EMPLOYEE_NUMBER || ' - ' || NAME as display_value, to_char(ID) as return_value
              from EMPLOYEE
             where IS_ACTIVE = '1'
             order by NAME
            ```
    }
    columnMapping {
        return: RETURN_VALUE
        display: DISPLAY_VALUE
    }
)

