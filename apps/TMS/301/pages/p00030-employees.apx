page 30 (
    name: Employees
    alias: EMPLOYEES
    title: Employees
    pageGroup: @employees
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    css {
        fileUrls: #APP_FILES#style#MIN#.css
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Employees
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region employees (
        name: Employees_data
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.ID, e.EMPLOYEE_NUMBER, e.NAME, p.NAME AS PROJECT_NAME, l.NAME AS LOCATION_NAME,rh.ROTATION_ID, d.NAME AS DEPARTMENT_NAME, g.NAME AS GRADE_NAME, e.IS_ACTIVE, e.NATIONALITY, e.RELIGION, apex_page.get_url(p_page => 1145, p_items => 'P1145_ENTITY_ID', p_values => to_char(e.ID)) AS EDIT_URL,
                apex_page.get_url(p_page => 1148, p_items => 'P1148_ENTITY_ID', p_values => to_char(e.ID)) AS VIEW_URL
                   from EMPLOYEE e left join PROJECT p on p.ID=e.PROJECT_ID 
                   left join LOCATION l on l.ID=e.LOCATION_ID 
                   left join DEPARTMENT d on d.ID=e.DEPARTMENT_ID 
                   left join GRADE g on g.ID=e.GRADE_ID
                   LEFT JOIN (
                    SELECT rh.*,
                           ROW_NUMBER() OVER (
                               PARTITION BY rh.EMPLOYEE_ID
                               ORDER BY rh.STARTED DESC
                           ) AS RN
                    FROM ROTATION_HISTORY rh
                ) rh
                    ON rh.EMPLOYEE_ID = e.EMPLOYEE_NUMBER
                   AND rh.RN = 1
                   left join ROTATION_PLAN rp on rp.id = rh.ROTATION_ID
                  where e.LOCATION_ID in (select to_number(column_value) from table(apex_string.split(:APP_USER_LOCATION_IDS, ':'))) 
                  AND (
                    :P30_DEPARTMENTS IS NULL
                    OR e.DEPARTMENT_ID = :P30_DEPARTMENTS
                )
                 AND (
                    :P30_LOCATIONS IS NULL
                    OR e.LOCATION_ID = :P30_LOCATIONS
                )
                 AND (
                    :P30_PROJECTS IS NULL
                    OR e.PROJECT_ID = :P30_PROJECTS
                )
                AND (
                    :P30_NATONALITIES IS NULL
                    OR e.NATIONALITY = :P30_NATONALITIES
                )
                AND (
                    :P30_RELIGIONS IS NULL
                    OR e.RELIGION = :P30_RELIGIONS
                )
                AND (
                    :P30_ACTIVE IS NULL
                    OR e.IS_ACTIVE = :P30_ACTIVE
                )
                AND (
                    :P30_ROTATION IS NULL
                    OR rp.id = :P30_ROTATION
                )
                  order by e.EMPLOYEE_NUMBER
                ```
            pageItemsToSubmit: [
                P30_DEPARTMENTS
                P30_LOCATIONS
                P30_PROJECTS
                P30_NATONALITIES
                P30_RELIGIONS
                P30_ACTIVE
            ]
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.CAN_READ_SQL('ReadEmployees') = 1
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No matching rows are available in your permitted scope.
            whenMoreDataFound: Apply filters to reduce the result set before exporting.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 47964075360343141
        }

        column DEPARTMENT_NAME (
            type: plainText
            heading {
                heading: Department
            }
            layout {
                sequence: 43
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

