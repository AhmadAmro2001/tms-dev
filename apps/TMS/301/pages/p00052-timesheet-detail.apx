    pageItem P52_EMPLOYEE_ID (
        type: popupLov
        label {
            label: Employee
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @employee
        }
        layout {
            sequence: 10
            region: @detail-controls
            slot: regionBody
            alignment: left
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
    )

    pageItem P52_EXPECTED_VERSION (
        type: hidden
        layout {
            sequence: 1
            region: @detail-controls
            slot: regionBody
        }
        sessionState {
            storage: request
        }
    )

    pageItem P52_IDEMPOTENCY_KEY (
        type: hidden
        layout {
            sequence: 2
            region: @detail-controls
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P52_MONTH (
        type: datePicker
        label {
            label: Month
            alignment: left
        }
        layout {
            sequence: 20
            region: @detail-controls
            slot: regionBody
            alignment: left
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
    )

    pageItem P52_SHIFT_ID (
        type: selectList
        label {
            label: Alternate Shift
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @shift
            nullDisplayValue: - Select Shift -
        }
        layout {
            sequence: 40
            region: @detail-controls
            slot: regionBody
            alignment: left
        }
        sessionState {
            storage: request
        }
    )

    pageItem P52_WORK_DATE (
        type: datePicker
        label {
            label: Override Work Date
            alignment: left
        }
        layout {
            sequence: 30
            region: @detail-controls
            slot: regionBody
            alignment: left
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Save only changes the employee/date alternate-shift override; it never recalculates punches.
        }
    )

    button apply-timesheet-detail (
        buttonName: APPLY_TIMESHEET_DETAIL
        label: Apply
        layout {
            sequence: 50
            region: @detail-controls
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button record-print (
        buttonName: RECORD_PRINT
        label: Record Print
        layout {
            sequence: 70
            region: @detail-controls
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.can_print_timesheet(:P52_EMPLOYEE_ID, trunc(to_date(:P52_MONTH, 'YYYY-MM-DD'), 'MM'))
        }
    )

    button save-alternate-shift (
        buttonName: SAVE_ALTERNATE_SHIFT
        label: Save Alternate Shift
        layout {
            sequence: 60
            region: @detail-controls
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.HAS_ROLE('1') or AUTH_PKG.HAS_ROLE('2')
        }
    )

    process initialize-timesheet-detail (
        name: Initialize Timesheet Detail
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    :P52_MONTH := to_char(nvl(to_date(:P52_MONTH, 'YYYY-MM-DD'), trunc(sysdate, 'MM')), 'YYYY-MM-DD');
                    :P52_IDEMPOTENCY_KEY := nvl(:P52_IDEMPOTENCY_KEY, rawtohex(sys_guid()));
                    IF :REQUEST IS NULL OR :REQUEST = 'APPLY_TIMESHEET_DETAIL' THEN
                        :P52_SHIFT_ID := NULL;
                        :P52_EXPECTED_VERSION := NULL;
                        IF NOT AUTH_PKG.can_read('ReadTimesheet') THEN
                            raise_application_error(-20192, 'Timesheet read access is not permitted');
                        END IF;
                        IF :P52_EMPLOYEE_ID IS NOT NULL AND :P52_WORK_DATE IS NOT NULL THEN
                            BEGIN
                                SELECT SHIFT_ID, ORA_ROWSCN INTO :P52_SHIFT_ID, :P52_EXPECTED_VERSION
                                  FROM ALTERNATE_SHIFT a
                                  JOIN EMPLOYEE e ON e.ID = a.EMPLOYEE_ID
                                 WHERE a.EMPLOYEE_ID = :P52_EMPLOYEE_ID
                                   AND trunc(a."DATE") = trunc(to_date(:P52_WORK_DATE, 'YYYY-MM-DD'))
                                   AND AUTH_PKG.can_access_location_sql(e.LOCATION_ID) = 1;
                            EXCEPTION WHEN no_data_found THEN NULL; END;
                        END IF;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 47988933762343267
        }
    )

    process record-timesheet-print (
        name: Record Print Decision Through Package
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE l_status varchar2(30); l_message varchar2(4000);
                BEGIN
                    TIMESHEET_API_PKG.record_print_decision(:P52_EMPLOYEE_ID, :P52_MONTH,
                        'PRINTED', :P52_IDEMPOTENCY_KEY, l_status, l_message);
                    IF l_status = 'REJECTED' THEN raise_application_error(-20001, l_message); END IF;
                END;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 47989159721343268
        }
        serverSideCondition {
            whenButtonPressed: @record-print
        }
    )

    process save-timesheet-alternate-shift (
        name: Save Alternate Shift Through Package
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE l_id number; l_status varchar2(30); l_message varchar2(4000);
                BEGIN
                    TIMESHEET_API_PKG.upsert_alternate_shift(:P52_EMPLOYEE_ID, :P52_WORK_DATE,
                        :P52_SHIFT_ID, :P52_EXPECTED_VERSION, :P52_IDEMPOTENCY_KEY,
                        l_id, l_status, l_message);
                    IF l_status in ('REJECTED','CONFLICT') THEN raise_application_error(-20001, l_message); END IF;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 47989093542343267
        }
        serverSideCondition {
            whenButtonPressed: @save-alternate-shift
        }
    )

)
