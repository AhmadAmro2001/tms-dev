page 52 (
    name: Time Sheet Detail
    alias: TIMESHEET-DETAIL
    title: Time Sheet Detail
    pageGroup: @reports
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Time Sheet Detail
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region detail-controls (
        name: Time Sheet Controls
        type: staticContent
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region timesheet-detail-report (
        name: Calculated Daily Rows
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select EMPLOYEE_ID, EMPLOYEE_NUMBER, EMPLOYEE_NAME, WORK_DATE,
                       SHIFT_NAME, SHIFT_IS_OFF, ACTUAL_IN AS FIRST_IN, ACTUAL_OUT AS LAST_OUT,
                       STANDARD_HOURS, EARLY_HOURS + LATE_HOURS AS OVERTIME_HOURS,
                       BEFORE_07_HOURS, AFTER_19_HOURS, REST_HOURS, CALCULATED_HOURS,
                       IS_HOLIDAY, IS_VACATION, IS_COMPANY_PERMISSION, IS_ABSENT,
                       CALCULATION_STATUS, REMARKS, ALTERNATE_SHIFT_ID
                  from GET_EMPLOYEE_TIMESHEET(
                         p_location_id => null,
                         p_employee_id => :P52_EMPLOYEE_ID,
                         p_month => to_date(:P52_MONTH, 'YYYY-MM-DD'),
                         p_work_date => null
                       )
                 where AUTH_PKG.can_access_location_sql(LOCATION_ID) = 1
                 order by WORK_DATE
                ```
            pageItemsToSubmit: [
                "[P52_EMPLOYEE_ID"
                "P52_MONTH]"
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.CAN_READ_SQL('ReadTimesheet') = 1
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No calculated rows are available for this employee and permitted month.
            whenMoreDataFound: Apply filters to reduce the result set before exporting.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 47985726693343266
        }

        column AFTER_19_HOURS (
            type: plainText
            heading {
                heading: After 19:00
            }
            layout {
                sequence: 12
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column ALTERNATE_SHIFT_ID (
            type: plainText
            heading {
                heading: Alternate Shift
            }
            layout {
                sequence: 21
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: U
            }
        )

