        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn AFTER_19_HOURS (
                sequence: 12
            )

            displayColumn ALTERNATE_SHIFT_ID (
                sequence: 21
            )

            displayColumn BEFORE_07_HOURS (
                sequence: 11
            )

            displayColumn CALCULATED_HOURS (
                sequence: 14
            )

            displayColumn CALCULATION_STATUS (
                sequence: 19
            )

            displayColumn EMPLOYEE_ID (
                sequence: 1
            )

            displayColumn EMPLOYEE_NAME (
                sequence: 3
            )

            displayColumn EMPLOYEE_NUMBER (
                sequence: 2
