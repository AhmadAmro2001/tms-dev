    region filter-region (
        name: filter region
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--stacked
                t-Region--scrollBody
            ]
        }
    )

    region permissions (
        name: Permissions
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    p.ID,
                    e.EMPLOYEE_NUMBER,
                    e.NAME AS EMPLOYEE_NAME,
                    p."DATE" AS WORK_DATE,
                    TO_CHAR(FROM_TIME, 'HH AM') AS FROM_TIME,
                    TO_CHAR(TO_TIME, 'HH AM') AS TO_TIME,
                    l.NAME AS LOCATION_NAME,
                    pt.NAME AS TYPE_NAME,
                    p.DESCRIPTION,
                
                    apex_page.get_url(
                        p_page   => 1143,
                        p_items  => 'P1143_ENTITY_ID',
                        p_values => TO_CHAR(p.ID)
                    ) AS EDIT_URL,
                
                    apex_page.get_url(
                        p_page   => 143,
                        p_items  => 'P143_ENTITY_ID',
                        p_values => TO_CHAR(p.ID)
                    ) AS VIEW_URL,
                    CASE 
                        WHEN p.IS_INSERTED_BY_APEX = '1' THEN 'APEX'
                        WHEN p.IS_INSERTED_BY_APEX = '0' THEN 'TMS'
                    END as SOURCE ,
                
                    'DELETE' AS DELETE_BUTTON
                
                FROM PERMISSION p
                
                JOIN EMPLOYEE e
                    ON e.ID = p.EMPLOYEE_ID
                
                LEFT JOIN PERMISSION_TYPE pt
                    ON pt.ID = p.TYPE_ID
                
                LEFT JOIN LOCATION l
                    ON l.ID = e.LOCATION_ID
                
                WHERE :P34_SUBMIT_FLAG = 'Y' 
                AND
                (
                    :P34_EMPLOYEE_CODE IS NULL
                    OR e.EMPLOYEE_NUMBER = :P34_EMPLOYEE_CODE
                )
                
                AND (
                    :P34_LOCATION IS NULL
                    OR e.LOCATION_ID = :P34_LOCATION
                )
                
                AND (
                    :P34_FROM IS NULL
                    OR p."DATE" >= TRUNC(TO_DATE(:P34_FROM, 'MM/DD/YYYY'))
                )
                
                AND (
                    :P34_TO IS NULL
                    OR p."DATE" < TRUNC(TO_DATE(:P34_TO, 'MM/DD/YYYY')) + 1
                )
                
                ORDER BY p."DATE" DESC
                ```
            pageItemsToSubmit: [
                P34_EMPLOYEE_CODE
                P34_LOCATION
                P34_FROM
                P34_TO
                P34_SUBMIT_FLAG
            ]
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: permission_report
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.CAN_READ_SQL('ReadPermissions') = 1
        }
        pagination {
