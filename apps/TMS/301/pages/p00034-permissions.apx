    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(document).on('click', '.delete-btn', function () {
                    
                        var id = $(this).data("id");
                        apex.message.confirm("Are you sure you want to proceed?", function (okPressed) {
                            if (okPressed) {
                    
                                apex.server.process(
                                    "DELETE_PERMISSION",
                                    {
                                        x01: id
                                    },
                                    {
                                        success: function () {
                    
                                            // console.log('ya hamada');
                                            apex.region("permission_report").refresh();
                                        },
                                        error: function (pError) {
                                            console.error(pError);
                                        }
                                    }
                                );
                            }
                        });
                    
                    
                    
                    
                    });
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refresh-permissions-after-dialog (
        name: Refresh after dialog close
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @permissions
        }

        action refresh-report (
            action: refresh
            affectedElements {
                selectionType: region
                region: @permissions
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction set-value (
        name: set value
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @submit
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @permissions
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: Y
            }
            affectedElements {
                selectionType: items
                items: P34_SUBMIT_FLAG
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction set-value_1 (
        name: set value
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @reset
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @permissions
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: N
            }
            affectedElements {
                selectionType: items
                items: P34_SUBMIT_FLAG
            }
            execution {
                sequence: 10
            }
        )

        action native-set-value_1 (
            action: setValue
            affectedElements {
                selectionType: items
                items: [
                    P34_EMPLOYEE_CODE
                    P34_LOCATION
                    P34_FROM
                    P34_TO
                ]
            }
            execution {
                sequence: 30
            }
        )

    )

    process delete-permission (
        name: DELETE_PERMISSION
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_status   VARCHAR2(30);
                    l_message  VARCHAR2(4000);
                    l_type varchar2 := 'PERMISSION';
                BEGIN
                    DELETE_PKG.delete_permission(
                        p_id => apex_application.g_x01
                    );
                
                    AUDIT_PKG.record_event('REFERENCE_PERMISSION_DELETE', l_type,  apex_application.g_x01, null);
                
                    IF l_status = 'REJECTED' THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            l_message
                        );
                    END IF;
                
                apex_json.open_object;
                apex_json.write('msg', 'ok') ;
                apex_json.close_object;
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 48786830611747831
        }
    )

)
