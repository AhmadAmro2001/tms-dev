page 1139 (
    name: Holiday Form
    alias: HOLIDAY-FORM
    title: Holiday Form
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    css {
        fileUrls: #APP_FILES#style#MIN#.css
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region form-body (
        name: Holiday Form
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1139_ENTITY_ID (
        type: hidden
        layout {
            sequence: 1
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1139_EXPECTED_VERSION (
        type: hidden
        layout {
            sequence: 2
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
    )

    pageItem P1139_FROM_DATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 11
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the holiday start date.
        }
    )

    pageItem P1139_IDEMPOTENCY_KEY (
        type: hidden
        layout {
            sequence: 1
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1139_NAME (
        type: textField
        label {
            label: Name
            alignment: left
        }
        layout {
            sequence: 10
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the holiday name.
        }
    )

    pageItem P1139_TARGET_NATIONALITY (
        type: textField
        label {
            label: Target Nationality
            alignment: left
        }
        layout {
            sequence: 13
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the target nationality this holiday applies to.
        }
    )

    pageItem P1139_TARGET_RELIGION (
        type: textField
        label {
            label: Target Religion
            alignment: left
        }
        layout {
            sequence: 14
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the target religion this holiday applies to.
        }
    )

    pageItem P1139_TO_DATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 12
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the holiday end date.
        }
    )

    pageItem P1139_WORK_TYPE (
        type: textField
        label {
            label: Work Type
            alignment: left
        }
        layout {
            sequence: 15
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the work type this holiday applies to.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }
        config {
            buildOption: @commented-out
        }

        triggerAction cancel-dialog (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button delete (
        buttonName: DELETE
        label: Delete or Archive
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Confirm the package-backed delete/archive operation.
            style: danger
        }
        config {
            buildOption: @commented-out
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: ig-action-btn
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Holiday operation completed
        }
        advanced {
            executionMappingIdentifier: 48384596993276807
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,DELETE
        }
    )

    process delete-holiday (
        name: Delete Holiday Through Package
        type: executeCode
        source {
            plsqlCode: DECLARE l_status varchar2(30); l_message varchar2(4000); BEGIN SCHEDULE_API_PKG.delete_schedule('HOLIDAY', :P1139_ENTITY_ID, l_status, l_message); IF l_status = 'REJECTED' THEN raise_application_error(-20001, l_message); END IF; END;
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 48384442234276807
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-holiday-form (
        name: Initialize Holiday Form
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    :P1139_IDEMPOTENCY_KEY := nvl(:P1139_IDEMPOTENCY_KEY, rawtohex(sys_guid()));
                    IF :P1139_ENTITY_ID IS NOT NULL THEN
                        SELECT NAME, FROM_DATE, TO_DATE, TARGET_NATIONALITY, TARGET_RELIGION, WORK_TYPE, ORA_ROWSCN
                          INTO :P1139_NAME, :P1139_FROM_DATE, :P1139_TO_DATE, :P1139_TARGET_NATIONALITY, :P1139_TARGET_RELIGION, :P1139_WORK_TYPE, :P1139_EXPECTED_VERSION
                          FROM OFFICIAL_HOLIDAY WHERE ID = :P1139_ENTITY_ID;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 48384202206276807
        }
    )

    process save-holiday (
        name: Save Holiday Through Package
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE l_id number; l_status varchar2(30); l_message varchar2(4000); BEGIN
                    SCHEDULE_API_PKG.upsert_schedule('HOLIDAY', :P1139_ENTITY_ID, null, null, :P1139_NAME, to_date(:P1139_FROM_DATE, 'YYYY-MM-DD'), to_date(:P1139_TO_DATE, 'YYYY-MM-DD'), :P1139_WORK_TYPE, null, :P1139_TARGET_NATIONALITY, :P1139_TARGET_RELIGION, :P1139_EXPECTED_VERSION, :P1139_IDEMPOTENCY_KEY, l_id, l_status, l_message);
                    IF l_status in ('REJECTED','CONFLICT') THEN raise_application_error(-20001, l_message); END IF;
                    :P1139_ENTITY_ID := l_id;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 48384378036276807
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)
