    css {
        inline:
            ```css
            .day-status {
                display: inline-block;
                padding: 4px 10px;
                border-radius: 12px;
                font-weight: 600;
                font-size: 12px;
            }
            
            .day-status-WORK {
                background-color: #d4edda;
                color: #155724;
            }
            
            .day-status-VACATION {
                background-color: #cce5ff;
                color: #004085;
            }
            
            .day-status-OFFICIAL-HOLIDAY {
                background-color: #fff3cd;
                color: #856404;
            }
            
            .day-status-OFF {
                background-color: #e2e3e5;
                color: #383d41;
            }
            
            .day-status-NO-TRANSACTION {
                background-color: #f8d7da;
                color: #721c24;
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

