    process new_1 (
        name: insert_in_temp_table
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_count      NUMBER;
                    l_start_date DATE;
                    l_rows       TIME_SHEET_ROW_TABLE;
                BEGIN
                
                    /* Check if data already exists */
                    SELECT COUNT(*)
                INTO l_count
                FROM TIME_SHEET_CACHE C
                WHERE C.MONTH = :P5_MONTHS
                  AND C.YEAR  = :P5_YEARS
                  AND C.EMP_NO IN (
                      SELECT E.EMPLOYEE_NUMBER
                      FROM EMPLOYEE E
                      WHERE
                      (
                                :P5_EMP_IDS IS NULL
                                AND :P5_DEPTARTMENT IS NULL
                                AND :P5_LOCATION IS NULL
                                AND :P5_PROJECT IS NULL
                            )
                            OR
                            (
                                
                                :P5_EMP_IDS IS NOT NULL
                                AND E.ID IN (
                                    SELECT TO_NUMBER(COLUMN_VALUE)
                                    FROM TABLE(APEX_STRING.SPLIT(:P5_EMP_IDS, ':'))
                                )
                            )
                         OR (
                                :P5_DEPTARTMENT IS NOT NULL
                                AND E.DEPARTMENT_ID = :P5_DEPTARTMENT
                            )
                         OR (
                                :P5_LOCATION IS NOT NULL
                                AND E.LOCATION_ID = :P5_LOCATION
                            )
                         OR (
                                :P5_PROJECT IS NOT NULL
                                AND E.PROJECT_ID = :P5_PROJECT
                            )
                  );
                
                    l_start_date := TO_DATE(
                        :P5_YEARS || '-' || :P5_MONTHS || '-01',
                        'YYYY-MM-DD'
                    );
                
                    IF SYSDATE > l_start_date + 140 THEN 
                        NULL;
                    ELSE
                
                        IF l_count > 0 THEN 
                            DELETE FROM TIME_SHEET_CACHE 
                            WHERE MONTH = :P5_MONTHS
                              AND YEAR = :P5_YEARS
                              AND EMP_NO IN (
                                  SELECT E.EMPLOYEE_NUMBER FROM EMPLOYEE E
                                  WHERE
                                  (
                                :P5_EMP_IDS IS NULL
                                AND :P5_DEPTARTMENT IS NULL
                                AND :P5_LOCATION IS NULL
                                AND :P5_PROJECT IS NULL
                            )
                            OR
                                (
                                    :P5_EMP_IDS IS NOT NULL
                                    AND E.ID IN (
                                        SELECT TO_NUMBER(COLUMN_VALUE)
                                        FROM TABLE(APEX_STRING.SPLIT(:P5_EMP_IDS, ':'))
                                    )
                                )
                             OR (
                                    :P5_DEPTARTMENT IS NOT NULL
                                    AND E.DEPARTMENT_ID = :P5_DEPTARTMENT
                                )
                             OR (
                                    :P5_LOCATION IS NOT NULL
                                    AND E.LOCATION_ID = :P5_LOCATION
                                )
                             OR (
                                    :P5_PROJECT IS NOT NULL
                                    AND E.PROJECT_ID = :P5_PROJECT
                                )
                      );
                        END IF;
                
                        /* Use the package's typed APEX result to keep the cursor shape aligned. */
                        l_rows := TIME_SHEET_REPORT_PKG.GET_TIME_SHEET_REPORT_APEX(
                            P_EMPLOYEE_IDS => :P5_EMP_IDS,
                            P_YEAR         => :P5_YEARS,
                            P_MONTH        => :P5_MONTHS,
                            P_DEPARTMENT  => :P5_DEPTARTMENT,
                            P_LOCATION      => :P5_LOCATION,
                            P_PROJECT      => :P5_PROJECT
                        );
                
                        IF l_rows.COUNT > 0 THEN
                            FORALL i IN 1..l_rows.COUNT
                                INSERT INTO TIME_SHEET_CACHE (
                                    EMP_NO,
                                    EMP_NAME,
                                    DEPARTMENT,
                                    LOCATION,
                                    PROJECT,
                                    MONTH,
                                    YEAR,
                                    TRANSACTION_DAY_DATE,
                                    TIME_IN,
                                    TIME_OUT,
                                    WORKED_HOURS,
                                    OVERTIME_BEFORE_SIX,
                                    OVERTIME_AFTER_SIX,
                                    R_P,
                                    NATIONALITY,
                                    RELIGION,
                                    DAY_STATUS,
                                    PERMISSION_STATUS,
                                    PERMISSION_DESCRIPTION,
                                    PERMISSION_TYPE_ID,
                                    ROTATION_TYPE,
                                    ROTATION_DAY,
                                    OVERTIME_FROM,
                                    SHIFT_FROM_TIME,
                                    SHIFT_DURATION
                                )
                                VALUES (
                                    l_rows(i).employee_number,
                                    l_rows(i).name,
                                    NVL(l_rows(i).department_name,'N/A'),
                                    NVL(l_rows(i).location_name,'N/A'),
                                    NVL(l_rows(i).project_name, 'N/A'),
                                    :P5_MONTHS,
                                    :P5_YEARS,
                                    l_rows(i).transaction_date,
                                    l_rows(i).in_time,
                                    l_rows(i).out_time,
                                    l_rows(i).worked_hours,
                                    l_rows(i).over_time,
                                    l_rows(i).over_time_after_6,
                                    l_rows(i).rp,
                                    l_rows(i).nationality,
                                    l_rows(i).religion,
                                    l_rows(i).day_status,
                                    l_rows(i).permission_status,
                                    l_rows(i).PERMISSION_DESCRIPTION,
                                    l_rows(i).PERMISSION_TYPE_ID,
                                    NVL(TO_CHAR(l_rows(i).rotation_days),'N/A'),
                                    NVL(TO_CHAR(l_rows(i).rotation_day), 'N/A'),
                                    l_rows(i).OVERTIME_FROM,
                                    l_rows(i).SHIFT_FROM_TIME,
                                    l_rows(i).SHIFT_DURATION
                                );
                        END IF;
                
                        COMMIT;
                    END IF;
                
                END;
                
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 70482774205012623
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

)
