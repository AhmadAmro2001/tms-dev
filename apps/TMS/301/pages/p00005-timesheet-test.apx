    process get-employees-count (
        name: get employees count
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_count NUMBER;
                BEGIN
                    SELECT COUNT(DISTINCT t.EMP_NO)
                    INTO l_count
                    FROM TIME_SHEET_CACHE t
                    LEFT JOIN EMPLOYEE EMP ON EMP.EMPLOYEE_NUMBER = T.EMP_NO
                    LEFT JOIN DEPARTMENT D
                        ON UPPER(D.NAME) = UPPER(T.DEPARTMENT)
                    LEFT JOIN LOCATION LO
                        ON UPPER(LO.NAME) = UPPER(T.LOCATION)
                    LEFT JOIN PROJECT PR
                        ON UPPER(PR.NAME) = UPPER(T.PROJECT)
                    WHERE t.MONTH = :P5_MONTHS
                      AND t.YEAR = :P5_YEARS
                      AND (
                            (
                                :P5_EMP_IDS IS NULL
                                OR t.EMP_NO IN (
                                    SELECT E.EMPLOYEE_NUMBER
                                    FROM EMPLOYEE E
                                    WHERE E.ID IN (
                                        SELECT TO_NUMBER(COLUMN_VALUE)
                                        FROM TABLE(
                                            APEX_STRING.SPLIT(:P5_EMP_IDS, ':')
                                        )
                                    )
                                )
                            )
                            AND (
                                :P5_DEPTARTMENT IS NULL
                                OR D.ID = :P5_DEPTARTMENT
                            )
                            AND (
                                :P5_LOCATION IS NULL
                                OR LO.ID = :P5_LOCATION
                            )
                            AND (
                                :P5_PROJECT IS NULL
                                OR PR.ID = :P5_PROJECT
                            )
                          )
                          AND 
                          EMP.IS_ACTIVE = 1;
                
                    :P5_EMP_COUNT := l_count;
                END;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 75234422113213901
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

