    region timesheet-test (
        name: TimeSheet Test
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    t.ID,
                    t.EMP_NO AS EMP_NO,
                    t.EMP_NAME,
                    t.DEPARTMENT,
                    t.LOCATION,
                    t.PROJECT,
                    t.MONTH,
                    t.YEAR,
                    TO_CHAR(
                        t.TRANSACTION_DAY_DATE,
                        'DY',
                        'NLS_DATE_LANGUAGE=ENGLISH'
                    ) AS DAY_NAME,
                    t.TRANSACTION_DAY_DATE,
                    t.TIME_IN,
                    t.TIME_OUT,
                    t.WORKED_HOURS,
                    t.OVERTIME_BEFORE_SIX,
                    t.OVERTIME_AFTER_SIX,
                    t.R_P,
                    t.NATIONALITY,
                    t.RELIGION,
                    t.DAY_STATUS,
                    t.PERMISSION_STATUS,
                    t.ROTATION_TYPE,
                    t.ROTATION_DAY,
                    t.OVERTIME_FROM
                FROM TIME_SHEET_CACHE t
                LEFT JOIN EMPLOYEE EMP ON EMP.EMPLOYEE_NUMBER = T.EMP_NO
                LEFT JOIN DEPARTMENT D ON UPPER(D.NAME) = UPPER(T.DEPARTMENT)
                LEFT JOIN LOCATION LO ON UPPER(LO.NAME) = UPPER(T.LOCATION)
                LEFT JOIN PROJECT PR ON UPPER(PR.NAME) = UPPER(T.PROJECT)
                WHERE t.MONTH = :P5_MONTHS
                  AND t.YEAR = :P5_YEARS
                
                  AND (
                        :P5_EMP_IDS IS NULL
                        OR t.EMP_NO IN (
                            SELECT E.EMPLOYEE_NUMBER
                            FROM EMPLOYEE E
                            WHERE E.ID IN (
                                SELECT TO_NUMBER(COLUMN_VALUE)
                                FROM TABLE(
                                    APEX_STRING.SPLIT(:P5_EMP_IDS, ':')
                                )
                            )
                        )
                      )
                
                  AND (
                        :P5_DEPTARTMENT IS NULL
                        OR D.ID = :P5_DEPTARTMENT
                      )
                
                  AND (
                        :P5_LOCATION IS NULL
                        OR LO.ID = :P5_LOCATION
                      )
                
                  AND (
                        :P5_PROJECT IS NULL
                        OR PR.ID = :P5_PROJECT
                      )
                
                   AND EMP.IS_ACTIVE = 1
                
                ORDER BY
                    t.TRANSACTION_DAY_DATE ASC,
                    t.ID ASC;
                
                ```
            pageItemsToSubmit: [
                P5_MONTHS
                P5_YEARS
            ]
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
            ]
        }
