        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: ig-action-btn
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1140
                clearCache: 1140
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.CAN_WRITE_SQL('WriteVacations') = 1
