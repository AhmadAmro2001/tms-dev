        templateOptions: #DEFAULT#
    }
    css {
        fileUrls: #APP_FILES#style#MIN#.css
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Vacations
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filter-region (
        name: Filter Region
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--stacked
                t-Region--scrollBody
            ]
        }
    )

    region vacations (
        name: Vacations_data
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                    v.ID, 
                    e.EMPLOYEE_NUMBER, 
                    e.NAME AS EMPLOYEE_NAME, 
                    v.IS_INSERTED_BY_APEX as Source_type,
                    v.FROM_DATE, 
                    v.TO_DATE,
                    TRUNC(CAST(v.TO_DATE AS DATE)),
                    'Delete' as DELETE_BUTTON,
                TRUNC(CAST(v.FROM_DATE AS DATE)) + 1 AS NUMBER_OF_DAYS ,
                l.NAME AS lOCATION_NAME, 
                vt.NAME AS TYPE_NAME,
                D.NAME AS DEPARTMENT_NAME, 
                apex_page.get_url(p_page => 1140, p_items => 'P1140_ENTITY_ID', p_values => to_char(v.ID)) AS EDIT_URL ,
                apex_page.get_url(p_page => 140, p_items => 'P140_ENTITY_ID', p_values => to_char(v.ID)) AS VIEW_URL ,
                v.CREATION_DATE
                from VACATION v join EMPLOYEE e on e.ID=v.EMPLOYEE_ID left join VACATION_TYPE vt on vt.ID=v.TYPE_ID
                JOIN DEPARTMENT D ON D.ID = E.DEPARTMENT_ID
                JOIN LOCATION l ON l.ID = E.LOCATION_ID
                 where e.LOCATION_ID in (select to_number(column_value) from table(apex_string.split(:APP_USER_LOCATION_IDS, ':'))) 
                 AND :P31_SUBMIT_FLAG = 'Y'
                 AND (
                    :P31_EMPLOYEE_NUMBER IS NULL
                    OR e.EMPLOYEE_NUMBER = :P31_EMPLOYEE_NUMBER
                )
                  AND (
                    :P31_DEPARTMENTS IS NULL
                    OR e.DEPARTMENT_ID = :P31_DEPARTMENTS
                )
                 AND (
                    :P31_LOCATIONS IS NULL
                    OR e.LOCATION_ID = :P31_LOCATIONS
                )
                 AND (
                    :P31_FROM IS NULL
                    OR v.FROM_DATE >= to_date(:P31_FROM, 'dd-mm-yyyy')
                 )
                  AND (
                    :P31_TO IS NULL
                    OR v.TO_DATE <= to_date(:P31_TO, 'dd-mm-yyyy')
                 )
                 order by v.FROM_DATE desc
                ```
            pageItemsToSubmit: [
                P31_EMPLOYEE_NUMBER
                P31_SUBMIT_FLAG
                P31_DEPARTMENTS
                P31_LOCATIONS
                P31_FROM
                P31_TO
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: vacation_report
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.CAN_READ_SQL('ReadVacations') = 1
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No matching rows are available in your permitted scope.
            whenMoreDataFound: Apply filters to reduce the result set before exporting.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 47965700028343142
        }

