    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @submit
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @trainings
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: Y
            }
            affectedElements {
                selectionType: items
                items: P33_SUBMIT_FLAG
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new_1 (
        name: New
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @reset
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @trainings
            }
