    dynamicAction new_2 (
        name: New
        execution {
            sequence: 40
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(document).on('click', '.delete-btn', function () {
                    
                        var id = $(this).data("id");
                        apex.message.confirm("Are you sure you want to proceed?", function (okPressed) {
                            if (okPressed) {
                    
                                apex.server.process(
                                    "DELETE_TRAINING",
                                    {
                                        x01: id
                                    },
                                    {
                                        success: function () {
                    
                                            // console.log('ya hamada');
                                            apex.region("training_report").refresh();
                                        },
                                        error: function (pError) {
                                            console.error(pError);
                                        }
                                    }
                                );
                            }
                        });
                    
                    
                    
                    
                    });
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refresh-trainings-after-dialog (
        name: Refresh after dialog close
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @trainings
        }

        action refresh-report (
            action: refresh
            affectedElements {
                selectionType: region
                region: @trainings
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process delete-training (
        name: DELETE_TRAINING
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_status   VARCHAR2(30);
                    l_message  VARCHAR2(4000);
                    l_type varchar2 := 'TRAINING';
                BEGIN
                    DELETE_PKG.delete_training(
                        p_id => apex_application.g_x01
                    );
                
                    AUDIT_PKG.record_event('REFERENCE_TRAINING_DELETE', l_type,  apex_application.g_x01, null);
                
                    IF l_status = 'REJECTED' THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            l_message
                        );
                    END IF;
                
                
                
                    apex_json.open_object;
                    apex_json.write('msg', 'ok') ;
                    apex_json.close_object;
                END;
                
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 78266473526676815
        }
    )

)
