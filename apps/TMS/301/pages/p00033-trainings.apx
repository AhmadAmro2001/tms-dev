        )

        action native-set-value_1 (
            action: setValue
            affectedElements {
                selectionType: items
                items: [
                    P33_EMPLOYEE_NUMBER
                    P33_LOCATIONS
                    P33_FROM
                    P33_TO
                ]
            }
            execution {
                sequence: 30
            }
        )

