    pageGroup: @employees
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    css {
        fileUrls: #APP_FILES#style#MIN#.css
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Trainings
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filter-region (
        name: Filter Region
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--stacked
                t-Region--scrollBody
            ]
        }
    )

    region trainings (
        name: Trainings_data
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select t.ID, e.EMPLOYEE_NUMBER, e.NAME AS EMPLOYEE_NAME,t.IS_INSERTED_BY_APEX, l.name as location_name, t.FROM_DATE, t.TO_DATE, t.DESCRIPTION, apex_page.get_url(p_page => 1142, p_items => 'P1142_ENTITY_ID', p_values => to_char(t.ID)) AS EDIT_URL,
                apex_page.get_url(p_page => 1150, p_items => 'P1150_ENTITY_ID', p_values => to_char(t.ID)) AS VIEW_URL  ,
                       'Delete' as DELETE_BUTTON
                from TRAINING t 
                join EMPLOYEE e on e.ID=t.EMPLOYEE_ID 
                 join location l on l.id = e.location_id
                where e.LOCATION_ID in (select to_number(column_value) from table(apex_string.split(:APP_USER_LOCATION_IDS, ':'))) 
                 AND :P33_SUBMIT_FLAG = 'Y'
                 AND (
                    :P33_EMPLOYEE_NUMBER IS NULL
                    OR e.EMPLOYEE_NUMBER = :P33_EMPLOYEE_NUMBER
                )
                 AND (
                    :P33_LOCATIONS IS NULL
                    OR e.LOCATION_ID = :P33_LOCATIONS
                )
                 AND (
                    :P33_FROM IS NULL
                    OR t.FROM_DATE >= to_date(:P33_FROM, 'dd-mm-yyyy')
                 )
                  AND (
                    :P33_TO IS NULL
                    OR t.TO_DATE <= to_date(:P33_TO, 'dd-mm-yyyy')
                 )
                order by t.FROM_DATE desc
                ```
            pageItemsToSubmit: [
                P33_SUBMIT_FLAG
                P33_EMPLOYEE_NUMBER
                P33_LOCATIONS
                P33_FROM
                P33_TO
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: training_report
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.CAN_READ_SQL('ReadTrainings') = 1
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No matching rows are available in your permitted scope.
            whenMoreDataFound: Apply filters to reduce the result set before exporting.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 47968309550343143
        }

