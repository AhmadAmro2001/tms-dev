page 1151 (
    name: Rotation Plan Details
    alias: ROTATION-PLAN-DETAILS
    title: Rotation Plan Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    css {
        fileUrls: #APP_FILES#style#MIN#.css
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        config {
            buildOption: @commented-out
        }
    )

    region form-body (
        name: Rotation Plan Form
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region new (
        name: Rotation plans Detals
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                
                DECLARE
                    l_html              CLOB;
                
                    -- Rotation Plan Information
                    l_visibility        VARCHAR2(30);
                    l_visibility_class  VARCHAR2(30);
                
                    --------------------------------------------------
                    -- Escape HTML
                    --------------------------------------------------
                    FUNCTION safe_text(
                        p_value IN VARCHAR2
                    ) RETURN VARCHAR2
                    IS
                    BEGIN
                        RETURN apex_escape.html(
                            NVL(TRIM(p_value), 'Not provided')
                        );
                    END;
                
                    --------------------------------------------------
                    -- Reusable Information Card
                    --------------------------------------------------
                    FUNCTION info_card(
                        p_label IN VARCHAR2,
                        p_value IN VARCHAR2
                    ) RETURN VARCHAR2
                    IS
                    BEGIN
                        RETURN
                            '<div class="ev-field">' ||
                                '<span class="ev-field-label">' ||
                                    apex_escape.html(p_label) ||
                                '</span>' ||
                                '<span class="ev-field-value">' ||
                                    safe_text(p_value) ||
                                '</span>' ||
                            '</div>';
                    END;
                
                BEGIN
                
                    --------------------------------------------------
                    -- Check Rotation Plan
                    --------------------------------------------------
                    IF :P1151_ENTITY_ID IS NULL THEN
                        RETURN
                            '<div class="employee-not-found">
                                No rotation plan selected.
                            </div>';
                    END IF;
                
                    --------------------------------------------------
                    -- Rotation Plan Visibility
                    --------------------------------------------------
                    IF UPPER(TRIM(:P1151_IS_VISIBLE)) IN ('1', 'Y') THEN
                        l_visibility := 'Visible';
                        l_visibility_class := 'ev-active';
                
                    ELSIF UPPER(TRIM(:P1151_IS_VISIBLE)) IN ('0', 'N') THEN
                        l_visibility := 'Hidden';
                        l_visibility_class := 'ev-inactive';
                
                    ELSE
                        l_visibility := 'Not Specified';
                        l_visibility_class := 'ev-neutral';
                    END IF;
                
                    --------------------------------------------------
                    -- Rotation Plan Header
                    --------------------------------------------------
                    l_html := q'~
                    <div class="ev-profile">
                
                        <div class="employee-card ev-header">
                
                            <div class="employee-icon">
                                <span class="fa fa-refresh"
                                      aria-hidden="true"></span>
                            </div>
                
                            <div class="employee-details ev-identity">
                
                                <span class="employee-label">
                                    ROTATION PLAN
                                </span>
                
                                <div class="employee-name">~' ||
                                    safe_text(:P1151_NAME) ||
                                q'~</div>
                
                                <div class="employee-number">
                                    <span class="fa fa-hashtag"
                                          aria-hidden="true"></span>
                                    Plan ID
                                    <strong>~' ||
                                        safe_text(:P1151_ENTITY_ID) ||
                                    q'~</strong>
                                </div>
                
                            </div>
                
                            <span class="ev-status ~' ||
                                l_visibility_class ||
                            q'~">
                                <span class="ev-status-dot"></span>~' ||
                                    l_visibility ||
                            q'~</span>
                
                        </div>
                
                        <!-- Rotation Plan Information -->
                        <section class="ev-panel">
                
                            <div class="ev-section-title">
                                <span class="fa fa-calendar"
                                      aria-hidden="true"></span>
                                <h3>Rotation Plan Information</h3>
                            </div>
                
                            <div class="ev-grid">
                    ~';
                
                    --------------------------------------------------
                    -- Rotation Plan Information Cards
                    --------------------------------------------------
                    l_html := l_html ||
                
                        info_card(
                            'Rotation Plan Name',
                            :P1151_NAME
                        ) ||
                
                        info_card(
                            'Days',
                            :P1151_DAYS
                        ) ||
                
                        info_card(
                            'Start Date',
                            :P1151_START_DATE
                        ) ||
                
                        info_card(
                            'Work Type',
                            :P1151_WORK_TYPE
                        ) ||
                
                        info_card(
                            'Visibility',
                            l_visibility
                        );
                
                    l_html := l_html || q'~
                            </div>
                        </section>
                
                    </div>
                    ~';
                
                    RETURN l_html;
                
                END;
                
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
    )

    pageItem P1151_DAYS (
        type: hidden
        layout {
            sequence: 11
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the number of days in the rotation cycle (1-30).
        }
    )

    pageItem P1151_ENTITY_ID (
        type: hidden
        layout {
            sequence: 1
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1151_EXPECTED_VERSION (
        type: hidden
        layout {
            sequence: 2
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
    )

    pageItem P1151_IDEMPOTENCY_KEY (
        type: hidden
        layout {
            sequence: 1
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1151_IS_VISIBLE (
        type: hidden
        layout {
            sequence: 13
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter Y if this rotation plan is visible to employees.
        }
    )

    pageItem P1151_NAME (
        type: hidden
        layout {
            sequence: 10
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the rotation plan name.
        }
    )

    pageItem P1151_START_DATE (
        type: hidden
        layout {
            sequence: 12
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the rotation plan start date.
        }
    )

    pageItem P1151_WORK_TYPE (
        type: hidden
        layout {
            sequence: 14
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the rotation plan work type.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction cancel-dialog (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button delete (
        buttonName: DELETE
        label: Delete or Archive
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Confirm the package-backed delete/archive operation.
            style: danger
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        config {
            buildOption: @commented-out
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Rotation Plan operation completed
        }
        advanced {
            executionMappingIdentifier: 49804637364557969
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,DELETE
        }
    )

    process delete-rotation-plan (
        name: Delete Rotation Plan Through Package
        type: executeCode
        source {
            plsqlCode: DECLARE l_status varchar2(30); l_message varchar2(4000); BEGIN SCHEDULE_API_PKG.delete_schedule('ROTATION_PLAN', :P1151_ENTITY_ID, l_status, l_message); IF l_status = 'REJECTED' THEN raise_application_error(-20001, l_message); END IF; END;
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 49804228360557968
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-rotation-plan-form (
        name: Initialize Rotation Plan Form
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    :P1151_IDEMPOTENCY_KEY := nvl(:P1151_IDEMPOTENCY_KEY, rawtohex(sys_guid()));
                    IF :P1151_ENTITY_ID IS NOT NULL THEN
                        SELECT NAME, DAYS, START_DATE, IS_VISIBLE, WORK_TYPE, ORA_ROWSCN
                          INTO :P1151_NAME, :P1151_DAYS, :P1151_START_DATE, :P1151_IS_VISIBLE, :P1151_WORK_TYPE, :P1151_EXPECTED_VERSION
                          FROM ROTATION_PLAN WHERE ID = :P1151_ENTITY_ID;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 49803406846557968
        }
    )

    process save-rotation-plan (
        name: Save Rotation Plan Through Package
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE l_id number; l_status varchar2(30); l_message varchar2(4000); BEGIN
                    SCHEDULE_API_PKG.upsert_schedule('ROTATION_PLAN', :P1151_ENTITY_ID, null, null, :P1151_NAME, to_date(:P1151_START_DATE, 'YYYY-MM-DD'), null, :P1151_DAYS, null, :P1151_IS_VISIBLE, :P1151_WORK_TYPE, :P1151_EXPECTED_VERSION, :P1151_IDEMPOTENCY_KEY, l_id, l_status, l_message);
                    IF l_status in ('REJECTED','CONFLICT') THEN raise_application_error(-20001, l_message); END IF;
                    :P1151_ENTITY_ID := l_id;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 49803804981557968
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)
