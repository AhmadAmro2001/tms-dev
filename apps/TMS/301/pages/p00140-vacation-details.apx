page 140 (
    name: Vacation Details
    alias: VACATION-DETAILS
    title: Vacation Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    css {
        fileUrls: #APP_FILES#style#MIN#.css
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        config {
            buildOption: @commented-out
        }
    )

    region form-body (
        name: Vacation Form
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region vacation-details (
        name: Vacation Details
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                
                DECLARE
                    l_html            CLOB;
                
                    -- Employee Information
                    l_employee_name   EMPLOYEE.NAME%TYPE;
                    l_employee_number VARCHAR2(100);
                
                    -- Vacation Information
                    l_vacation_type   VACATION_TYPE.NAME%TYPE;
                    l_from_date       VARCHAR2(100);
                    l_to_date         VARCHAR2(100);
                    l_calendar_days   NUMBER;
                
                    --------------------------------------------------
                    -- Escape HTML
                    --------------------------------------------------
                    FUNCTION safe_text(
                        p_value IN VARCHAR2
                    ) RETURN VARCHAR2
                    IS
                    BEGIN
                        RETURN apex_escape.html(
                            NVL(TRIM(p_value), 'Not provided')
                        );
                    END;
                
                    --------------------------------------------------
                    -- Reusable Information Card
                    --------------------------------------------------
                    FUNCTION info_card(
                        p_label IN VARCHAR2,
                        p_value IN VARCHAR2
                    ) RETURN VARCHAR2
                    IS
                    BEGIN
                        RETURN
                            '<div class="ev-field">' ||
                                '<span class="ev-field-label">' ||
                                    apex_escape.html(p_label) ||
                                '</span>' ||
                                '<span class="ev-field-value">' ||
                                    safe_text(p_value) ||
                                '</span>' ||
                            '</div>';
                    END;
                
                BEGIN
                
                    --------------------------------------------------
                    -- Check Vacation Record
                    --------------------------------------------------
                    IF :P140_ENTITY_ID IS NULL THEN
                        RETURN
                            '<div class="employee-not-found">
                                No vacation record selected.
                            </div>';
                    END IF;
                
                    --------------------------------------------------
                    -- Get Vacation, Employee & Vacation Type
                    --------------------------------------------------
                    BEGIN
                        SELECT
                            e.NAME,
                            TO_CHAR(e.EMPLOYEE_NUMBER),
                
                            vt.NAME,
                
                            TO_CHAR(
                                v.FROM_DATE,
                                'DD Mon YYYY',
                                'NLS_DATE_LANGUAGE=ENGLISH'
                            ),
                
                            TO_CHAR(
                                v.TO_DATE,
                                'DD Mon YYYY',
                                'NLS_DATE_LANGUAGE=ENGLISH'
                            ),
                
                            CASE
                                WHEN v.FROM_DATE IS NOT NULL
                                 AND v.TO_DATE IS NOT NULL
                                 AND v.TO_DATE >= v.FROM_DATE
                                THEN
                                    TRUNC(CAST(v.TO_DATE AS DATE))
                                    -
                                    TRUNC(CAST(v.FROM_DATE AS DATE))
                                    + 1
                                ELSE
                                    NULL
                            END
                
                        INTO
                            l_employee_name,
                            l_employee_number,
                            l_vacation_type,
                            l_from_date,
                            l_to_date,
                            l_calendar_days
                
                        FROM VACATION v
                
                        LEFT JOIN EMPLOYEE e
                            ON e.ID = v.EMPLOYEE_ID
                
                        LEFT JOIN VACATION_TYPE vt
                            ON vt.ID = v.TYPE_ID
                
                        WHERE v.ID = :P140_ENTITY_ID;
                
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            RETURN
                                '<div class="employee-not-found">
                                    Vacation record not found.
                                </div>';
                    END;
                
                    --------------------------------------------------
                    -- Vacation Header
                    --------------------------------------------------
                    l_html := q'~
                    <div class="ev-profile">
                
                        <div class="employee-card ev-header">
                
                            <div class="employee-icon">
                                <span class="fa fa-calendar"
                                      aria-hidden="true"></span>
                            </div>
                
                            <div class="employee-details ev-identity">
                
                                <span class="employee-label">
                                    VACATION RECORD
                                </span>
                
                                <div class="employee-name">~' ||
                                    safe_text(l_employee_name) ||
                                q'~</div>
                
                                <div class="employee-number">
                                    <span class="fa fa-id-badge"
                                          aria-hidden="true"></span>
                                    Employee No.
                                    <strong>~' ||
                                        safe_text(l_employee_number) ||
                                    q'~</strong>
                                </div>
                
                            </div>
                
                            <span class="ev-status ev-neutral">
                                Vacation #~' ||
                                    safe_text(:P140_ENTITY_ID) ||
                            q'~</span>
                
                        </div>
                
                        <!-- Vacation Information -->
                        <section class="ev-panel">
                
                            <div class="ev-section-title">
                                <span class="fa fa-calendar"
                                      aria-hidden="true"></span>
                                <h3>Vacation Information</h3>
                            </div>
                
                            <div class="ev-grid">
                    ~';
                
                    --------------------------------------------------
                    -- Vacation Information Cards
                    --------------------------------------------------
                    l_html := l_html ||
                
                        info_card(
                            'Vacation Type',
                            l_vacation_type
                        ) ||
                
                        info_card(
                            'From Date',
                            l_from_date
                        ) ||
                
                        info_card(
                            'To Date',
                            l_to_date
                        ) ||
                
                        info_card(
                            'Calendar Days',
                            CASE
                                WHEN l_calendar_days IS NOT NULL
                                THEN
                                    TO_CHAR(l_calendar_days) ||
                                    CASE
                                        WHEN l_calendar_days = 1
                                        THEN ' Day'
                                        ELSE ' Days'
                                    END
                                ELSE
                                    'Not provided'
                            END
                        );
                
                    l_html := l_html || q'~
                            </div>
                        </section>
                
                    </div>
                    ~';
                
                    RETURN l_html;
                
                END;
                
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
    )

    pageItem P140_EMPLOYEE_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Select the employee for this vacation.
        }
    )

    pageItem P140_ENTITY_ID (
        type: hidden
        layout {
            sequence: 1
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P140_EXPECTED_VERSION (
        type: hidden
        layout {
            sequence: 2
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
    )

    pageItem P140_FROM_DATE (
        type: hidden
        layout {
            sequence: 11
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the vacation start date.
        }
    )

    pageItem P140_IDEMPOTENCY_KEY (
        type: hidden
        layout {
            sequence: 1
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P140_TO_DATE (
        type: hidden
        layout {
            sequence: 12
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the vacation end date.
        }
    )

    pageItem P140_TYPE_ID (
        type: hidden
        layout {
            sequence: 13
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Select the vacation type.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }
        config {
            buildOption: @commented-out
        }

        triggerAction cancel-dialog (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button delete (
        buttonName: DELETE
        label: Delete or Archive
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Confirm the package-backed delete/archive operation.
            style: danger
        }
        config {
            buildOption: @commented-out
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        config {
            buildOption: @commented-out
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Vacation operation completed
        }
        advanced {
            executionMappingIdentifier: 78417751069390778
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,DELETE
        }
        config {
            buildOption: @commented-out
        }
    )

    process delete-vacation (
        name: Delete Vacation Through Package
        type: executeCode
        source {
            plsqlCode: DECLARE l_status varchar2(30); l_message varchar2(4000); BEGIN EVENT_API_PKG.delete_event('VACATION', :P140_ENTITY_ID, l_status, l_message); IF l_status = 'REJECTED' THEN raise_application_error(-20001, l_message); END IF; END;
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 78417341376390777
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
        config {
            buildOption: @commented-out
        }
    )

    process initialize-vacation-form (
        name: Initialize Vacation Form
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    :P140_IDEMPOTENCY_KEY := nvl(:P140_IDEMPOTENCY_KEY, rawtohex(sys_guid()));
                    IF :P140_ENTITY_ID IS NOT NULL THEN
                        SELECT EMPLOYEE_ID, FROM_DATE, TO_DATE, TYPE_ID, ORA_ROWSCN
                          INTO :P140_EMPLOYEE_ID, :P140_FROM_DATE, :P140_TO_DATE, :P140_TYPE_ID, :P140_EXPECTED_VERSION
                          FROM VACATION WHERE ID = :P140_ENTITY_ID;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 78416548990390776
        }
    )

    process save-vacation (
        name: Save Vacation Through Package
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE l_id number; l_status varchar2(30); l_message varchar2(4000); BEGIN
                    EVENT_API_PKG.upsert_event('VACATION', :P140_ENTITY_ID, :P140_EMPLOYEE_ID, to_date(:P140_FROM_DATE, 'YYYY-MM-DD'), to_date(:P140_TO_DATE, 'YYYY-MM-DD'), :P140_TYPE_ID, null, :P140_EXPECTED_VERSION, :P140_IDEMPOTENCY_KEY, l_id, l_status, l_message);
                    IF l_status in ('REJECTED','CONFLICT') THEN raise_application_error(-20001, l_message); END IF;
                    :P140_ENTITY_ID := l_id;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 78416908033390777
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
        config {
            buildOption: @commented-out
        }
    )

)
