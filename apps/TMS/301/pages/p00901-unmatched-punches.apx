page 901 (
    name: Unmatched Punches
    alias: UNMATCHED-PUNCHES
    title: Unmatched Punches
    pageGroup: @attendance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Unmatched Punches
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region no-access-notice (
        name: No Access
        type: staticContent
        source {
            htmlCode: <p>You do not have permission to read transactions.</p>
        }
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.CAN_READ_SQL('ReadTransactions') = 0
        }
    )

    region source-unavailable-notice (
        name: Source Unavailable
        type: staticContent
        source {
            htmlCode: <p>The punch source system is temporarily unavailable. Showing no rows until the source link is restored.</p>
        }
        layout {
            sequence: 16
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.CAN_READ_SQL('ReadTransactions') = 1 and REPORT_API_PKG.source_link_available_sql = 0
        }
    )

    region unmatched-punches-filters (
        name: Unmatched Punches Filters
        type: staticContent
        layout {
            sequence: 18
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region unmatched-punches-report (
        name: Unmatched Punches
        type: classicReport
        source {
            location: localDatabase
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                begin
                    return REPORT_API_PKG.get_unmatched_punch_sql;
                end;
                ```
            pageItemsToSubmit: [
                "[P901_FROM_DATE"
                "P901_TO_DATE]"
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.CAN_READ_SQL('ReadTransactions') = 1
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: No unmatched source punches are available in your permitted scope for this date range.
        }

        column DEVICE_NAME (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: DEVICE_NAME
            }
            layout {
                sequence: 50
            }
        )

        column SOURCE_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: SOURCE_ID
            }
            layout {
                sequence: 10
            }
        )

        column SOURCE_TIMESTAMP (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: SOURCE_TIMESTAMP
            }
            layout {
                sequence: 40
            }
        )

        column SOURCE_USER_ID (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: SOURCE_USER_ID
            }
            layout {
                sequence: 20
            }
        )

        column TK (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: TK
            }
            layout {
                sequence: 30
            }
        )

    )

    pageItem P901_FROM_DATE (
        type: datePicker
        label {
            label: From Date
            alignment: left
        }
        layout {
            sequence: 10
            region: @unmatched-punches-filters
            slot: regionBody
            alignment: left
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Include unmatched punches from this date.
        }
    )

    pageItem P901_TO_DATE (
        type: datePicker
        label {
            label: To Date
            alignment: left
        }
        layout {
            sequence: 20
            region: @unmatched-punches-filters
            slot: regionBody
            alignment: left
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Include unmatched punches through this date.
        }
    )

    button apply-unmatched-punches-filters (
        buttonName: APPLY_UNMATCHED_PUNCHES_FILTERS
        label: Apply Filters
        layout {
            sequence: 30
            region: @unmatched-punches-filters
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

)
