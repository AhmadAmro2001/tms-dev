    region no-access-notice (
        name: No Access
        type: staticContent
        source {
            htmlCode: <p>You do not have permission to read transactions.</p>
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.CAN_READ_SQL('ReadTransactions') = 0
        }
    )

    region transactions (
        name: Transactions
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    t.ID,
                    e.EMPLOYEE_NUMBER,
                    e.NAME AS EMPLOYEE_NAME,
                    l.NAME AS LOCATION_NAME,
                
                    CASE t.TYPE
                        WHEN '0' THEN 'In'
                        ELSE 'Out'
                    END AS TRANSACTION_TYPE,
                
                    -- TO_CHAR(t."DATE", 'DD-MM-YYYY') AS TRANSACTION_DATE,
                    -- TO_CHAR(t."DATE", 'HH12:MI AM') AS TRANSACTION_TIME,
                    TO_CHAR(
                        FROM_TZ(CAST(t."DATE" AS TIMESTAMP), 'UTC')
                        AT TIME ZONE 'Africa/Cairo',
                        'DD-MM-YYYY'
                    ) AS TRANSACTION_DATE,
                
                    TO_CHAR(
                        FROM_TZ(CAST(t."DATE" AS TIMESTAMP), 'UTC')
                        AT TIME ZONE 'Africa/Cairo',
                        'HH24:MI'
                    ) AS TRANSACTION_TIME,
                    t.DEVICE_NAME,
                
                    APEX_PAGE.GET_URL(
                        p_page   => 1123,
                        p_items  => 'P1123_TRANSACTION_ID',
                        p_values => TO_CHAR(t.ID) 
                    ) AS EDIT_URL,
                    'Delete' as DELETE_BUTTON
                
                FROM TRANSACTION t
                
                JOIN EMPLOYEE e
                    ON e.ID = t.EMPLOYEE_ID
                
                LEFT JOIN LOCATION l
                    ON l.ID = e.LOCATION_ID
                
                WHERE
                    e.LOCATION_ID IN (
                        SELECT TO_NUMBER(column_value)
                        FROM TABLE(APEX_STRING.SPLIT(:APP_USER_LOCATION_IDS, ':'))
                    )
                
                    AND :P11_SUBMIT_FLAG = 'Y'
                
                    AND (
                        :P11_EMPLOYEE_NUMBER IS NULL
                        OR e.EMPLOYEE_NUMBER = :P11_EMPLOYEE_NUMBER
                    )
                
                    AND (
                        :P11_FROM IS NULL
                        OR t."DATE" >= CAST(
                            FROM_TZ(
                                CAST(
                                    TO_DATE(
                                        :P11_FROM,
                                        'DD-MON-RR',
                                        'NLS_DATE_LANGUAGE=ENGLISH'
                                    ) AS TIMESTAMP
                                ),
                                'Africa/Cairo'
                            ) AT TIME ZONE 'UTC'
                            AS DATE
                        )
                    )
                
                    AND (
                        :P11_TO IS NULL
                        OR t."DATE" < CAST(
                            FROM_TZ(
                                CAST(
                                    TO_DATE(
                                        :P11_TO,
                                        'DD-MON-RR',
                                        'NLS_DATE_LANGUAGE=ENGLISH'
                                    ) + 1 AS TIMESTAMP
                                ),
                                'Africa/Cairo'
                            ) AT TIME ZONE 'UTC'
                            AS DATE
                        )
                    )
                
                    AND (
                        :P11_DEPARTMENT IS NULL
                        OR e.DEPARTMENT_ID = :P11_DEPARTMENT
                    )
                
                    AND (
                        :P11_GRADE IS NULL
                        OR e.GRADE_ID = :P11_GRADE
                    )
                
                    AND (
                        :P11_PROJECT IS NULL
                        OR e.PROJECT_ID = :P11_PROJECT
                    )
                
                    AND (
                        :P11_LOCATION IS NULL
                        OR e.LOCATION_ID = :P11_LOCATION
                    )
                
                ORDER BY
                    t."DATE" DESC;
                ```
            pageItemsToSubmit: [
                P11_EMPLOYEE_NUMBER
                P11_LOCATION
                P11_PROJECT
                P11_DEPARTMENT
                P11_GRADE
                P11_FROM
                P11_SUBMIT_FLAG
                P11_TO
            ]
        }
        layout {
