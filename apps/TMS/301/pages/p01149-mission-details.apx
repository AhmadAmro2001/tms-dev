page 1149 (
    name: Mission Details
    alias: MISSION-DETAILS
    title: Mission Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    css {
        fileUrls: #APP_FILES#style#MIN#.css
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        config {
            buildOption: @commented-out
        }
    )

    region form-body (
        name: Mission Form
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region mission-details (
        name: Mission Details
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                
                DECLARE
                    l_html            CLOB;
                
                    -- Employee Information
                    l_employee_name   EMPLOYEE.NAME%TYPE;
                    l_employee_number VARCHAR2(100);
                
                    -- Mission Information
                    l_from_date       VARCHAR2(100);
                    l_to_date         VARCHAR2(100);
                    l_description     MISSION.DESCRIPTION%TYPE;
                    l_mission_days    NUMBER;
                
                    --------------------------------------------------
                    -- Escape HTML
                    --------------------------------------------------
                    FUNCTION safe_text(
                        p_value IN VARCHAR2
                    ) RETURN VARCHAR2
                    IS
                    BEGIN
                        RETURN apex_escape.html(
                            NVL(TRIM(p_value), 'Not provided')
                        );
                    END;
                
                    --------------------------------------------------
                    -- Reusable Information Card
                    --------------------------------------------------
                    FUNCTION info_card(
                        p_label IN VARCHAR2,
                        p_value IN VARCHAR2,
                        p_full_width IN BOOLEAN DEFAULT FALSE
                    ) RETURN VARCHAR2
                    IS
                        l_class VARCHAR2(100) := 'ev-field';
                        l_style VARCHAR2(200) := '';
                    BEGIN
                
                        IF p_full_width THEN
                            l_style := ' style="grid-column: 1 / -1;"';
                        END IF;
                
                        RETURN
                            '<div class="' || l_class || '"' ||
                                l_style || '>' ||
                
                                '<span class="ev-field-label">' ||
                                    apex_escape.html(p_label) ||
                                '</span>' ||
                
                                '<span class="ev-field-value" ' ||
                                    'style="white-space: pre-wrap;">' ||
                                    safe_text(p_value) ||
                                '</span>' ||
                
                            '</div>';
                
                    END;
                
                BEGIN
                
                    --------------------------------------------------
                    -- Check Mission Record
                    --------------------------------------------------
                    IF :P1149_ENTITY_ID IS NULL THEN
                        RETURN
                            '<div class="employee-not-found">
                                No mission record selected.
                            </div>';
                    END IF;
                
                    --------------------------------------------------
                    -- Get Mission & Employee Information
                    --------------------------------------------------
                    BEGIN
                
                        SELECT
                            e.NAME,
                            TO_CHAR(e.EMPLOYEE_NUMBER),
                
                            TO_CHAR(
                                m.FROM_DATE,
                                'DD Mon YYYY',
                                'NLS_DATE_LANGUAGE=ENGLISH'
                            ),
                
                            TO_CHAR(
                                m.TO_DATE,
                                'DD Mon YYYY',
                                'NLS_DATE_LANGUAGE=ENGLISH'
                            ),
                
                            m.DESCRIPTION,
                
                            CASE
                                WHEN m.FROM_DATE IS NOT NULL
                                 AND m.TO_DATE IS NOT NULL
                                 AND m.TO_DATE >= m.FROM_DATE
                                THEN
                                    TRUNC(CAST(m.TO_DATE AS DATE))
                                    -
                                    TRUNC(CAST(m.FROM_DATE AS DATE))
                                    + 1
                                ELSE
                                    NULL
                            END
                
                        INTO
                            l_employee_name,
                            l_employee_number,
                            l_from_date,
                            l_to_date,
                            l_description,
                            l_mission_days
                
                        FROM MISSION m
                
                        JOIN EMPLOYEE e
                            ON e.ID = m.EMPLOYEE_ID
                
                        WHERE m.ID = :P1149_ENTITY_ID;
                
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            RETURN
                                '<div class="employee-not-found">
                                    Mission record not found.
                                </div>';
                    END;
                
                    --------------------------------------------------
                    -- Mission Header
                    --------------------------------------------------
                    l_html := q'~
                    <div class="ev-profile">
                
                        <div class="employee-card ev-header">
                
                            <div class="employee-icon">
                                <span class="fa fa-briefcase"
                                      aria-hidden="true"></span>
                            </div>
                
                            <div class="employee-details ev-identity">
                
                                <span class="employee-label">
                                    MISSION RECORD
                                </span>
                
                                <div class="employee-name">~' ||
                                    safe_text(l_employee_name) ||
                                q'~</div>
                
                                <div class="employee-number">
                                    <span class="fa fa-id-badge"
                                          aria-hidden="true"></span>
                                    Employee No.
                                    <strong>~' ||
                                        safe_text(l_employee_number) ||
                                    q'~</strong>
                                </div>
                
                            </div>
                
                            <span class="ev-status ev-neutral">
                                Mission #~' ||
                                    safe_text(:P1149_ENTITY_ID) ||
                            q'~</span>
                
                        </div>
                
                        <!-- Mission Information -->
                        <section class="ev-panel">
                
                            <div class="ev-section-title">
                                <span class="fa fa-calendar-check-o"
                                      aria-hidden="true"></span>
                                <h3>Mission Information</h3>
                            </div>
                
                            <div class="ev-grid">
                    ~';
                
                    --------------------------------------------------
                    -- Mission Information Cards
                    --------------------------------------------------
                    l_html := l_html ||
                
                        info_card(
                            'From Date',
                            l_from_date
                        ) ||
                
                        info_card(
                            'To Date',
                            l_to_date
                        ) ||
                
                        info_card(
                            'Mission Duration',
                            CASE
                                WHEN l_mission_days IS NOT NULL
                                THEN
                                    TO_CHAR(l_mission_days) ||
                                    CASE
                                        WHEN l_mission_days = 1
                                        THEN ' Day'
                                        ELSE ' Days'
                                    END
                                ELSE
                                    'Not provided'
                            END
                        ) ||
                
                        info_card(
                            'Mission Description',
                            l_description,
                            TRUE
                        );
                
                    l_html := l_html || q'~
                            </div>
                        </section>
                
                    </div>
                    ~';
                
                    RETURN l_html;
                
                END;
                
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
    )

