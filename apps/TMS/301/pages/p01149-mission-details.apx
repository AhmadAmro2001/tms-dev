    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction cancel-dialog (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button delete (
        buttonName: DELETE
        label: Delete or Archive
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Confirm the package-backed delete/archive operation.
            style: danger
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        config {
            buildOption: @commented-out
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Mission operation completed
        }
        advanced {
            executionMappingIdentifier: 49334330316817629
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,DELETE
        }
    )

    process delete-mission (
        name: Delete Mission Through Package
        type: executeCode
        source {
            plsqlCode: DECLARE l_status varchar2(30); l_message varchar2(4000); BEGIN EVENT_API_PKG.delete_event('MISSION', :P1149_ENTITY_ID, l_status, l_message); IF l_status = 'REJECTED' THEN raise_application_error(-20001, l_message); END IF; END;
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 49333958514817628
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-mission-form (
        name: Initialize Mission Form
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    :P1149_IDEMPOTENCY_KEY := NVL(
                        :P1149_IDEMPOTENCY_KEY,
                        RAWTOHEX(SYS_GUID())
                    );
                
                    IF :P1149_ENTITY_ID IS NOT NULL THEN
                
                        SELECT
                            m.EMPLOYEE_ID,
                            e.NAME,
                            m.FROM_DATE,
                            m.TO_DATE,
                            m.DESCRIPTION,
                            m.ORA_ROWSCN
                        INTO
                            :P1149_EMPLOYEE_ID,
                            :P1149_EMPLOYEE_NAME,
                            :P1149_FROM_DATE,
                            :P1149_TO_DATE,
                            :P1149_DESCRIPTION,
                            :P1149_EXPECTED_VERSION
                        FROM MISSION m
                        JOIN EMPLOYEE e
                            ON e.ID = m.EMPLOYEE_ID
                        WHERE m.ID = :P1149_ENTITY_ID;
                
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 49333101681817628
        }
    )

    process save-mission (
        name: Save Mission Through Package
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE l_id number; l_status varchar2(30); l_message varchar2(4000); BEGIN
                    EVENT_API_PKG.upsert_event('MISSION', :P1149_ENTITY_ID, :P1149_EMPLOYEE_ID, to_date(:P1149_FROM_DATE, 'YYYY-MM-DD'), to_date(:P1149_TO_DATE, 'YYYY-MM-DD'), null, :P1149_DESCRIPTION, :P1149_EXPECTED_VERSION, :P1149_IDEMPOTENCY_KEY, l_id, l_status, l_message);
                    IF l_status in ('REJECTED','CONFLICT') THEN raise_application_error(-20001, l_message); END IF;
                    :P1149_ENTITY_ID := l_id;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 49333516754817628
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)
