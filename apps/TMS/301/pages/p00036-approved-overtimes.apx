page 36 (
    name: Approved Overtimes
    alias: APPROVED-OVERTIMES
    title: Approved Overtimes
    pageGroup: @employees
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    css {
        fileUrls: #APP_FILES#style#MIN#.css
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region approved-overtimes (
        name: Approved Overtimes reprot
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                
                SELECT
                    o.ID,
                    e.EMPLOYEE_NUMBER,
                    e.NAME AS EMPLOYEE_NAME,
                    o."DATE" AS WORK_DATE,
                
                    CASE
                        WHEN o.IS_INSERTED_BY_APEX = 1 THEN 'APEX'
                        ELSE 'N/A'
                    END AS SOURCE,
                
                    -- Convert FROM_TIME from UTC to Egypt local time
                    TO_CHAR(
                        FROM_TZ(
                            CAST(o.FROM_TIME AS TIMESTAMP),
                            'UTC'
                        ) AT TIME ZONE 'Africa/Cairo',
                        'HH24:MI'
                    ) AS FROM_TIME,
                
                    -- Convert TO_TIME from UTC to Egypt local time
                    TO_CHAR(
                        FROM_TZ(
                            CAST(o.TO_TIME AS TIMESTAMP),
                            'UTC'
                        ) AT TIME ZONE 'Africa/Cairo',
                        'HH24:MI'
                    ) AS TO_TIME,
                
                    l.NAME,
                    o.CREATION_DATE,
                
                    apex_page.get_url(
                        p_page   => 1147,
                        p_items  => 'P1147_ENTITY_ID',
                        p_values => TO_CHAR(o.ID)
                    ) AS EDIT_URL,
                
                    apex_page.get_url(
                        p_page   => 147,
                        p_items  => 'P147_ENTITY_ID',
                        p_values => TO_CHAR(o.ID)
                    ) AS DETAILS,
                
                    'Delete' AS DELETE_BUTTON
                
                FROM APPROVED_OVERTIME o
                
                JOIN EMPLOYEE e
                    ON e.ID = o.EMPLOYEE_ID
                
                LEFT JOIN LOCATION l
                    ON l.ID = e.LOCATION_ID
                
                WHERE
                    :P36_SUBMIT_FLAG = 'Y'
                
                    AND (
                        :P36_EMPLOYEE_CODE IS NULL
                        OR e.EMPLOYEE_NUMBER = :P36_EMPLOYEE_CODE
                    )
                
                    AND (
                        :P36_LOCATION IS NULL
                        OR e.LOCATION_ID = :P36_LOCATION
                    )
                
                    AND (
                        :P36_FROM IS NULL
                        OR o."DATE" >= TRUNC(
                            TO_DATE(:P36_FROM, 'MM/DD/YYYY')
                        )
                    )
                
                    AND (
                        :P36_TO IS NULL
                        OR o."DATE" < TRUNC(
                            TO_DATE(:P36_TO, 'MM/DD/YYYY')
                        ) + 1
                    )
                
                ORDER BY
                    o."DATE" DESC;
                
                ```
            pageItemsToSubmit: [
                P36_EMPLOYEE_CODE
                P36_LOCATION
                P36_FROM
                P36_TO
                P36_SUBMIT_FLAG
            ]
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: approved_time_report
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.CAN_READ_SQL('ReadOvertime') = 1
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
