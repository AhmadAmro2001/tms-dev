    dynamicAction delete (
        name: DELETE
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action delete-approved-time (
            name: delete
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(document).on('click', '.delete-btn', function () {
                    
                        var id = $(this).data("id");
                        apex.message.confirm("Are you sure you want to proceed?", function (okPressed) {
                            if (okPressed) {
                    
                                apex.server.process(
                                    "DELETE_APPROVED_TIME",
                                    {
                                        x01: id
                                    },
                                    {
                                        success: function () {
                    
                                            // console.log('ya hamada');
                                            apex.region("approved_time_report").refresh();
                                        },
                                        error: function (pError) {
                                            console.error(pError);
                                        }
                                    }
                                );
                            }
                        });
                    
                    
                    
                    
                    });
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new (
        name: New
        execution {
            sequence: 50
        }
        when {
            event: click
            selectionType: button
            button: @submit
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @approved-overtimes
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: Y
            }
            affectedElements {
                selectionType: items
                items: P36_SUBMIT_FLAG
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction new_1 (
        name: New
        execution {
            sequence: 40
        }
        when {
            event: click
            selectionType: button
            button: @reset
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @approved-overtimes
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-set-value (
            action: setValue
            settings {
                value: N
            }
            affectedElements {
                selectionType: items
                items: P36_SUBMIT_FLAG
            }
            execution {
                sequence: 10
            }
        )

        action native-set-value_1 (
            action: setValue
            affectedElements {
                selectionType: items
                items: [
                    P36_EMPLOYEE_CODE
                    P36_LOCATION
                    P36_FROM
                    P36_TO
                ]
            }
            execution {
                sequence: 30
            }
        )

    )

    dynamicAction refresh-approved-overtimes-after-dialog (
        name: Refresh after dialog close
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @approved-overtimes
        }

        action refresh-report (
            action: refresh
            affectedElements {
                selectionType: region
                region: @approved-overtimes
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process new (
        name: DELETE_APPROVED_TIME
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_status   VARCHAR2(30);
                    l_message  VARCHAR2(4000);
                    l_type varchar2 := 'OVERTIME';
                BEGIN
                    DELETE_PKG.delete_approved_time(
                        p_id => apex_application.g_x01
                    );
                    AUDIT_PKG.record_event('REFERENCE_OVERTIME_DELETE', l_type,  apex_application.g_x01, null);
                
                    IF l_status = 'REJECTED' THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            l_message
                        );
                    END IF;
                
                apex_json.open_object;
                apex_json.write('msg', 'ok') ;
                apex_json.close_object;
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 53193849236531403
        }
    )

)
