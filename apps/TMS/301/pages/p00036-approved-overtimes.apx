    button create-approved-overtimes (
        buttonName: CREATE_APPROVED_OVERTIMES
        label: Create Approved Overtimes
        layout {
            sequence: 10
            region: @approved-overtimes
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: ig-action-btn
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1147
                clearCache: 1147
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: (AUTH_PKG.HAS_ROLE('1') or AUTH_PKG.HAS_ROLE('2')) and AUTH_PKG.CAN_WRITE_SQL('WriteVacations') = 1
        }
    )

    button reset (
        buttonName: Reset
