        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1126_IDEMPOTENCY_KEY (
        type: hidden
        layout {
            sequence: 2
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

