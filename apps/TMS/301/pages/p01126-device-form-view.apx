page 1126 (
    name: Device Details
    alias: DEVICE-FORM-VIEW
    title: Device Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    css {
        fileUrls: #APP_FILES#style#MIN#.css
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region device-details (
        name: Device Details
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                
                DECLARE
                    l_html               CLOB;
                
                    -- Device Information
                    l_device_name        DEVICE.NAME%TYPE;
                    l_ip                 VARCHAR2(200);
                    l_port               VARCHAR2(100);
                    l_device_type        VARCHAR2(200);
                    l_location_name      VARCHAR2(500);
                    l_last_downloaded    VARCHAR2(100);
                    l_last_transaction   VARCHAR2(100);
                    l_key_status         VARCHAR2(30);
                
                    --------------------------------------------------
                    -- Escape HTML
                    --------------------------------------------------
                    FUNCTION safe_text(
                        p_value IN VARCHAR2
                    ) RETURN VARCHAR2
                    IS
                    BEGIN
                        RETURN apex_escape.html(
                            NVL(TRIM(p_value), 'Not provided')
                        );
                    END;
                
                    --------------------------------------------------
                    -- Reusable Information Card
                    --------------------------------------------------
                    FUNCTION info_card(
                        p_label IN VARCHAR2,
                        p_value IN VARCHAR2
                    ) RETURN VARCHAR2
                    IS
                    BEGIN
                        RETURN
                            '<div class="ev-field">' ||
                                '<span class="ev-field-label">' ||
                                    apex_escape.html(p_label) ||
                                '</span>' ||
                                '<span class="ev-field-value">' ||
                                    safe_text(p_value) ||
                                '</span>' ||
                            '</div>';
                    END;
                
                BEGIN
                
                    --------------------------------------------------
                    -- Security Checks
                    --------------------------------------------------
                    IF NOT AUTH_PKG.has_role('1')
                       OR NOT AUTH_PKG.can_write('Devices') THEN
                
                        RAISE_APPLICATION_ERROR(
                            -20140,
                            'Device administration requires role 1 and Devices write access'
                        );
                
                    END IF;
                
                    IF NOT AUTH_PKG.can_read('Devices') THEN
                
                        RAISE_APPLICATION_ERROR(
                            -20140,
                            'Device read access is not permitted'
                        );
                
                    END IF;
                
                    --------------------------------------------------
                    -- Check Device Record
                    --------------------------------------------------
                    IF :P1126_DEVICE_ID IS NULL THEN
                        RETURN
                            '<div class="employee-not-found">
                                No device selected.
                            </div>';
                    END IF;
                
                    --------------------------------------------------
                    -- Get Device Information
                    --------------------------------------------------
                    BEGIN
                
                        SELECT
                            d.NAME,
                            d.IP,
                            TO_CHAR(d.PORT),
                
                            --------------------------------------------------
                            -- Device Type Mapping
                            --------------------------------------------------
                            CASE d.TYPE
                                WHEN 0 THEN 'IN/OUT'
                                WHEN 1 THEN 'IN'
                                WHEN 2 THEN 'OUT'
                                ELSE 'Unknown'
                            END,
                
                            NVL(
                                l.NAME,
                                'Not assigned'
                            ),
                
                            TO_CHAR(
                                d.LAST_DOWNLOADED,
                                'DD Mon YYYY, HH24:MI',
                                'NLS_DATE_LANGUAGE=ENGLISH'
                            ),
                
                            TO_CHAR(
                                d.LAST_TRANSACTION,
                                'DD Mon YYYY, HH24:MI',
                                'NLS_DATE_LANGUAGE=ENGLISH'
                            ),
                
                            CASE
                                WHEN d.COMMUNICATION_KEY IS NOT NULL
                                THEN 'Configured'
                                ELSE 'Not Configured'
                            END
                
                        INTO
                            l_device_name,
                            l_ip,
                            l_port,
                            l_device_type,
                            l_location_name,
                            l_last_downloaded,
                            l_last_transaction,
                            l_key_status
                
                        FROM DEVICE d
                
                        LEFT JOIN LOCATION l
                            ON l.ID = d.LOCATION_ID
                
                        WHERE d.ID = :P1126_DEVICE_ID
                          AND AUTH_PKG.can_access_location_sql(
                                d.LOCATION_ID
                              ) = 1;
                
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            RETURN
                                '<div class="employee-not-found">
                                    Device not found or access is not permitted.
                                </div>';
                    END;
                
                    --------------------------------------------------
                    -- Device Header
                    --------------------------------------------------
                    l_html := q'~
                    <div class="ev-profile">
                
                        <div class="employee-card ev-header">
                
                            <div class="employee-icon">
                                <span class="fa fa-server"
                                      aria-hidden="true"></span>
                            </div>
                
                            <div class="employee-details ev-identity">
                
                                <span class="employee-label">
                                    DEVICE PROFILE
                                </span>
                
                                <div class="employee-name">~' ||
                                    safe_text(l_device_name) ||
                                q'~</div>
                
                                <div class="employee-number">
                                    <span class="fa fa-hashtag"
                                          aria-hidden="true"></span>
                                    Device ID
                                    <strong>~' ||
                                        safe_text(:P1126_DEVICE_ID) ||
                                    q'~</strong>
                                </div>
                
                            </div>
                
                            <span class="ev-status ev-neutral">
                                Device #~' ||
                                    safe_text(:P1126_DEVICE_ID) ||
                            q'~</span>
                
                        </div>
                
                        <!-- Device Information -->
                        <section class="ev-panel">
                
                            <div class="ev-section-title">
                                <span class="fa fa-server"
                                      aria-hidden="true"></span>
                                <h3>Device Information</h3>
                            </div>
                
                            <div class="ev-grid">
                    ~';
                
                    --------------------------------------------------
                    -- Device Information Cards
                    --------------------------------------------------
                    l_html := l_html ||
                
                        info_card(
                            'Device Type',
                            l_device_type
                        ) ||
                
                        info_card(
                            'Location',
                            l_location_name
                        ) ||
                
                        info_card(
                            'IP Address',
                            l_ip
                        ) ||
                
                        info_card(
                            'Port',
                            l_port
                        );
                
                    l_html := l_html || q'~
                            </div>
                        </section>
                
                        <!-- Device Activity -->
                        <section class="ev-panel">
                
                            <div class="ev-section-title">
                                <span class="fa fa-clock-o"
                                      aria-hidden="true"></span>
                                <h3>Device Activity</h3>
                            </div>
                
                            <div class="ev-grid">
                    ~';
                
                    --------------------------------------------------
                    -- Device Activity Cards
                    --------------------------------------------------
                    l_html := l_html ||
                
                        info_card(
                            'Last Downloaded',
                            l_last_downloaded
                        ) ||
                
                        info_card(
                            'Last Transaction',
                            l_last_transaction
                        );
                
                    l_html := l_html || q'~
                            </div>
                        </section>
                
                        <!-- Connection Configuration -->
                        <section class="ev-panel">
                
                            <div class="ev-section-title">
                                <span class="fa fa-cog"
                                      aria-hidden="true"></span>
                                <h3>Connection Configuration</h3>
                            </div>
                
                            <div class="ev-grid">
                    ~';
                
                    --------------------------------------------------
                    -- Connection Configuration Cards
                    --------------------------------------------------
                    l_html := l_html ||
                
                        info_card(
                            'Communication Key',
                            l_key_status
                        );
                
                    l_html := l_html || q'~
                            </div>
                        </section>
                
                    </div>
                    ~';
                
                    RETURN l_html;
                
                END;
                
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
    )

    region form-body (
        name: Device Form
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1126_COMMUNICATION_KEY (
        type: hidden
        layout {
            sequence: 40
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
    )

    pageItem P1126_DEVICE_ID (
        type: hidden
