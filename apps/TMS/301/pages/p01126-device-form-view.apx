        type: hidden
        layout {
            sequence: 20
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
    )

    pageItem P1126_LAST_DOWNLOADED (
        type: hidden
        layout {
            sequence: 70
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
    )

    pageItem P1126_LAST_TRANSACTION (
        type: hidden
        layout {
            sequence: 80
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
    )

    pageItem P1126_LOCATION_ID (
        type: hidden
        layout {
            sequence: 60
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
    )

    pageItem P1126_NAME (
        type: hidden
        layout {
            sequence: 10
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
    )

    pageItem P1126_PORT (
        type: hidden
        layout {
            sequence: 30
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
    )

    pageItem P1126_TYPE (
        type: hidden
        layout {
