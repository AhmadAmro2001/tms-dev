page 143 (
    name: Permission Details
    alias: PERMISSION-DETAILS
    title: Permission Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    css {
        fileUrls: #APP_FILES#style#MIN#.css
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        config {
            buildOption: @commented-out
        }
    )

    region form-body (
        name: Permission Form
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region permission-details (
        name: Permission Details
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                
                DECLARE
                    l_html            CLOB;
                
                    -- Employee Information
                    l_employee_name   EMPLOYEE.NAME%TYPE;
                    l_employee_number VARCHAR2(100);
                
                    -- Permission Information
                    l_permission_type PERMISSION_TYPE.NAME%TYPE;
                    l_permission_date VARCHAR2(100);
                    l_from_time       VARCHAR2(100);
                    l_to_time         VARCHAR2(100);
                    l_description     PERMISSION.DESCRIPTION%TYPE;
                
                    --------------------------------------------------
                    -- Escape HTML
                    --------------------------------------------------
                    FUNCTION safe_text(
                        p_value IN VARCHAR2
                    ) RETURN VARCHAR2
                    IS
                    BEGIN
                        RETURN apex_escape.html(
                            NVL(TRIM(p_value), 'Not provided')
                        );
                    END;
                
                    --------------------------------------------------
                    -- Reusable Information Card
                    --------------------------------------------------
                    FUNCTION info_card(
                        p_label      IN VARCHAR2,
                        p_value      IN VARCHAR2,
                        p_full_width IN BOOLEAN DEFAULT FALSE
                    ) RETURN VARCHAR2
                    IS
                        l_style VARCHAR2(200) := '';
                    BEGIN
                
                        IF p_full_width THEN
                            l_style := ' style="grid-column: 1 / -1;"';
                        END IF;
                
                        RETURN
                            '<div class="ev-field"' ||
                                l_style || '>' ||
                
                                '<span class="ev-field-label">' ||
                                    apex_escape.html(p_label) ||
                                '</span>' ||
                
                                '<span class="ev-field-value" ' ||
                                    'style="white-space: pre-wrap;">' ||
                                    safe_text(p_value) ||
                                '</span>' ||
                
                            '</div>';
                
                    END;
                
                BEGIN
                
                    --------------------------------------------------
                    -- Check Permission Record
                    --------------------------------------------------
                    IF :P143_ENTITY_ID IS NULL THEN
                        RETURN
                            '<div class="employee-not-found">
                                No permission record selected.
                            </div>';
                    END IF;
                
                    --------------------------------------------------
                    -- Get Permission & Employee Information
                    --------------------------------------------------
                    BEGIN
                
                        SELECT
                            e.NAME,
                            TO_CHAR(e.EMPLOYEE_NUMBER),
                
                            pt.NAME,
                
                            TO_CHAR(
                                p."DATE",
                                'DD Mon YYYY',
                                'NLS_DATE_LANGUAGE=ENGLISH'
                            ),
                
                            TO_CHAR(
                                p.FROM_TIME,
                                'HH:MI AM',
                                'NLS_DATE_LANGUAGE=ENGLISH'
                            ),
                
                            TO_CHAR(
                                p.TO_TIME,
                                'HH:MI AM',
                                'NLS_DATE_LANGUAGE=ENGLISH'
                            ),
                
                            p.DESCRIPTION
                
                        INTO
                            l_employee_name,
                            l_employee_number,
                            l_permission_type,
                            l_permission_date,
                            l_from_time,
                            l_to_time,
                            l_description
                
                        FROM PERMISSION p
                
                        JOIN EMPLOYEE e
                            ON e.ID = p.EMPLOYEE_ID
                
                        LEFT JOIN PERMISSION_TYPE pt
                            ON pt.ID = p.TYPE_ID
                
                        WHERE p.ID = :P143_ENTITY_ID;
                
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            RETURN
                                '<div class="employee-not-found">
                                    Permission record not found.
                                </div>';
                    END;
                
                    --------------------------------------------------
                    -- Permission Header
                    --------------------------------------------------
                    l_html := q'~
                    <div class="ev-profile">
                
                        <div class="employee-card ev-header">
                
                            <div class="employee-icon">
                                <span class="fa fa-clock-o"
                                      aria-hidden="true"></span>
                            </div>
                
                            <div class="employee-details ev-identity">
                
                                <span class="employee-label">
                                    PERMISSION RECORD
                                </span>
                
                                <div class="employee-name">~' ||
                                    safe_text(l_employee_name) ||
                                q'~</div>
                
                                <div class="employee-number">
                                    <span class="fa fa-id-badge"
                                          aria-hidden="true"></span>
                                    Employee No.
                                    <strong>~' ||
                                        safe_text(l_employee_number) ||
                                    q'~</strong>
                                </div>
                
                            </div>
                
                            <span class="ev-status ev-neutral">
                                Permission #~' ||
                                    safe_text(:P143_ENTITY_ID) ||
                            q'~</span>
                
                        </div>
                
                        <!-- Permission Information -->
                        <section class="ev-panel">
                
                            <div class="ev-section-title">
                                <span class="fa fa-calendar"
                                      aria-hidden="true"></span>
                                <h3>Permission Information</h3>
                            </div>
                
                            <div class="ev-grid">
                    ~';
                
                    --------------------------------------------------
                    -- Permission Information Cards
                    --------------------------------------------------
                    l_html := l_html ||
                
                        info_card(
                            'Permission Type',
                            l_permission_type
                        ) ||
                
                        info_card(
                            'Permission Date',
                            l_permission_date
                        ) ||
                
                        info_card(
                            'From Time',
                            l_from_time
                        ) ||
                
                        info_card(
                            'To Time',
                            l_to_time
                        ) ||
                
                        info_card(
                            'Description',
                            l_description,
                            TRUE
                        );
                
                    l_html := l_html || q'~
                            </div>
                        </section>
                
                    </div>
                    ~';
                
                    RETURN l_html;
                
                END;
                
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
    )

    pageItem P143_DESCRIPTION (
        type: hidden
        layout {
            sequence: 14
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the permission description.
        }
    )

    pageItem P143_EMPLOYEE_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Select the employee for this permission.
        }
    )

    pageItem P143_ENTITY_ID (
        type: hidden
        layout {
            sequence: 1
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P143_EXPECTED_VERSION (
        type: hidden
        layout {
            sequence: 2
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
    )

    pageItem P143_FROM_TIME (
        type: hidden
        layout {
            sequence: 11
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Required start timestamp (YYYYMMDDHH24MI).
        }
    )

    pageItem P143_IDEMPOTENCY_KEY (
        type: hidden
        layout {
            sequence: 1
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P143_TO_TIME (
        type: hidden
        layout {
            sequence: 12
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Required end timestamp (YYYYMMDDHH24MI).
        }
    )

    pageItem P143_TYPE_ID (
        type: hidden
        layout {
            sequence: 13
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Select the permission type.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }
        config {
            buildOption: @commented-out
        }

        triggerAction cancel-dialog (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button delete (
        buttonName: DELETE
        label: Delete or Archive
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Confirm the package-backed delete/archive operation.
            style: danger
        }
        config {
            buildOption: @commented-out
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        config {
            buildOption: @commented-out
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Permission operation completed
        }
        advanced {
            executionMappingIdentifier: 78957117699959211
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,DELETE
        }
    )

    process delete-permission (
        name: Delete Permission Through Package
        type: executeCode
        source {
            plsqlCode: DECLARE l_status varchar2(30); l_message varchar2(4000); BEGIN EVENT_API_PKG.delete_event('PERMISSION', :P143_ENTITY_ID, l_status, l_message); IF l_status = 'REJECTED' THEN raise_application_error(-20001, l_message); END IF; END;
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 78956799673959211
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-permission-form (
        name: Initialize Permission Form
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    :P143_IDEMPOTENCY_KEY := nvl(:P143_IDEMPOTENCY_KEY, rawtohex(sys_guid()));
                    IF :P143_ENTITY_ID IS NOT NULL THEN
                        SELECT EMPLOYEE_ID, FROM_TIME, TO_TIME, TYPE_ID, DESCRIPTION, ORA_ROWSCN
                          INTO :P143_EMPLOYEE_ID, :P143_FROM_TIME, :P143_TO_TIME, :P143_TYPE_ID, :P143_DESCRIPTION, :P143_EXPECTED_VERSION
                          FROM PERMISSION WHERE ID = :P143_ENTITY_ID;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 78955917154959210
        }
    )

    process save-permission (
        name: Save Permission Through Package
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE l_id number; l_status varchar2(30); l_message varchar2(4000); BEGIN
                    EVENT_API_PKG.upsert_event('PERMISSION', :P143_ENTITY_ID, :P143_EMPLOYEE_ID, TO_DATE(
                    :P143_FROM_TIME,
                    'DD-MON-YYYY HH24:MI:SS',
                    'NLS_DATE_LANGUAGE=English'
                ),
                    TO_DATE(
                    :P143_TO_TIME,
                    'DD-MON-YYYY HH24:MI:SS',
                    'NLS_DATE_LANGUAGE=English'
                ), :P143_TYPE_ID, :P143_DESCRIPTION, :P143_EXPECTED_VERSION, :P143_IDEMPOTENCY_KEY, l_id, l_status, l_message);
                    IF l_status in ('REJECTED','CONFLICT') THEN raise_application_error(-20001, l_message); END IF;
                    :P143_ENTITY_ID := l_id;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 78956353571959211
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)
