page 20 (
    name: Departments
    alias: DEPARTMENTS
    title: Departments
    pageGroup: @company
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    css {
        fileUrls: #APP_FILES#style#MIN#.css
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Departments
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region departments (
        name: Departments_report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                d.ID, 
                d.NAME, 
                apex_page.get_url(p_page => 1130, p_items => 'P1130_ENTITY_ID', p_values => to_char(d.ID)) AS EDIT_URL ,
                'delete' as DELETE_BUTTON
                from DEPARTMENT d 
                order by d.NAME
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.CAN_READ_SQL('ReadEmployees') = 1
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No matching rows are available in your permitted scope.
            whenMoreDataFound: Apply filters to reduce the result set before exporting.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 47960582831343101
        }

        column DELETE_BUTTON (
            type: plainText
            heading {
                heading: "Delete "
            }
            layout {
                sequence: 40
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a 
                       class="ig-action-btn delete-btn"
                        data-id="#ID#"
                        href="#"
                        >
                        <span class="fa fa-trash"></span>
                        Delete
                    </a>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                htmlDomId: departments_report
                endUserAlias: F
            }
        )

        column EDIT_URL (
            type: plainText
            heading {
                heading: Actions
            }
            layout {
                sequence: 30
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    {! <a href="#EDIT_URL!ATTR#" class="t-Button t-Button--noLabel t-Button--icon t-Button--link" aria-label="Edit" title="Edit"><span class="fa fa-edit" aria-hidden="true"></span></a> /}
                    <a href="#EDIT_URL!ATTR#"
                       class="ig-action-btn"
                       title="View">
                       <span class="fa fa-edit"></span>
                       Edit
                    </a>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
            security {
                escapeSpecialChars: false
            }
        )

        column ID (
            type: plainText
            heading {
                heading: Id
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DELETE_BUTTON (
                sequence: 3
            )

            displayColumn EDIT_URL (
                sequence: 2
            )

            displayColumn NAME (
                sequence: 1
            )

        )

    )

    button create-departments (
        buttonName: CREATE_DEPARTMENTS
        label: Create Departments
        layout {
            sequence: 10
            region: @departments
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: ig-action-btn
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1130
                clearCache: 1130
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.HAS_ROLE('1') or AUTH_PKG.HAS_ROLE('2')
        }
    )

    dynamicAction new_1 (
        name: New
        execution {
            sequence: 30
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @departments
        }

        action native-refresh (
            action: refresh
            settings {
                maintainPagination: true
            }
            affectedElements {
                selectionType: region
                region: @departments
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new_2 (
        name: New
        execution {
            sequence: 40
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(document).on('click', '.delete-btn', function () {
                    
                        var id = $(this).data("id");
                        apex.message.confirm("Are you sure you want to proceed?", function (okPressed) {
                            if (okPressed) {
                    
                                apex.server.process(
                                    "DELETE_DEPARTMENT",
                                    {
                                        x01: id
                                    },
                                    {
                                        success: function () {
                    
                                            console.log('ya hamada');
                                            apex.region("departments_report").refresh();
                                        },
                                        error: function (pError) {
                                            console.error(pError);
                                        }
                                    }
                                );
                            }
                        });
                    
                    
                    
                    
                    });
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    process delete-department (
        name: DELETE_DEPARTMENT
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                l_type varchar2 := 'DEPARTMENT';
                BEGIN
                    DELETE_PKG.delete_department(
                        p_id => apex_application.g_x01
                    );
                    AUDIT_PKG.record_event('REFERENCE_DEPARTMENT_DELETE', l_type,  apex_application.g_x01, null);
                
                apex_json.open_object;
                apex_json.write('msg', 'ok') ;
                apex_json.close_object;
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 48784167706747804
        }
    )

)
