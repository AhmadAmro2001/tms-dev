page 1143 (
    name: Permission Form
    alias: PERMISSION-FORM
    title: Permission Form
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    css {
        fileUrls: #APP_FILES#style#MIN#.css
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region form-body (
        name: Permission Form
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1143_DESCRIPTION (
        type: textarea
        label {
            label: Description
            alignment: left
        }
        layout {
            sequence: 14
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the permission description.
        }
    )

    pageItem P1143_EMPLOYEE_ID (
        type: popupLov
        label {
            label: Employee
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @employee
        }
        layout {
            sequence: 10
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Select the employee for this permission.
        }
    )

    pageItem P1143_ENTITY_ID (
        type: hidden
        layout {
            sequence: 1
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1143_EXPECTED_VERSION (
        type: hidden
        layout {
            sequence: 2
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
    )

    pageItem P1143_FROM_TIME (
        type: datePicker
        label {
            label: From Time
            alignment: left
        }
        settings {
            showTime: true
        }
        layout {
            sequence: 11
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            formatMask: DD-MON-YYYY HH24:MI:SS
            width: 30
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Required start timestamp (YYYYMMDDHH24MI).
        }
    )

    pageItem P1143_IDEMPOTENCY_KEY (
        type: hidden
        layout {
            sequence: 1
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1143_TO_TIME (
        type: datePicker
        label {
            label: To Time
            alignment: left
        }
        settings {
            showTime: true
        }
        layout {
            sequence: 12
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            formatMask: DD-MON-YYYY HH24:MI:SS
            width: 30
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Required end timestamp (YYYYMMDDHH24MI).
        }
    )

    pageItem P1143_TYPE_ID (
        type: selectList
        label {
            label: Type
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery: select NAME as display_value, to_char(ID) as return_value from PERMISSION_TYPE order by 1
        }
        layout {
            sequence: 13
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Select the permission type.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }
        config {
            buildOption: @commented-out
        }

        triggerAction cancel-dialog (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button delete (
        buttonName: DELETE
        label: Delete or Archive
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Confirm the package-backed delete/archive operation.
            style: danger
        }
        config {
            buildOption: @commented-out
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: ig-action-btn
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Permission operation completed
        }
        advanced {
            executionMappingIdentifier: 48411373228317311
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,DELETE
        }
    )

    process delete-permission (
        name: Delete Permission Through Package
        type: executeCode
        source {
            plsqlCode: DECLARE l_status varchar2(30); l_message varchar2(4000); BEGIN EVENT_API_PKG.delete_event('PERMISSION', :P1143_ENTITY_ID, l_status, l_message); IF l_status = 'REJECTED' THEN raise_application_error(-20001, l_message); END IF; END;
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 48411214198317311
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-permission-form (
        name: Initialize Permission Form
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    :P1143_IDEMPOTENCY_KEY := nvl(:P1143_IDEMPOTENCY_KEY, rawtohex(sys_guid()));
                    IF :P1143_ENTITY_ID IS NOT NULL THEN
                        SELECT EMPLOYEE_ID, FROM_TIME, TO_TIME, TYPE_ID, DESCRIPTION, ORA_ROWSCN
                          INTO :P1143_EMPLOYEE_ID, :P1143_FROM_TIME, :P1143_TO_TIME, :P1143_TYPE_ID, :P1143_DESCRIPTION, :P1143_EXPECTED_VERSION
                          FROM PERMISSION WHERE ID = :P1143_ENTITY_ID;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 48411010260317311
        }
    )

    process save-permission (
        name: Save Permission Through Package
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE l_id number; l_status varchar2(30); l_message varchar2(4000); BEGIN
                    EVENT_API_PKG.upsert_event('PERMISSION', :P1143_ENTITY_ID, :P1143_EMPLOYEE_ID, TO_DATE(
                    :P1143_FROM_TIME,
                    'DD-MON-YYYY HH24:MI:SS',
                    'NLS_DATE_LANGUAGE=English'
                ),
                    TO_DATE(
                    :P1143_TO_TIME,
                    'DD-MON-YYYY HH24:MI:SS',
                    'NLS_DATE_LANGUAGE=English'
                ), :P1143_TYPE_ID, :P1143_DESCRIPTION, :P1143_EXPECTED_VERSION, :P1143_IDEMPOTENCY_KEY, l_id, l_status, l_message);
                    IF l_status in ('REJECTED','CONFLICT') THEN raise_application_error(-20001, l_message); END IF;
                    :P1143_ENTITY_ID := l_id;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 48411192410317311
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)
