page 1147 (
    name: Approved Overtime Form
    alias: APPROVED-OVERTIME-FORM
    title: Approved Overtime Form
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    css {
        fileUrls: #APP_FILES#style#MIN#.css
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region form-body (
        name: Approved Overtime Form
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1147_DESCRIPTION (
        type: textarea
        label {
            label: Description
            alignment: left
        }
        layout {
            sequence: 13
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the approved overtime description.
        }
    )

    pageItem P1147_EMPLOYEE_ID (
        type: popupLov
        label {
            label: Employee
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @employee
        }
        layout {
            sequence: 10
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Select the employee for this approved overtime.
        }
    )

    pageItem P1147_ENTITY_ID (
        type: hidden
        layout {
            sequence: 1
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1147_EXPECTED_VERSION (
        type: hidden
        layout {
            sequence: 2
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
    )

    pageItem P1147_FROM_TIME (
        type: datePicker
        label {
            label: From Time
            alignment: left
        }
        settings {
            showTime: true
        }
        layout {
            sequence: 11
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            formatMask: DD-MON-YYYY HH24:MI:SS
            width: 30
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Required start timestamp (YYYYMMDDHH24MI).
        }
    )

    pageItem P1147_IDEMPOTENCY_KEY (
        type: hidden
        layout {
            sequence: 1
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1147_TO_TIME (
        type: datePicker
        label {
            label: To Time
            alignment: left
        }
        settings {
            showTime: true
        }
        layout {
            sequence: 12
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            formatMask: DD-MON-YYYY HH24:MI:SS
            width: 30
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Required end timestamp (YYYYMMDDHH24MI).
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }
        config {
            buildOption: @commented-out
        }

        triggerAction cancel-dialog (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button delete (
        buttonName: DELETE
        label: Delete or Archive
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Confirm the package-backed delete/archive operation.
            style: danger
        }
        config {
            buildOption: @commented-out
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: ig-action-btn
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Approved Overtime operation completed
        }
        advanced {
            executionMappingIdentifier: 48417224475317369
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,DELETE
        }
    )

    process delete-approved-overtime (
        name: Delete Approved Overtime Through Package
        type: executeCode
        source {
            plsqlCode: DECLARE l_status varchar2(30); l_message varchar2(4000); BEGIN EVENT_API_PKG.delete_event('APPROVED_OVERTIME', :P1147_ENTITY_ID, l_status, l_message); IF l_status = 'REJECTED' THEN raise_application_error(-20001, l_message); END IF; END;
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 48417181424317369
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-approved-overtime-form (
        name: Initialize Approved Overtime Form
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    :P1147_IDEMPOTENCY_KEY := nvl(:P1147_IDEMPOTENCY_KEY, rawtohex(sys_guid()));
                    IF :P1147_ENTITY_ID IS NOT NULL THEN
                        SELECT EMPLOYEE_ID, FROM_TIME, TO_TIME, DESCRIPTION, ORA_ROWSCN
                          INTO :P1147_EMPLOYEE_ID, :P1147_FROM_TIME, :P1147_TO_TIME, :P1147_DESCRIPTION, :P1147_EXPECTED_VERSION
                          FROM APPROVED_OVERTIME WHERE ID = :P1147_ENTITY_ID;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 48416935330317369
        }
    )

    process save-approved-overtime (
        name: Save Approved Overtime Through Package
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- DECLARE l_id number; l_status varchar2(30); l_message varchar2(4000); BEGIN
                --     EVENT_API_PKG.upsert_event('APPROVED_OVERTIME', :P1147_ENTITY_ID, :P1147_EMPLOYEE_ID, :P1147_FROM_TIME, :P1147_TO_TIME, null, :P1147_DESCRIPTION, :P1147_EXPECTED_VERSION, :P1147_IDEMPOTENCY_KEY, l_id, l_status, l_message);
                --     IF l_status in ('REJECTED','CONFLICT') THEN raise_application_error(-20001, l_message); END IF;
                --     :P1147_ENTITY_ID := l_id;
                -- END;
                
                DECLARE
                    l_id          NUMBER;
                    l_status      VARCHAR2(30);
                    l_message     VARCHAR2(4000);
                
                    l_from_time   TIMESTAMP;
                    l_to_time     TIMESTAMP;
                
                BEGIN
                
                    --------------------------------------------------
                    -- Convert APEX Text to TIMESTAMP
                    --------------------------------------------------
                    IF :P1147_FROM_TIME IS NOT NULL THEN
                
                        l_from_time := TO_TIMESTAMP(
                            :P1147_FROM_TIME,
                            'DD-MON-YYYY HH24:MI:SS',
                            'NLS_DATE_LANGUAGE=ENGLISH'
                        );
                
                        -- Convert Egypt local time to UTC
                        l_from_time := CAST(
                            FROM_TZ(
                                l_from_time,
                                'Africa/Cairo'
                            ) AT TIME ZONE 'UTC'
                            AS TIMESTAMP
                        );
                
                    END IF;
                
                    IF :P1147_TO_TIME IS NOT NULL THEN
                
                        l_to_time := TO_TIMESTAMP(
                            :P1147_TO_TIME,
                            'DD-MON-YYYY HH24:MI:SS',
                            'NLS_DATE_LANGUAGE=ENGLISH'
                        );
                
                        -- Convert Egypt local time to UTC
                        l_to_time := CAST(
                            FROM_TZ(
                                l_to_time,
                                'Africa/Cairo'
                            ) AT TIME ZONE 'UTC'
                            AS TIMESTAMP
                        );
                
                    END IF;
                
                    --------------------------------------------------
                    -- Call Existing Package
                    --------------------------------------------------
                    EVENT_API_PKG.upsert_event(
                        'APPROVED_OVERTIME',
                        :P1147_ENTITY_ID,
                        :P1147_EMPLOYEE_ID,
                        l_from_time,
                        l_to_time,
                        NULL,
                        :P1147_DESCRIPTION,
                        :P1147_EXPECTED_VERSION,
                        :P1147_IDEMPOTENCY_KEY,
                        l_id,
                        l_status,
                        l_message
                    );
                
                    --------------------------------------------------
                    -- Handle Errors
                    --------------------------------------------------
                    IF l_status IN ('REJECTED', 'CONFLICT') THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            l_message
                        );
                    END IF;
                
                    --------------------------------------------------
                    -- Update Entity ID
                    --------------------------------------------------
                    :P1147_ENTITY_ID := l_id;
                
                END;
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 48417009520317369
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)
