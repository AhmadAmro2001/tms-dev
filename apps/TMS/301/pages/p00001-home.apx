page 1 (
    name: Home
    alias: HOME
    title: Home
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region app-name (
        name: Home
        title: &APP_TITLE.
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

    region breadcrumb (
        name: Home
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region dashboard-summary (
        name: Dashboard Summary
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ACTIVE_EMPLOYEES, DEVICES, TRANSACTIONS, UNMATCHED_PUNCHES
                  from V_DASHBOARD_SUMMARY
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        security {
            authorizationScheme: @tms-authenticated
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--horizontalBorders
            ]
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: Dashboard summary is not available for your permitted scope.
        }

        column ACTIVE_EMPLOYEES (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Active Employees
            }
            layout {
                sequence: 10
            }
        )

        column DEVICES (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Devices
            }
            layout {
                sequence: 20
            }
        )

        column TRANSACTIONS (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Transactions
            }
            layout {
                sequence: 30
            }
        )

        column UNMATCHED_PUNCHES (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Unmatched Punches
            }
            layout {
                sequence: 40
            }
        )

    )

)
