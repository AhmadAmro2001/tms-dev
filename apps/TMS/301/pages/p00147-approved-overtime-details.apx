page 147 (
    name: Approved Overtime Details
    alias: APPROVED-OVERTIME-DETAILS
    title: Approved Overtime Details
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    css {
        fileUrls: #APP_FILES#style#MIN#.css
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        config {
            buildOption: @commented-out
        }
    )

    region form-body (
        name: Approved Overtime Form
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region overtime-details (
        name: Overtime Details
        type: dynamicContent
        source {
            plsqlFunctionBody:
                ```plsql
                
                DECLARE
                    l_html              CLOB;
                
                    -- Employee Information
                    l_employee_name     EMPLOYEE.NAME%TYPE;
                    l_employee_number   VARCHAR2(100);
                
                    -- Overtime Information
                    l_from_time         VARCHAR2(100);
                    l_to_time           VARCHAR2(100);
                    l_description       APPROVED_OVERTIME.DESCRIPTION%TYPE;
                    l_duration_minutes  NUMBER;
                    l_duration_text     VARCHAR2(100);
                
                    --------------------------------------------------
                    -- Escape HTML
                    --------------------------------------------------
                    FUNCTION safe_text(
                        p_value IN VARCHAR2
                    ) RETURN VARCHAR2
                    IS
                    BEGIN
                        RETURN apex_escape.html(
                            NVL(TRIM(p_value), 'Not provided')
                        );
                    END;
                
                    --------------------------------------------------
                    -- Reusable Information Card
                    --------------------------------------------------
                    FUNCTION info_card(
                        p_label      IN VARCHAR2,
                        p_value      IN VARCHAR2,
                        p_full_width IN BOOLEAN DEFAULT FALSE
                    ) RETURN VARCHAR2
                    IS
                        l_style VARCHAR2(200) := '';
                    BEGIN
                
                        IF p_full_width THEN
                            l_style := ' style="grid-column: 1 / -1;"';
                        END IF;
                
                        RETURN
                            '<div class="ev-field"' ||
                                l_style || '>' ||
                
                                '<span class="ev-field-label">' ||
                                    apex_escape.html(p_label) ||
                                '</span>' ||
                
                                '<span class="ev-field-value" ' ||
                                    'style="white-space: pre-wrap;">' ||
                                    safe_text(p_value) ||
                                '</span>' ||
                
                            '</div>';
                
                    END;
                
                BEGIN
                
                    --------------------------------------------------
                    -- Check Overtime Record
                    --------------------------------------------------
                    IF :P147_ENTITY_ID IS NULL THEN
                        RETURN
                            '<div class="employee-not-found">
                                No overtime record selected.
                            </div>';
                    END IF;
                
                    --------------------------------------------------
                    -- Get Overtime & Employee Information
                    --------------------------------------------------
                    BEGIN
                
                        SELECT
                            e.NAME,
                            TO_CHAR(e.EMPLOYEE_NUMBER),
                
                            TO_CHAR(
                                a.FROM_TIME,
                                'DD Mon YYYY, HH:MI AM',
                                'NLS_DATE_LANGUAGE=ENGLISH'
                            ),
                
                            TO_CHAR(
                                a.TO_TIME,
                                'DD Mon YYYY, HH:MI AM',
                                'NLS_DATE_LANGUAGE=ENGLISH'
                            ),
                
                            a.DESCRIPTION,
                
                            CASE
                                WHEN a.FROM_TIME IS NOT NULL
                                 AND a.TO_TIME IS NOT NULL
                                 AND a.TO_TIME >= a.FROM_TIME
                                THEN
                                    ROUND(
                                        (
                                            CAST(a.TO_TIME AS DATE)
                                            -
                                            CAST(a.FROM_TIME AS DATE)
                                        ) * 24 * 60
                                    )
                                ELSE
                                    NULL
                            END
                
                        INTO
                            l_employee_name,
                            l_employee_number,
                            l_from_time,
                            l_to_time,
                            l_description,
                            l_duration_minutes
                
                        FROM APPROVED_OVERTIME a
                
                        LEFT JOIN EMPLOYEE e
                            ON e.ID = a.EMPLOYEE_ID
                
                        WHERE a.ID = :P147_ENTITY_ID;
                
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            RETURN
                                '<div class="employee-not-found">
                                    Overtime record not found.
                                </div>';
                    END;
                
                    --------------------------------------------------
                    -- Format Overtime Duration
                    --------------------------------------------------
                    IF l_duration_minutes IS NOT NULL THEN
                
                        l_duration_text :=
                            TRUNC(l_duration_minutes / 60) || ' hr';
                
                        IF MOD(l_duration_minutes, 60) > 0 THEN
                
                            l_duration_text :=
                                l_duration_text || ' ' ||
                                MOD(l_duration_minutes, 60) || ' min';
                
                        END IF;
                
                    ELSE
                        l_duration_text := 'Not provided';
                    END IF;
                
                    --------------------------------------------------
                    -- Overtime Header
                    --------------------------------------------------
                    l_html := q'~
                    <div class="ev-profile">
                
                        <div class="employee-card ev-header">
                
                            <div class="employee-icon">
                                <span class="fa fa-clock-o"
                                      aria-hidden="true"></span>
                            </div>
                
                            <div class="employee-details ev-identity">
                
                                <span class="employee-label">
                                    APPROVED OVERTIME RECORD
                                </span>
                
                                <div class="employee-name">~' ||
                                    safe_text(l_employee_name) ||
                                q'~</div>
                
                                <div class="employee-number">
                                    <span class="fa fa-id-badge"
                                          aria-hidden="true"></span>
                                    Employee No.
                                    <strong>~' ||
                                        safe_text(l_employee_number) ||
                                    q'~</strong>
                                </div>
                
                            </div>
                
                            <span class="ev-status ev-neutral">
                                Overtime #~' ||
                                    safe_text(:P147_ENTITY_ID) ||
                            q'~</span>
                
                        </div>
                
                        <!-- Overtime Information -->
                        <section class="ev-panel">
                
                            <div class="ev-section-title">
                                <span class="fa fa-clock-o"
                                      aria-hidden="true"></span>
                                <h3>Overtime Information</h3>
                            </div>
                
                            <div class="ev-grid">
                    ~';
                
                    --------------------------------------------------
                    -- Overtime Information Cards
                    --------------------------------------------------
                    l_html := l_html ||
                
                        info_card(
                            'From Time',
                            l_from_time
                        ) ||
                
                        info_card(
                            'To Time',
                            l_to_time
                        ) ||
                
                        info_card(
                            'Overtime Duration',
                            l_duration_text
                        ) ||
                
                        info_card(
                            'Description',
                            l_description,
                            TRUE
                        );
                
                    l_html := l_html || q'~
                            </div>
                        </section>
                
                    </div>
                    ~';
                
                    RETURN l_html;
                
                END;
                
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
                t-Region--removeHeader js-removeLandmark
                t-Region--noBorder
                t-Region--scrollBody
            ]
        }
    )

    pageItem P147_DESCRIPTION (
        type: hidden
        layout {
            sequence: 13
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the approved overtime description.
        }
    )

    pageItem P147_EMPLOYEE_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Select the employee for this approved overtime.
        }
    )

    pageItem P147_ENTITY_ID (
        type: hidden
        layout {
            sequence: 1
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P147_EXPECTED_VERSION (
        type: hidden
        layout {
            sequence: 2
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
    )

    pageItem P147_FROM_TIME (
        type: hidden
        layout {
            sequence: 11
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Required start timestamp (YYYYMMDDHH24MI).
        }
    )

    pageItem P147_IDEMPOTENCY_KEY (
        type: hidden
        layout {
            sequence: 1
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P147_TO_TIME (
        type: hidden
        layout {
            sequence: 12
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Required end timestamp (YYYYMMDDHH24MI).
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction cancel-dialog (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button delete (
        buttonName: DELETE
        label: Delete or Archive
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Confirm the package-backed delete/archive operation.
            style: danger
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Approved Overtime operation completed
        }
        advanced {
            executionMappingIdentifier: 78985641777690212
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,DELETE
        }
    )

    process delete-approved-overtime (
        name: Delete Approved Overtime Through Package
        type: executeCode
        source {
            plsqlCode: DECLARE l_status varchar2(30); l_message varchar2(4000); BEGIN EVENT_API_PKG.delete_event('APPROVED_OVERTIME', :P147_ENTITY_ID, l_status, l_message); IF l_status = 'REJECTED' THEN raise_application_error(-20001, l_message); END IF; END;
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 78985224505690211
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-approved-overtime-form (
        name: Initialize Approved Overtime Form
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    :P147_IDEMPOTENCY_KEY := nvl(:P147_IDEMPOTENCY_KEY, rawtohex(sys_guid()));
                    IF :P147_ENTITY_ID IS NOT NULL THEN
                        SELECT EMPLOYEE_ID, FROM_TIME, TO_TIME, DESCRIPTION, ORA_ROWSCN
                          INTO :P147_EMPLOYEE_ID, :P147_FROM_TIME, :P147_TO_TIME, :P147_DESCRIPTION, :P147_EXPECTED_VERSION
                          FROM APPROVED_OVERTIME WHERE ID = :P147_ENTITY_ID;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 78984417724690210
        }
    )

    process save-approved-overtime (
        name: Save Approved Overtime Through Package
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE l_id number; l_status varchar2(30); l_message varchar2(4000); BEGIN
                    EVENT_API_PKG.upsert_event('APPROVED_OVERTIME', :P147_ENTITY_ID, :P147_EMPLOYEE_ID, :P147_FROM_TIME, :P147_TO_TIME, null, :P147_DESCRIPTION, :P147_EXPECTED_VERSION, :P147_IDEMPOTENCY_KEY, l_id, l_status, l_message);
                    IF l_status in ('REJECTED','CONFLICT') THEN raise_application_error(-20001, l_message); END IF;
                    :P147_ENTITY_ID := l_id;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 78984880209690211
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)
