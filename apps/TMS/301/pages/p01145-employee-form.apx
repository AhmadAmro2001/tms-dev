    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }
        config {
            buildOption: @commented-out
        }

        triggerAction cancel-dialog (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button delete (
        buttonName: DELETE
        label: Delete or Archive
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Confirm the package-backed delete/archive operation.
            style: danger
        }
        config {
            buildOption: @commented-out
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: ig-action-btn
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Employee operation completed
        }
        advanced {
            executionMappingIdentifier: 48346863463205522
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,DELETE
        }
    )

    process delete-employee (
        name: Delete Employee Through Package
        type: executeCode
        source {
            plsqlCode: DECLARE l_status varchar2(30); l_message varchar2(4000); BEGIN REFERENCE_API_PKG.delete_reference('EMPLOYEE', :P1145_ENTITY_ID, l_status, l_message); IF l_status = 'REJECTED' THEN raise_application_error(-20001, l_message); END IF; END;
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 48346746355205522
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-employee-form (
        name: Initialize Employee Form
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    :P1145_IDEMPOTENCY_KEY := nvl(:P1145_IDEMPOTENCY_KEY, rawtohex(sys_guid()));
                    IF :P1145_ENTITY_ID IS NOT NULL THEN
                        SELECT NAME, EMPLOYEE_NUMBER, PROJECT_ID, LOCATION_ID, DEPARTMENT_ID, GRADE_ID, IS_ACTIVE, NATIONALITY, RELIGION, PRINT_TIMESHEET, ORA_ROWSCN
                          INTO :P1145_NAME, :P1145_EMPLOYEE_NUMBER, :P1145_PROJECT_ID, :P1145_LOCATION_ID, :P1145_DEPARTMENT_ID, :P1145_GRADE_ID, :P1145_IS_ACTIVE, :P1145_NATIONALITY, :P1145_RELIGION, :P1145_PRINT_TIMESHEET, :P1145_EXPECTED_VERSION
                          FROM EMPLOYEE WHERE ID = :P1145_ENTITY_ID;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 48346590486205522
        }
    )

    process save-employee (
        name: Save Employee Through Package
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE l_id number; l_status varchar2(30); l_message varchar2(4000); BEGIN
                    REFERENCE_API_PKG.upsert_reference('EMPLOYEE', :P1145_ENTITY_ID, :P1145_NAME, :P1145_EMPLOYEE_NUMBER, :P1145_PROJECT_ID, :P1145_LOCATION_ID, :P1145_DEPARTMENT_ID, :P1145_GRADE_ID, :P1145_IS_ACTIVE, :P1145_NATIONALITY, :P1145_RELIGION, :P1145_PRINT_TIMESHEET, :P1145_EXPECTED_VERSION, :P1145_IDEMPOTENCY_KEY, l_id, l_status, l_message);
                    IF l_status in ('REJECTED','CONFLICT') THEN raise_application_error(-20001, l_message); END IF;
                    :P1145_ENTITY_ID := l_id;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 48346688373205522
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)
