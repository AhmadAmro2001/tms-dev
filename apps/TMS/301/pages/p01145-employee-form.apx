        lov {
            type: staticValues
            staticValues: STATIC:Muslim;Muslim,Christian;Christian
            displayNullValue: false
        }
        layout {
            sequence: 18
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
