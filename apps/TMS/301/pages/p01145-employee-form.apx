page 1145 (
    name: Employee Form
    alias: EMPLOYEE-FORM
    title: Employee Form
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    css {
        fileUrls: #APP_FILES#style#MIN#.css
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region form-body (
        name: Employee Form
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1145_DEPARTMENT_ID (
        type: selectList
        label {
            label: Department
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @department
            nullDisplayValue: - Select Department -
        }
        layout {
            sequence: 14
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Select the Department for this record.
        }
    )

    pageItem P1145_EMPLOYEE_NUMBER (
        type: textField
        label {
            label: Employee Number
            alignment: left
        }
        layout {
            sequence: 11
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the valid Employee Number for this record.
        }
    )

    pageItem P1145_ENTITY_ID (
        type: hidden
        layout {
            sequence: 1
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1145_EXPECTED_VERSION (
        type: hidden
        layout {
            sequence: 2
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
    )

