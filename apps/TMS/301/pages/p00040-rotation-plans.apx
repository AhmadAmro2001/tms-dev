page 40 (
    name: Rotation Plans
    alias: ROTATION-PLANS
    title: Rotation Plans
    pageGroup: @time-management
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    css {
        fileUrls: #APP_FILES#style#MIN#.css
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Rotation Plans
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region rotation-days (
        name: Rotation Days
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rd.ID, rp.NAME AS ROTATION_NAME, s.NAME AS SHIFT_NAME, rd.DAY,
                       apex_page.get_url(p_page => 1136,
                                         p_items => 'P1136_ENTITY_ID',
                                         p_values => to_char(rd.ID)) AS EDIT_URL
                  from ROTATION_DAY rd
                  join ROTATION_PLAN rp on rp.ID = rd.ROTATION_ID
                  join SHIFT s on s.ID = rd.SHIFT_ID
                 order by rp.NAME, rd.DAY
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.CAN_READ_SQL('ReadTimesheet') = 1
        }
        config {
            buildOption: @commented-out
        }
        performance {
            maxRowsToProcess: 1000
        }
        advanced {
            savedReportMappingIdentifier: 47975657258343183
        }

        column DAY (
            type: plainText
            heading {
                heading: Day
            }
            layout {
                sequence: 4
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column EDIT_URL (
            type: plainText
            heading {
                heading: Actions
            }
            layout {
                sequence: 5
            }
            columnFormatting {
                htmlExpression: <a href="#EDIT_URL!ATTR#" class="t-Button t-Button--noLabel t-Button--icon t-Button--link" aria-label="Edit" title="Edit"><span class="fa fa-edit" aria-hidden="true"></span></a>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
            security {
                escapeSpecialChars: false
            }
        )

        column ID (
            type: plainText
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column ROTATION_NAME (
            type: plainText
            heading {
                heading: Rotation Name
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column SHIFT_NAME (
            type: plainText
            heading {
                heading: Shift Name
            }
            layout {
                sequence: 3
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DAY (
                sequence: 4
            )

            displayColumn EDIT_URL (
                sequence: 5
            )

            displayColumn ID (
                sequence: 1
            )

            displayColumn ROTATION_NAME (
                sequence: 2
            )

            displayColumn SHIFT_NAME (
                sequence: 3
            )

        )

    )

    region rotation-history (
        name: Rotation History
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: select h.ID, e.EMPLOYEE_NUMBER, e.NAME AS EMPLOYEE_NAME, rp.NAME AS ROTATION_NAME, h.STARTED, apex_page.get_url(p_page => 1137, p_items => 'P1137_ENTITY_ID', p_values => to_char(h.ID)) AS EDIT_URL from ROTATION_HISTORY h join EMPLOYEE e on e.ID=h.EMPLOYEE_ID join ROTATION_PLAN rp on rp.ID=h.ROTATION_ID where e.LOCATION_ID in (select to_number(column_value) from table(apex_string.split(:APP_USER_LOCATION_IDS, ':'))) order by h.STARTED desc
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.CAN_READ_SQL('ReadTimesheet') = 1
        }
        config {
            buildOption: @commented-out
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No matching rows are available in your permitted scope.
            whenMoreDataFound: Apply filters to reduce the result set before exporting.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 47974885114343182
        }

        column EDIT_URL (
            type: plainText
            heading {
                heading: Actions
            }
            layout {
                sequence: 6
            }
