    region rotation-plans (
        name: Rotation Plans data
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select rp.ID, rp.NAME, rp.DAYS, rp.START_DATE, rp.IS_VISIBLE, rp.WORK_TYPE, apex_page.get_url(p_page => 1135, p_items => 'P1135_ENTITY_ID', p_values => to_char(rp.ID)) AS EDIT_URL,
                apex_page.get_url(p_page => 1151, p_items => 'P1151_ENTITY_ID', p_values => to_char(rp.ID)) AS VIEW_URL ,
                apex_page.get_url(p_page => 30, p_items => 'P30_ROTATION', p_values => rp.ID) AS ASSIGN_URL ,
                'Delete' as DELETE_BUTTON
                from ROTATION_PLAN rp 
                where (:P40_VISIBLE is null or rp.IS_VISIBLE = :P40_VISIBLE)
                order by rp.id asc
                ```
            pageItemsToSubmit: P40_VISIBLE
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: rotation_plan
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.CAN_READ_SQL('ReadTimesheet') = 1
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
