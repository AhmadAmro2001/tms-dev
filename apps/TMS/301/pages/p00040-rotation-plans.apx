            startNewRow: false
            column: 2
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--gapLeft
            ]
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1137
                clearCache: 1137
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.HAS_ROLE('1') or AUTH_PKG.HAS_ROLE('2')
        }
        config {
            buildOption: @commented-out
        }
    )

    button create-rotation-plans (
        buttonName: CREATE_ROTATION_PLANS
        label: Create Rotation Plans
        layout {
            sequence: 10
            region: @rotation-plans
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: ig-action-btn
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1135
                clearCache: 1135
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.HAS_ROLE('1') or AUTH_PKG.HAS_ROLE('2')
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 50
        }
        when {
            selectionType: items
            items: P40_VISIBLE
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @rotation-plans
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction new_1 (
        name: New
        execution {
            sequence: 60
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(document).on('click', '.delete-btn', function () {
                    
                        var id = $(this).data("id");
                        apex.message.confirm("Are you sure you want to proceed?", function (okPressed) {
                            if (okPressed) {
                    
                                apex.server.process(
                                    "DELETE_PLAN",
                                    {
                                        x01: id
                                    },
                                    {
                                        success: function () {
                    
                                            // console.log('ya hamada');
                                            apex.region("rotation_plan").refresh();
                                        },
                                        error: function (pError) {
                                            console.error(pError);
                                        }
                                    }
                                );
                            }
                        });
                    
                    
                    
                    
                    });
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refresh-rotation-days-after-dialog (
        name: Refresh rotation days after dialog close
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @rotation-days
        }

        action refresh-report (
            action: refresh
            affectedElements {
                selectionType: region
                region: @rotation-days
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-rotation-history-after-dialog (
        name: Refresh after dialog close
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @rotation-history
        }

        action refresh-report (
            action: refresh
            affectedElements {
                selectionType: region
                region: @rotation-history
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction refresh-rotation-plans-after-dialog (
        name: Refresh after dialog close
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @rotation-plans
        }

        action refresh-report (
            action: refresh
            affectedElements {
                selectionType: region
                region: @rotation-plans
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process delete-plan (
        name: DELETE_PLAN
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_status   VARCHAR2(30);
                    l_message  VARCHAR2(4000);
                    l_type varchar2 := 'PLAN';
                BEGIN
                    DELETE_PKG.delete_plan(
                        p_id => apex_application.g_x01
                    );
                
                    AUDIT_PKG.record_event('REFERENCE_PLAN_DELETE', l_type,  apex_application.g_x01, null);
                
                    IF l_status = 'REJECTED' THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            l_message
                        );
                    END IF;
                
                
                
                    apex_json.open_object;
                    apex_json.write('msg', 'ok') ;
                    apex_json.close_object;
                END;
                
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 78267584639676826
        }
    )

)
