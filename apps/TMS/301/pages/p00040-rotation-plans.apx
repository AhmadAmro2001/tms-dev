    pageItem P40_VISIBLE (
        type: selectList
        label {
            label: Visible
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC:Visible;1,Hidden;0
            nullDisplayValue: --All--
        }
        layout {
            sequence: 20
            slot: body
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    button create-rotation-day (
        buttonName: CREATE_ROTATION_DAY
        label: Create Rotation Day
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1136
                clearCache: 1136
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.HAS_ROLE('1') or AUTH_PKG.HAS_ROLE('2')
        }
        config {
            buildOption: @commented-out
        }
    )

