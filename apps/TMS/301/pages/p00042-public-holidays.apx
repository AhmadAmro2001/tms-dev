page 42 (
    name: Public Holidays
    alias: PUBLIC-HOLIDAYS
    title: Public Holidays
    pageGroup: @time-management
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    css {
        fileUrls: #APP_FILES#style#MIN#.css
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Public Holidays
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region public-holidays (
        name: Public Holidays report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                    h.ID, 
                    h.NAME, 
                    h.FROM_DATE, 
                    h.TO_DATE, 
                    h.TARGET_NATIONALITY, 
                    h.TARGET_RELIGION, 
                    h.WORK_TYPE, 
                    apex_page.get_url(p_page => 1139, p_items => 'P1139_ENTITY_ID', p_values => to_char(h.ID)) AS EDIT_URL ,
                    'Delete' as DELETE_BUTTON
                    from OFFICIAL_HOLIDAY h 
                    where h.TO_DATE < SYSDATE
                    order by h.FROM_DATE desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: public_holiday_report
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.CAN_READ_SQL('ReadTimesheet') = 1
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No matching rows are available in your permitted scope.
            whenMoreDataFound: Apply filters to reduce the result set before exporting.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 47979656517343224
        }

        column DELETE_BUTTON (
            type: plainText
            heading {
                heading: Delete
            }
            layout {
                sequence: 48
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a 
                       class="ig-action-btn delete-btn"
                        data-id="#ID#"
                        href="#"
                        >
                        <span class="fa fa-trash"></span>
                        Delete
                    </a>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: L
            }
        )

        column EDIT_URL (
            type: plainText
            heading {
                heading: Edit
            }
            layout {
                sequence: 8
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression: <a href="#EDIT_URL!ATTR#" class="ig-action-btn" aria-label="Edit" title="Edit"><span class="fa fa-edit" aria-hidden="true"></span> Edit</a>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
            security {
                escapeSpecialChars: false
            }
        )

        column FROM_DATE (
            type: plainText
            heading {
                heading: From
            }
            layout {
                sequence: 28
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: J
            }
        )

        column ID (
            type: plainText
            heading {
                heading: Id
                alignment: end
            }
            layout {
                sequence: 18
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        column NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column TARGET_NATIONALITY (
            type: plainText
            heading {
                heading: Target Nationality
            }
            layout {
                sequence: 5
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column TARGET_RELIGION (
            type: plainText
            heading {
                heading: Target Religion
            }
            layout {
                sequence: 6
                columnAlignment: center
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column TO_DATE (
            type: plainText
            heading {
                heading: To
            }
            layout {
                sequence: 38
                columnAlignment: center
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: K
            }
        )

        column WORK_TYPE (
            type: plainText
            heading {
                heading: WORK TYPE
            }
            layout {
                sequence: 7
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DELETE_BUTTON (
                sequence: 7
            )

            displayColumn EDIT_URL (
                sequence: 6
            )

            displayColumn FROM_DATE (
                sequence: 2
            )

            displayColumn NAME (
                sequence: 1
            )

            displayColumn TARGET_NATIONALITY (
                sequence: 4
            )

            displayColumn TARGET_RELIGION (
                sequence: 5
            )

            displayColumn TO_DATE (
                sequence: 3
            )

        )

    )

    button create-public-holidays (
        buttonName: CREATE_PUBLIC_HOLIDAYS
        label: Create Public Holidays
        layout {
            sequence: 10
            region: @public-holidays
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: ig-action-btn
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1139
                clearCache: 1139
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.HAS_ROLE('1') or AUTH_PKG.HAS_ROLE('2')
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(document).on('click', '.delete-btn', function () {
                    
                        var id = $(this).data("id");
                        apex.message.confirm("Are you sure you want to proceed?", function (okPressed) {
                            if (okPressed) {
                    
                                apex.server.process(
                                    "DELETE_PUBLIC_HOLIDAYS",
                                    {
                                        x01: id
                                    },
                                    {
                                        success: function () {
                    
                                            // console.log('ya hamada');
                                            apex.region("public_holiday_report").refresh();
                                        },
                                        error: function (pError) {
                                            console.error(pError);
                                        }
                                    }
                                );
                            }
                        });
                    
                    
                    
                    
                    });
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refresh-public-holidays-after-dialog (
        name: Refresh after dialog close
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @public-holidays
        }

        action refresh-report (
            action: refresh
            affectedElements {
                selectionType: region
                region: @public-holidays
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process delete-public-holidays (
        name: DELETE_PUBLIC_HOLIDAYS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    DELETE_PKG.delete_public_holiday(
                        p_id => apex_application.g_x01
                    );
                
                apex_json.open_object;
                apex_json.write('msg', 'ok') ;
                apex_json.close_object;
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 52043545962664618
        }
    )

)
