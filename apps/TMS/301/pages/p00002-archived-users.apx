    dynamicAction refresh-users-after-dialog (
        name: Refresh after dialog close
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @users
        }

        action refresh-report (
            action: refresh
            affectedElements {
                selectionType: region
                region: @users
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process archive-user (
        name: ARCHIVE_USER
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                
                v_is_archive_flag number;
                
                BEGIN
                
                    select IS_ARCHIVED into v_is_archive_flag from USER_ACCOUNT where id = apex_application.g_x01;
                
                    if v_is_archive_flag = 0 then 
                
                    UPDATE USER_ACCOUNT
                    SET IS_ARCHIVED = 1
                    WHERE ID = apex_application.g_x01;
                    else
                        UPDATE USER_ACCOUNT
                    SET IS_ARCHIVED = 0
                    WHERE ID = apex_application.g_x01;
                    end if;
                
                    COMMIT;
                
                     apex_json.open_object;
                    apex_json.write('success', true);
                    apex_json.close_object;
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 54452959287682840
        }
    )

)
