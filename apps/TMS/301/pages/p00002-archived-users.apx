page 2 (
    name: Archived Users
    alias: ARCHIVED-USERS
    title: Archived Users
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            function archiveUser(userAccountId) {
            
                if (!confirm('Are you sure you want to archive this user?')) {
                    return;
                }
            
                apex.server.process(
                    "ARCHIVE_USER",
                    {
                        x01: userAccountId
                    },
                    {
                        success: function () {
            
                            apex.message.showPageSuccess(
                                "User archived successfully."
                            );
            
                            apex.region("APP_USERS_REPORT").refresh();
                        },
            
                        error: function (jqXHR, textStatus, errorThrown) {
            
                            apex.message.alert(
                                "Error archiving user: " + errorThrown
                            );
            
                        }
                    }
                );
            }
            ```
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region users (
        name: Users
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select au.ID, au.APEX_USERNAME, ro.name as role_name, au.ENABLED, CASE
                        WHEN au.IS_ALLOWED_TO_PRINT_TIMESHEET = 'Y' THEN 'Yes'
                        WHEN au.IS_ALLOWED_TO_PRINT_TIMESHEET = 'N' THEN 'No'
                        ELSE NULL
                    END AS IS_ALLOWED_TO_PRINT_TIMESHEET, au.IS_LIMITED_TIMESHEET_ACCESS, listagg(l.NAME, ', ') within group (order by l.NAME) AS LOCATION_NAMES, au.CREATED_AT, apex_page.get_url(p_page => 1124, p_items => 'P1124_APP_USER_ID', p_values => to_char(au.ID)) AS EDIT_URL,
                       '<button type="button"
                        class="t-Button t-Button--small"
                        onclick="archiveUser(' || uacc.ID || ')">
                       Archive
                    </button>' AS ARCHIVE_BTN,
                
                    '<button type="button"
                        class="t-Button t-Button--small"
                        onclick="updatePrintAccess(' || au.ID || ', ''N'')">
                        Print Permission
                    </button>' AS PRINT_PERMISSION
                
                     from APP_USER au join APP_USER_ROLE ur on ur.APP_USER_ID=au.ID
                  join APP_ROLE r on r.ID=ur.APP_ROLE_ID
                  join role ro on ro.id = ur.APP_ROLE_ID
                   left join APP_USER_LOCATION ul on ul.APP_USER_ID=au.ID
                    left join LOCATION l on l.ID=ul.LOCATION_ID 
                    join user_account uacc on uacc.id = au.LEGACY_USER_ID
                    where uacc.IS_ARCHIVED = 1
                    group by au.ID, au.APEX_USERNAME, ro.name , au.ENABLED, au.IS_ALLOWED_TO_PRINT_TIMESHEET, au.IS_LIMITED_TIMESHEET_ACCESS, au.CREATED_AT , uacc.ID
                    order by au.APEX_USERNAME
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: APP_USERS_REPORT
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.HAS_ROLE('1') or AUTH_PKG.HAS_ROLE('2')
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No matching rows are available in your permitted scope.
            whenMoreDataFound: Apply filters to reduce the result set before exporting.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 102435976567026073
        }

