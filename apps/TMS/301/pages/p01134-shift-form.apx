page 1134 (
    name: Shift Form
    alias: SHIFT-FORM
    title: Shift Form
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region form-body (
        name: Shift Form
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1134_DURATION (
        type: textField
        label {
            label: Duration
            alignment: left
        }
        layout {
            sequence: 12
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the shift duration, in hours.
        }
    )

    pageItem P1134_ENTITY_ID (
        type: hidden
        layout {
            sequence: 1
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1134_EXPECTED_VERSION (
        type: hidden
        layout {
            sequence: 2
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
    )

    pageItem P1134_IDEMPOTENCY_KEY (
        type: hidden
        layout {
            sequence: 1
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1134_IS_OFF (
        type: textField
        label {
            label: Is Off (Y/N)
            alignment: left
        }
        layout {
            sequence: 13
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter Y if this shift represents a day off.
        }
    )

    pageItem P1134_NAME (
        type: textField
        label {
            label: Name
            alignment: left
        }
        layout {
            sequence: 10
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the shift name.
        }
    )

    pageItem P1134_START_TIME (
        type: datePicker
        label {
            label: Start Time
            alignment: left
        }
        layout {
            sequence: 11
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the shift start time.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction cancel-dialog (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button delete (
        buttonName: DELETE
        label: Delete or Archive
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Confirm the package-backed delete/archive operation.
            style: danger
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Shift operation completed
        }
        advanced {
            executionMappingIdentifier: 48373548509276760
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,DELETE
        }
    )

    process delete-shift (
        name: Delete Shift Through Package
        type: executeCode
        source {
            plsqlCode: DECLARE l_status varchar2(30); l_message varchar2(4000); BEGIN SCHEDULE_API_PKG.delete_schedule('SHIFT', :P1134_ENTITY_ID, l_status, l_message); IF l_status = 'REJECTED' THEN raise_application_error(-20001, l_message); END IF; END;
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 48373475892276760
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-shift-form (
        name: Initialize Shift Form
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    :P1134_IDEMPOTENCY_KEY := nvl(:P1134_IDEMPOTENCY_KEY, rawtohex(sys_guid()));
                    IF :P1134_ENTITY_ID IS NOT NULL THEN
                        SELECT NAME, FROM_DATE, DURATION, IS_OFF, ORA_ROWSCN
                          INTO :P1134_NAME, :P1134_START_TIME, :P1134_DURATION, :P1134_IS_OFF, :P1134_EXPECTED_VERSION
                          FROM SHIFT WHERE ID = :P1134_ENTITY_ID;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 48373204732276760
        }
    )

    process save-shift (
        name: Save Shift Through Package
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE l_id number; l_status varchar2(30); l_message varchar2(4000); BEGIN
                    SCHEDULE_API_PKG.upsert_schedule('SHIFT', :P1134_ENTITY_ID, null, null, :P1134_NAME, to_date(:P1134_START_TIME, 'YYYY-MM-DD'), null, :P1134_DURATION, null, :P1134_IS_OFF, null, :P1134_EXPECTED_VERSION, :P1134_IDEMPOTENCY_KEY, l_id, l_status, l_message);
                    IF l_status in ('REJECTED','CONFLICT') THEN raise_application_error(-20001, l_message); END IF;
                    :P1134_ENTITY_ID := l_id;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 48373369065276760
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)
