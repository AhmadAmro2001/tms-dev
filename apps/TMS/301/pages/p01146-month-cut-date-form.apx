page 1146 (
    name: Month Cut Date Form
    alias: MONTH-CUT-DATE-FORM
    title: Month Cut Date Form
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    css {
        fileUrls: #APP_FILES#style#MIN#.css
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region form-body (
        name: Month Cut Date Form
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1146_CUT_DATE (
        type: datePicker
        label {
            label: Cut Date
            alignment: left
        }
        layout {
            sequence: 12
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the timesheet cut date for this month.
        }
    )

    pageItem P1146_ENTITY_ID (
        type: hidden
        layout {
            sequence: 1
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1146_EXPECTED_VERSION (
        type: hidden
        layout {
            sequence: 2
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
    )

    pageItem P1146_IDEMPOTENCY_KEY (
        type: hidden
        layout {
            sequence: 1
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1146_LOCATION_ID (
        type: selectList
        label {
            label: Location
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @location
            nullDisplayValue: - Select Location -
        }
        layout {
            sequence: 10
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Select the location this cut date applies to.
        }
    )

    pageItem P1146_MONTH (
        type: datePicker
        label {
            label: Month
            alignment: left
        }
        layout {
            sequence: 11
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter any date within the target month.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }
        config {
            buildOption: @commented-out
        }

        triggerAction cancel-dialog (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button delete (
        buttonName: DELETE
        label: Delete or Archive
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Confirm the package-backed delete/archive operation.
            style: danger
        }
        config {
            buildOption: @commented-out
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: ig-action-btn
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Month Cut Date operation completed
        }
        advanced {
            executionMappingIdentifier: 48387617735276810
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,DELETE
        }
    )

    process delete-month-cut-date (
        name: Delete Month Cut Date Through Package
        type: executeCode
        source {
            plsqlCode: DECLARE l_status varchar2(30); l_message varchar2(4000); BEGIN SCHEDULE_API_PKG.delete_schedule('MONTH_CUT_DATE', :P1146_ENTITY_ID, l_status, l_message); IF l_status = 'REJECTED' THEN raise_application_error(-20001, l_message); END IF; END;
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 48387592410276810
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-month-cut-date-form (
        name: Initialize Month Cut Date Form
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    :P1146_IDEMPOTENCY_KEY := nvl(:P1146_IDEMPOTENCY_KEY, rawtohex(sys_guid()));
                    IF :P1146_ENTITY_ID IS NOT NULL THEN
                        SELECT LOCATION_ID, CUT_DATE, TO_TIMESTAMP(YEAR||'-'||LPAD(MONTH,2,'0')||'-01','YYYY-MM-DD'), ORA_ROWSCN
                          INTO :P1146_LOCATION_ID, :P1146_CUT_DATE, :P1146_MONTH, :P1146_EXPECTED_VERSION
                          FROM MONTH_CUT_DATE WHERE ID = :P1146_ENTITY_ID;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 48387360829276810
        }
    )

    process save-month-cut-date (
        name: Save Month Cut Date Through Package
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE l_id number; l_status varchar2(30); l_message varchar2(4000); BEGIN
                    SCHEDULE_API_PKG.upsert_schedule('MONTH_CUT_DATE', :P1146_ENTITY_ID, null, :P1146_LOCATION_ID, null, to_date(:P1146_MONTH, 'YYYY-MM-DD'), to_date(:P1146_CUT_DATE, 'YYYY-MM-DD'), null, null, null, null, :P1146_EXPECTED_VERSION, :P1146_IDEMPOTENCY_KEY, l_id, l_status, l_message);
                    IF l_status in ('REJECTED','CONFLICT') THEN raise_application_error(-20001, l_message); END IF;
                    :P1146_ENTITY_ID := l_id;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 48387409923276810
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)
