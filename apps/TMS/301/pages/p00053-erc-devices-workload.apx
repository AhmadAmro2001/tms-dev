    region erc-devices-workload-report (
        name: ERC Devices Workload
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                
                WITH YEAR_PARAMS AS (
                    SELECT
                        TO_DATE(
                            NVL(:P53_YEAR, TO_CHAR(SYSDATE, 'YYYY'))
                            || '-01-01',
                            'YYYY-MM-DD'
                        ) AS LOCAL_YEAR_START
                    FROM DUAL
                ),
                
                UTC_BOUNDS AS (
                    SELECT
                        CAST(
                            FROM_TZ(
                                CAST(LOCAL_YEAR_START AS TIMESTAMP),
                                'Africa/Cairo'
                            ) AT TIME ZONE 'UTC'
                            AS TIMESTAMP
                        ) AS UTC_START,
                
                        CAST(
                            FROM_TZ(
                                CAST(
                                    ADD_MONTHS(LOCAL_YEAR_START, 12)
                                    AS TIMESTAMP
                                ),
                                'Africa/Cairo'
                            ) AT TIME ZONE 'UTC'
                            AS TIMESTAMP
                        ) AS UTC_END
                    FROM YEAR_PARAMS
                ),
                
                --------------------------------------------------
                -- All known ERC device names
                --------------------------------------------------
                ERC_DEVICES AS (
                    SELECT DISTINCT
                        UPPER(TRIM(t.DEVICE_NAME)) AS DEVICE_NAME
                    FROM "TRANSACTION" t
                    WHERE UPPER(TRIM(t.DEVICE_NAME)) LIKE '%ERC%'
                ),
                
                --------------------------------------------------
                -- Transactions for selected year
                --------------------------------------------------
                YEAR_TRANSACTIONS AS (
                    SELECT
                        UPPER(TRIM(t.DEVICE_NAME)) AS DEVICE_NAME,
                
                        TRIM(TO_CHAR(t.TYPE)) AS MOVEMENT_TYPE,
                
                        EXTRACT(
                            MONTH FROM CAST(
                                FROM_TZ(
                                    CAST(t."DATE" AS TIMESTAMP),
                                    'UTC'
                                ) AT TIME ZONE 'Africa/Cairo'
                                AS TIMESTAMP
                            )
                        ) AS LOCAL_MONTH
                
                    FROM "TRANSACTION" t
                    CROSS JOIN UTC_BOUNDS b
                
                    WHERE t."DATE" >= b.UTC_START
                      AND t."DATE" < b.UTC_END
                      AND UPPER(TRIM(t.DEVICE_NAME)) LIKE '%ERC%'
                )
                
                SELECT
                    d.DEVICE_NAME,
                
                    --------------------------------------------------
                    -- JANUARY
                    --------------------------------------------------
                    SUM(CASE WHEN t.LOCAL_MONTH = 1
                              AND t.MOVEMENT_TYPE = '0'
                             THEN 1 ELSE 0 END) AS JAN_IN,
                
                    SUM(CASE WHEN t.LOCAL_MONTH = 1
                              AND t.MOVEMENT_TYPE = '1'
                             THEN 1 ELSE 0 END) AS JAN_OUT,
                
                    --------------------------------------------------
                    -- FEBRUARY
                    --------------------------------------------------
                    SUM(CASE WHEN t.LOCAL_MONTH = 2
                              AND t.MOVEMENT_TYPE = '0'
                             THEN 1 ELSE 0 END) AS FEB_IN,
                
                    SUM(CASE WHEN t.LOCAL_MONTH = 2
                              AND t.MOVEMENT_TYPE = '1'
                             THEN 1 ELSE 0 END) AS FEB_OUT,
                
                    --------------------------------------------------
                    -- MARCH
                    --------------------------------------------------
                    SUM(CASE WHEN t.LOCAL_MONTH = 3
                              AND t.MOVEMENT_TYPE = '0'
                             THEN 1 ELSE 0 END) AS MAR_IN,
                
                    SUM(CASE WHEN t.LOCAL_MONTH = 3
                              AND t.MOVEMENT_TYPE = '1'
                             THEN 1 ELSE 0 END) AS MAR_OUT,
                
                    --------------------------------------------------
                    -- APRIL
                    --------------------------------------------------
                    SUM(CASE WHEN t.LOCAL_MONTH = 4
                              AND t.MOVEMENT_TYPE = '0'
                             THEN 1 ELSE 0 END) AS APR_IN,
                
                    SUM(CASE WHEN t.LOCAL_MONTH = 4
                              AND t.MOVEMENT_TYPE = '1'
                             THEN 1 ELSE 0 END) AS APR_OUT,
                
                    --------------------------------------------------
                    -- MAY
                    --------------------------------------------------
                    SUM(CASE WHEN t.LOCAL_MONTH = 5
                              AND t.MOVEMENT_TYPE = '0'
                             THEN 1 ELSE 0 END) AS MAY_IN,
                
                    SUM(CASE WHEN t.LOCAL_MONTH = 5
                              AND t.MOVEMENT_TYPE = '1'
                             THEN 1 ELSE 0 END) AS MAY_OUT,
                
                    --------------------------------------------------
                    -- JUNE
                    --------------------------------------------------
                    SUM(CASE WHEN t.LOCAL_MONTH = 6
                              AND t.MOVEMENT_TYPE = '0'
                             THEN 1 ELSE 0 END) AS JUN_IN,
                
                    SUM(CASE WHEN t.LOCAL_MONTH = 6
                              AND t.MOVEMENT_TYPE = '1'
                             THEN 1 ELSE 0 END) AS JUN_OUT,
                
                    --------------------------------------------------
                    -- JULY
                    --------------------------------------------------
                    SUM(CASE WHEN t.LOCAL_MONTH = 7
                              AND t.MOVEMENT_TYPE = '0'
                             THEN 1 ELSE 0 END) AS JUL_IN,
                
                    SUM(CASE WHEN t.LOCAL_MONTH = 7
                              AND t.MOVEMENT_TYPE = '1'
                             THEN 1 ELSE 0 END) AS JUL_OUT,
                
                    --------------------------------------------------
                    -- AUGUST
                    --------------------------------------------------
                    SUM(CASE WHEN t.LOCAL_MONTH = 8
                              AND t.MOVEMENT_TYPE = '0'
                             THEN 1 ELSE 0 END) AS AUG_IN,
                
                    SUM(CASE WHEN t.LOCAL_MONTH = 8
                              AND t.MOVEMENT_TYPE = '1'
                             THEN 1 ELSE 0 END) AS AUG_OUT,
                
                    --------------------------------------------------
                    -- SEPTEMBER
                    --------------------------------------------------
                    SUM(CASE WHEN t.LOCAL_MONTH = 9
                              AND t.MOVEMENT_TYPE = '0'
                             THEN 1 ELSE 0 END) AS SEP_IN,
                
                    SUM(CASE WHEN t.LOCAL_MONTH = 9
                              AND t.MOVEMENT_TYPE = '1'
                             THEN 1 ELSE 0 END) AS SEP_OUT,
                
                    --------------------------------------------------
                    -- OCTOBER
                    --------------------------------------------------
                    SUM(CASE WHEN t.LOCAL_MONTH = 10
                              AND t.MOVEMENT_TYPE = '0'
                             THEN 1 ELSE 0 END) AS OCT_IN,
                
                    SUM(CASE WHEN t.LOCAL_MONTH = 10
                              AND t.MOVEMENT_TYPE = '1'
                             THEN 1 ELSE 0 END) AS OCT_OUT,
                
                    --------------------------------------------------
                    -- NOVEMBER
                    --------------------------------------------------
                    SUM(CASE WHEN t.LOCAL_MONTH = 11
                              AND t.MOVEMENT_TYPE = '0'
                             THEN 1 ELSE 0 END) AS NOV_IN,
                
                    SUM(CASE WHEN t.LOCAL_MONTH = 11
                              AND t.MOVEMENT_TYPE = '1'
                             THEN 1 ELSE 0 END) AS NOV_OUT,
                
                    --------------------------------------------------
                    -- DECEMBER
                    --------------------------------------------------
                    SUM(CASE WHEN t.LOCAL_MONTH = 12
                              AND t.MOVEMENT_TYPE = '0'
                             THEN 1 ELSE 0 END) AS DEC_IN,
                
                    SUM(CASE WHEN t.LOCAL_MONTH = 12
                              AND t.MOVEMENT_TYPE = '1'
                             THEN 1 ELSE 0 END) AS DEC_OUT,
                
                    --------------------------------------------------
                    -- YEARLY TOTALS
                    --------------------------------------------------
                    SUM(CASE WHEN t.MOVEMENT_TYPE = '0'
                             THEN 1 ELSE 0 END) AS TOTAL_IN,
                
                    SUM(CASE WHEN t.MOVEMENT_TYPE = '1'
                             THEN 1 ELSE 0 END) AS TOTAL_OUT,
                
                    SUM(CASE WHEN t.MOVEMENT_TYPE IN ('0', '1')
                             THEN 1 ELSE 0 END) AS TOTAL_TRANSACTIONS
                
                FROM ERC_DEVICES d
                
                LEFT JOIN YEAR_TRANSACTIONS t
                    ON t.DEVICE_NAME = d.DEVICE_NAME
                
                WHERE AUTH_PKG.can_read_sql('ReadTransactions') = 1
                
                GROUP BY
                    d.DEVICE_NAME
                
                ORDER BY
                    d.DEVICE_NAME
                
                ```
            pageItemsToSubmit: P53_YEAR
        }
        layout {
            sequence: 38
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: [
                #DEFAULT#
                t-IRR-region--hideHeader js-addHiddenHeadingRoleDesc
