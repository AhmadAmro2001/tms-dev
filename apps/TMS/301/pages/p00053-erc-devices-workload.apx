        }
    )

    pageItem P53_YEAR (
        type: selectOne
        label {
            label: Year
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    TO_CHAR(EXTRACT(YEAR FROM SYSDATE) - LEVEL + 1) AS DISPLAY_VALUE,
                    TO_CHAR(EXTRACT(YEAR FROM SYSDATE) - LEVEL + 1) AS RETURN_VALUE
                FROM DUAL
                CONNECT BY LEVEL <= 10
                ORDER BY DISPLAY_VALUE DESC
                ```
        }
        layout {
            sequence: 10
            region: @new
            slot: regionBody
            alignment: left
            columnSpan: 8
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 30
        }
    )

    button apply-erc-devices-workload-filters (
        buttonName: APPLY_ERC_DEVICES_WORKLOAD_FILTERS
        label: Apply Filters
        layout {
            sequence: 30
            region: @erc-devices-workload-filters
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
