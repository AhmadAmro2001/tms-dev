    process archive-user (
        name: ARCHIVE_USER
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                
                v_is_archive_flag number;
                
                BEGIN
                
                    select IS_ARCHIVED into v_is_archive_flag from USER_ACCOUNT where id = apex_application.g_x01;
                
                    if v_is_archive_flag = 0 then 
                
                    UPDATE USER_ACCOUNT
                    SET IS_ARCHIVED = 1
                    WHERE ID = apex_application.g_x01;
                    else
                        UPDATE USER_ACCOUNT
                    SET IS_ARCHIVED = 0
                    WHERE ID = apex_application.g_x01;
                    end if;
                
                    COMMIT;
                
                     apex_json.open_object;
                    apex_json.write('success', true);
                    apex_json.close_object;
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 54396335527627205
        }
    )

    process update-print-permission (
        name: UPDATE_PRINT_PERMISSION
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                
                v_IS_ALLOWED_TO_PRINT_TIMESHEET_flag number;
                
                    
                BEGIN
                
                    select IS_ALLOWED_TO_PRINT_TIMESHEET into v_IS_ALLOWED_TO_PRINT_TIMESHEET_flag from USER_ACCOUNT where id = apex_application.g_x01;
                
                    if v_IS_ALLOWED_TO_PRINT_TIMESHEET_flag = 0 then
                        -- Update USER_ACCOUNT
                    UPDATE USER_ACCOUNT
                    SET IS_ALLOWED_TO_PRINT_TIMESHEET = 1
                    WHERE ID = apex_application.g_x01;
                
                    -- Update APP_USER
                    UPDATE APP_USER
                    SET IS_ALLOWED_TO_PRINT_TIMESHEET = 'Y'
                    WHERE LEGACY_USER_ID = apex_application.g_x01;
                else
                
                    -- Update USER_ACCOUNT
                    UPDATE USER_ACCOUNT
                    SET IS_ALLOWED_TO_PRINT_TIMESHEET = 0
                    WHERE ID = apex_application.g_x01;
                
                    -- Update APP_USER
                    UPDATE APP_USER
                    SET IS_ALLOWED_TO_PRINT_TIMESHEET = 'N'
                    WHERE LEGACY_USER_ID = apex_application.g_x01;
                    end if;
                
                    COMMIT;
                
                    -- Return JSON response
                    apex_json.open_object;
                    apex_json.write('success', true);
                    apex_json.close_object;
                
                END;
                ```
        }
        execution {
            sequence: 20
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 54396573563627207
        }
    )

    process update-user-access (
        name: UPDATE_USER_ACCESS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_user_id   NUMBER := TO_NUMBER(APEX_APPLICATION.G_X01);
                    l_field     VARCHAR2(30) := APEX_APPLICATION.G_X02;
                    l_value     VARCHAR2(1) := APEX_APPLICATION.G_X03;
                
                    l_operation VARCHAR2(30);
                    l_version   NUMBER;
                    l_status    VARCHAR2(30);
                    l_message   VARCHAR2(4000);
                
                BEGIN
                
                    IF l_user_id IS NULL
                       OR l_field NOT IN ('SYSTEM', 'LIMITED')
                       OR l_value NOT IN ('Y', 'N')
                    THEN
                        RAISE_APPLICATION_ERROR(-20001, 'Invalid request');
                    END IF;
                
                    IF l_field = 'SYSTEM' THEN
                        l_operation :=
                            CASE WHEN l_value = 'Y'
                                 THEN 'ALLOW_SYSTEM'
                                 ELSE 'DENY_SYSTEM'
                            END;
                
                    ELSIF l_field = 'LIMITED' THEN
                        l_operation :=
                            CASE WHEN l_value = 'Y'
                                 THEN 'GRANT_LIMITED'
                                 ELSE 'REVOKE_LIMITED'
                            END;
                    END IF;
                
                    SELECT ORA_ROWSCN
                      INTO l_version
                      FROM APP_USER
                     WHERE ID = l_user_id;
                
                    AUTH_PKG.set_user_state(
                        p_app_user_id      => l_user_id,
                        p_operation        => l_operation,
                        p_expected_version => l_version,
                        p_idempotency_key  => RAWTOHEX(SYS_GUID()),
                        p_status           => l_status,
                        p_message          => l_message
                    );
                
                    APEX_JSON.OPEN_OBJECT;
                    APEX_JSON.WRITE(
                        'success',
                        l_status IN ('SUCCESS', 'IDEMPOTENT')
                    );
                    APEX_JSON.WRITE('message', l_message);
                    APEX_JSON.CLOSE_OBJECT;
                
                EXCEPTION
                    WHEN OTHERS THEN
                        APEX_DEBUG.ERROR(
                            'UPDATE_USER_ACCESS: %s',
                            SQLERRM
                        );
                
                        APEX_JSON.OPEN_OBJECT;
                        APEX_JSON.WRITE('success', FALSE);
                        APEX_JSON.WRITE(
                            'message',
                            'Unable to update user access.'
                        );
                        APEX_JSON.CLOSE_OBJECT;
                END;
                ```
        }
        execution {
            sequence: 30
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 82132325529119817
        }
    )

