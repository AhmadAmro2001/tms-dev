    region users (
        name: Users
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT
                    au.ID,
                    au.APEX_USERNAME,
                    ro.NAME AS ROLE_NAME,
                
                    -- Access System Toggle
                    '<label class="user-access-switch">
                        <input type="checkbox"
                               class="js-user-access-toggle"
                               data-user-id="' || au.ID || '"
                               data-field="SYSTEM"
                               aria-label="Access System"
                               ' ||
                               CASE
                                   WHEN au.ENABLED = 'Y' THEN 'checked'
                                   ELSE ''
                               END ||
                        '>
                        <span class="user-access-slider"></span>
                    </label>' AS ENABLED,
                
                    -- Print Timesheet Permission
                    CASE
                        WHEN au.IS_ALLOWED_TO_PRINT_TIMESHEET = 'Y' THEN 'Yes'
                        WHEN au.IS_ALLOWED_TO_PRINT_TIMESHEET = 'N' THEN 'No'
                        ELSE NULL
                    END AS IS_ALLOWED_TO_PRINT_TIMESHEET,
                
                    -- Access Limited Timesheet Toggle
                    '<label class="user-access-switch">
                        <input type="checkbox"
                               class="js-user-access-toggle"
                               data-user-id="' || au.ID || '"
                               data-field="LIMITED"
                               aria-label="Access Limited Timesheet"
                               ' ||
                               CASE
                                   WHEN au.IS_LIMITED_TIMESHEET_ACCESS = 'Y'
                                   THEN 'checked'
                                   ELSE ''
                               END ||
                        '>
                        <span class="user-access-slider"></span>
                    </label>' AS IS_LIMITED_TIMESHEET_ACCESS,
                
                    -- Locations
                    LISTAGG(l.NAME, ', ')
                        WITHIN GROUP (ORDER BY l.NAME) AS LOCATION_NAMES,
                
                    au.CREATED_AT,
                
                    -- Edit URL
                    APEX_PAGE.GET_URL(
                        p_page   => 1124,
                        p_items  => 'P1124_APP_USER_ID',
                        p_values => TO_CHAR(au.ID)
                    ) AS EDIT_URL,
                
                    -- Archive Button
                    '<a href="#"
                        class="ig-action-btn"
                        onclick="archiveUser(' || uacc.ID || '); return false;">
                        Archive
                    </a>' AS ARCHIVE_BTN,
                
                    -- Print Permission Button
                    '<a href="#"
                        class="ig-action-btn"
                        onclick="updatePrintPermission(' || uacc.ID || '); return false;">
                        Print Permission
                    </a>' AS PRINT_PERMISSION
                
                FROM APP_USER au
                
                JOIN APP_USER_ROLE ur
                    ON ur.APP_USER_ID = au.ID
                
                JOIN APP_ROLE r
                    ON r.id = ur.APP_ROLE_ID
                
                JOIN ROLE ro
                    ON ro.ID = ur.APP_ROLE_ID
                
                LEFT JOIN APP_USER_LOCATION ul
                    ON ul.APP_USER_ID = au.ID
                
                LEFT JOIN LOCATION l
                    ON l.ID = ul.LOCATION_ID
                
                JOIN USER_ACCOUNT uacc
                    ON uacc.ID = au.LEGACY_USER_ID
                
                WHERE uacc.IS_ARCHIVED = 0
                
                GROUP BY
                    au.ID,
                    au.APEX_USERNAME,
                    ro.NAME,
                    au.ENABLED,
                    au.IS_ALLOWED_TO_PRINT_TIMESHEET,
                    au.IS_LIMITED_TIMESHEET_ACCESS,
                    au.CREATED_AT,
                    uacc.ID
                
                ORDER BY au.APEX_USERNAME
                
                ```
        }
