    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            //========= archive function ===========
            
            function archiveUser(userAccountId) {
            
                if (!confirm('Are you sure you want to archive this user?')) {
                    return;
                }
            
                apex.server.process(
                    "ARCHIVE_USER",
                    {
                        x01: userAccountId
                    },
                    {
                        success: function () {
            
                            apex.message.showPageSuccess(
                                "User archived successfully."
                            );
            
                            apex.region("APP_USERS_REPORT").refresh();
                        },
            
                        error: function (jqXHR, textStatus, errorThrown) {
            
                            apex.message.alert(
                                "Error archiving user: " + errorThrown
                            );
            
                        }
                    }
                );
            }
            
            
            
            // ==============print permission function ===================
            
            function updatePrintPermission(appUserId) {
            
                if (!confirm("Are you sure you want to enable print permission for this user?")) {
                    return;
                }
            
                apex.server.process(
                    "UPDATE_PRINT_PERMISSION",
                    {
                        x01: appUserId
                    },
                    {
                        success: function (data) {
            
                            apex.message.showPageSuccess(
                                "Print permission enabled successfully."
                            );
            
                            apex.region("APP_USERS_REPORT").refresh();
                        },
            
                        error: function (jqXHR, textStatus, errorThrown) {
            
                            console.log("Status:", textStatus);
                            console.log("Error:", errorThrown);
                            console.log("Response:", jqXHR.responseText);
            
                            apex.message.alert(
                                "Error updating print permission: " + errorThrown
                            );
                        }
                    }
                );
            }
            ```
        executeWhenPageLoads:
            ```javascript-browser
            apex.jQuery(document).on(
                "change",
                ".js-user-access-toggle",
                function () {
            
                    const toggle = this;
            
                    const userId = toggle.dataset.userId;
                    const field = toggle.dataset.field;
                    const value = toggle.checked ? "Y" : "N";
            
                    toggle.disabled = true;
            
                    apex.server.process(
                        "UPDATE_USER_ACCESS",
                        {
                            x01: userId,
                            x02: field,
                            x03: value
                        },
                        {
                            dataType: "json"
                        }
                    )
                    .done(function (data) {
            
                        if (!data || data.success !== true) {
                            toggle.checked = !toggle.checked;
            
                            apex.message.alert(
                                data?.message || "Failed to update access."
                            );
                        }
            
                    })
                    .fail(function () {
            
                        toggle.checked = !toggle.checked;
            
                        apex.message.alert(
                            "Unable to update user access."
                        );
            
                    })
                    .always(function () {
                        toggle.disabled = false;
                    });
            
                }
            );
            ```
