    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction cancel-dialog (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button delete (
        buttonName: DELETE
        label: Delete or Archive
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Confirm the package-backed delete/archive operation.
            style: danger
        }
        config {
            buildOption: @commented-out
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        config {
            buildOption: @commented-out
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Employee operation completed
        }
        advanced {
            executionMappingIdentifier: 49061785184164889
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,DELETE
        }
    )

    process delete-employee (
        name: Delete Employee Through Package
        type: executeCode
        source {
            plsqlCode: DECLARE l_status varchar2(30); l_message varchar2(4000); BEGIN REFERENCE_API_PKG.delete_reference('EMPLOYEE', :P1148_ENTITY_ID, l_status, l_message); IF l_status = 'REJECTED' THEN raise_application_error(-20001, l_message); END IF; END;
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 49061357467164888
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-employee-form (
        name: Initialize Employee Form
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    :P1148_IDEMPOTENCY_KEY := nvl(:P1148_IDEMPOTENCY_KEY, rawtohex(sys_guid()));
                    IF :P1148_ENTITY_ID IS NOT NULL THEN
                        SELECT NAME, EMPLOYEE_NUMBER, PROJECT_ID, LOCATION_ID, DEPARTMENT_ID, GRADE_ID, IS_ACTIVE, NATIONALITY, RELIGION, PRINT_TIMESHEET, ORA_ROWSCN
                          INTO :P1148_NAME, :P1148_EMPLOYEE_NUMBER, :P1148_PROJECT_ID, :P1148_LOCATION_ID, :P1148_DEPARTMENT_ID, :P1148_GRADE_ID, :P1148_IS_ACTIVE, :P1148_NATIONALITY, :P1148_RELIGION, :P1148_PRINT_TIMESHEET, :P1148_EXPECTED_VERSION
                          FROM EMPLOYEE WHERE ID = :P1148_ENTITY_ID;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 49060512226164888
        }
    )

    process save-employee (
        name: Save Employee Through Package
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE l_id number; l_status varchar2(30); l_message varchar2(4000); BEGIN
                    REFERENCE_API_PKG.upsert_reference('EMPLOYEE', :P1148_ENTITY_ID, :P1148_NAME, :P1148_EMPLOYEE_NUMBER, :P1148_PROJECT_ID, :P1148_LOCATION_ID, :P1148_DEPARTMENT_ID, :P1148_GRADE_ID, :P1148_IS_ACTIVE, :P1148_NATIONALITY, :P1148_RELIGION, :P1148_PRINT_TIMESHEET, :P1148_EXPECTED_VERSION, :P1148_IDEMPOTENCY_KEY, l_id, l_status, l_message);
                    IF l_status in ('REJECTED','CONFLICT') THEN raise_application_error(-20001, l_message); END IF;
                    :P1148_ENTITY_ID := l_id;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 49060920603164888
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)
