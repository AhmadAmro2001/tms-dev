page 1136 (
    name: Rotation Day Form
    alias: ROTATION-DAY-FORM
    title: Rotation Day Form
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region form-body (
        name: Rotation Day Form
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1136_DAY (
        type: textField
        label {
            label: Day
            alignment: left
        }
        layout {
            sequence: 12
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the day number within the rotation cycle (1-30).
        }
    )

    pageItem P1136_ENTITY_ID (
        type: hidden
        layout {
            sequence: 1
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1136_EXPECTED_VERSION (
        type: hidden
        layout {
            sequence: 2
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
    )

    pageItem P1136_IDEMPOTENCY_KEY (
        type: hidden
        layout {
            sequence: 1
            region: @form-body
            slot: regionBody
        }
        sessionState {
            storage: request
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1136_ROTATION_ID (
        type: textField
        label {
            label: Rotation Plan ID
            alignment: left
        }
        layout {
            sequence: 10
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the rotation plan ID this day belongs to.
        }
    )

    pageItem P1136_SHIFT_ID (
        type: textField
        label {
            label: Shift ID
            alignment: left
        }
        layout {
            sequence: 11
            region: @form-body
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 30
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
        help {
            helpText: Enter the shift ID assigned to this day.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction cancel-dialog (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button delete (
        buttonName: DELETE
        label: Delete or Archive
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Confirm the package-backed delete/archive operation.
            style: danger
        }
    )

    button save (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Rotation Day operation completed
        }
        advanced {
            executionMappingIdentifier: 48377910254276763
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE,DELETE
        }
    )

    process delete-rotation-day (
        name: Delete Rotation Day Through Package
        type: executeCode
        source {
            plsqlCode: DECLARE l_status varchar2(30); l_message varchar2(4000); BEGIN SCHEDULE_API_PKG.delete_schedule('ROTATION_DAY', :P1136_ENTITY_ID, l_status, l_message); IF l_status = 'REJECTED' THEN raise_application_error(-20001, l_message); END IF; END;
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 48377858560276763
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process initialize-rotation-day-form (
        name: Initialize Rotation Day Form
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    :P1136_IDEMPOTENCY_KEY := nvl(:P1136_IDEMPOTENCY_KEY, rawtohex(sys_guid()));
                    IF :P1136_ENTITY_ID IS NOT NULL THEN
                        SELECT ROTATION_ID, SHIFT_ID, DAY, ORA_ROWSCN
                          INTO :P1136_ROTATION_ID, :P1136_SHIFT_ID, :P1136_DAY, :P1136_EXPECTED_VERSION
                          FROM ROTATION_DAY WHERE ID = :P1136_ENTITY_ID;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 48377652532276763
        }
    )

    process save-rotation-day (
        name: Save Rotation Day Through Package
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE l_id number; l_status varchar2(30); l_message varchar2(4000); BEGIN
                    SCHEDULE_API_PKG.upsert_schedule('ROTATION_DAY', :P1136_ENTITY_ID, null, null, null, null, null, :P1136_ROTATION_ID, :P1136_SHIFT_ID, :P1136_DAY, null, :P1136_EXPECTED_VERSION, :P1136_IDEMPOTENCY_KEY, l_id, l_status, l_message);
                    IF l_status in ('REJECTED','CONFLICT') THEN raise_application_error(-20001, l_message); END IF;
                    :P1136_ENTITY_ID := l_id;
                END;
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 48377778432276763
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

)
