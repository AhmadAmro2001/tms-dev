page 35 (
    name: Special Leaves
    alias: SPECIAL-LEAVES
    title: Special Leaves
    pageGroup: @employees
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    css {
        fileUrls: #APP_FILES#style#MIN#.css
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Special Leaves
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filter-region (
        name: filter region
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--stacked
                t-Region--scrollBody
            ]
        }
    )

    region special-leaves (
        name: Special Leaves
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                    s.ID, 
                    e.EMPLOYEE_NUMBER, 
                    e.NAME AS EMPLOYEE_NAME, 
                    s.FROM_DATE,
                    s.TO_DATE, 
                    -- TO_CHAR(s.FROM_DATE, 'HH AM') AS FROM_DATE,
                    -- TO_CHAR(s.TO_DATE, 'HH AM') AS TO_DATE,
                    l.name as location_name,
                    d.name as department_name,
                    st.NAME AS TYPE_NAME, 
                    s.IS_INSERTED_BY_APEX, 
                    apex_page.get_url(p_page => 1144, 
                    p_items => 'P1144_ENTITY_ID', p_values => to_char(s.ID)) AS EDIT_URL ,
                    'delete' as DELETE_BUTTON
                    from SPECIAL_LEAVE s 
                    join EMPLOYEE e 
                    on e.ID=s.EMPLOYEE_ID 
                    left join SPECIAL_LEAVE_TYPE st 
                    on st.ID=s.TYPE_ID 
                
                    left JOIN LOCATION l
                    ON l.ID = e.LOCATION_ID
                    LEFT JOIN DEPARTMENT d
                    ON d.id = e.DEPARTMENT_ID
                    where e.LOCATION_ID in (select to_number(column_value) from table(apex_string.split(:APP_USER_LOCATION_IDS, ':'))) 
                    and :P35_SUBMIT_FLAG = 'Y' 
                AND
                (
                    :P35_EMPLOYEE_CODE IS NULL
                    OR e.EMPLOYEE_NUMBER = :P35_EMPLOYEE_CODE
                )
                
                AND (
                    :P35_LOCATION IS NULL
                    OR e.LOCATION_ID = :P35_LOCATION
                )
                
                AND (
                    :P35_FROM IS NULL
                    OR s."FROM_DATE" >= TRUNC(TO_DATE(:P35_FROM, 'MM/DD/YYYY'))
                )
                
                AND (
                    :P35_TO IS NULL
                    OR s."FROM_DATE" < TRUNC(TO_DATE(:P35_TO, 'MM/DD/YYYY')) + 1
                )
                AND (
                    :P35_DEPARTMENT IS NULL
                    OR e.DEPARTMENT_ID = :P35_DEPARTMENT
                )
                    order by s.FROM_DATE desc
                ```
            pageItemsToSubmit: [
                P35_EMPLOYEE_CODE
                P35_LOCATION
                P35_FROM
                P35_SUBMIT_FLAG
                P35_TO
                P35_DEPARTMENT
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: special_leave_report
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.CAN_READ_SQL('ReadVacations') = 1
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No matching rows are available in your permitted scope.
            whenMoreDataFound: Apply filters to reduce the result set before exporting.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 47971188992343180
        }

