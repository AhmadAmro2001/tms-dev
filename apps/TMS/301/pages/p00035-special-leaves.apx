    button submit (
        buttonName: Submit
        label: Submit
        layout {
            sequence: 60
            region: @filter-region
            slot: regionBody
            startNewRow: false
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--large
                t-Button--primary
                t-Button--stretch
                t-Button--gapTop
            ]
        }
        behavior {
            action: definedByDynamicAction
