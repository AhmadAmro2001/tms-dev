page 22 (
    name: Locations
    alias: LOCATIONS
    title: Locations
    pageGroup: @company
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    css {
        fileUrls: #APP_FILES#style#MIN#.css
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Locations
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region locations (
        name: LocationsData
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 
                    l.ID, 
                    l.NAME, 
                    apex_page.get_url(
                        p_page => 1132, 
                        p_items => 'P1132_ENTITY_ID', 
                        p_values => to_char(l.ID)
                    ) AS EDIT_URL ,
                    'delete' as DELETE_BUTTON
                
                    from LOCATION l 
                    where l.ID in (
                        select to_number(column_value) 
                        from table(apex_string.split(:APP_USER_LOCATION_IDS, ':'))) 
                    order by l.NAME
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: location_report
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.CAN_READ_SQL('ReadEmployees') = 1
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No matching rows are available in your permitted scope.
            whenMoreDataFound: Apply filters to reduce the result set before exporting.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 47963160423343140
        }

        column DELETE_BUTTON (
            type: plainText
            heading {
                heading: Delete
            }
            layout {
                sequence: 23
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <a 
                       class="ig-action-btn delete-btn"
                        data-id="#ID#"
                        href="#"
                        >
                        <span class="fa fa-trash"></span>
                        Delete
                    </a>
                    ```
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column EDIT_URL (
            type: plainText
            heading {
                heading: Actions
            }
            layout {
                sequence: 3
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression: <a href="#EDIT_URL!ATTR#" class="ig-action-btn" aria-label="Edit" title="Edit"><span class="fa fa-edit" aria-hidden="true"></span> Edit</a>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
            security {
                escapeSpecialChars: false
            }
        )

        column ID (
            type: plainText
            heading {
                heading: Id
                alignment: end
            }
            layout {
                sequence: 13
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column NAME (
            type: plainText
            heading {
                heading: NAME
            }
            layout {
                sequence: 2
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DELETE_BUTTON (
                sequence: 3
            )

            displayColumn EDIT_URL (
                sequence: 2
            )

            displayColumn NAME (
                sequence: 1
            )

        )

    )

    button create-locations (
        buttonName: CREATE_LOCATIONS
        label: Create Locations
        layout {
            sequence: 10
            region: @locations
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            cssClasses: ig-action-btn
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1132
                clearCache: 1132
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.HAS_ROLE('1') or AUTH_PKG.HAS_ROLE('2')
        }
    )

    dynamicAction new (
        name: New
        execution {
            sequence: 20
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(document).on('click', '.delete-btn', function () {
                    
                        var id = $(this).data("id");
                        apex.message.confirm("Are you sure you want to proceed?", function (okPressed) {
                            if (okPressed) {
                    
                                apex.server.process(
                                    "DELETE_LOCATION",
                                    {
                                        x01: id
                                    },
                                    {
                                        success: function () {
                    
                                            console.log('ya hamada');
                                            apex.region("location_report").refresh();
                                        },
                                        error: function (pError) {
                                            console.error(pError);
                                        }
                                    }
                                );
                            }
                        });
                    
                    
                    
                    
                    });
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refresh-locations-after-dialog (
        name: Refresh after dialog close
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @locations
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode: apex.region("LocationsData").refresh();
            }
            affectedElements {
                selectionType: region
                region: @locations
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
            config {
                buildOption: @commented-out
            }
        )

        action refresh-report (
            action: refresh
            affectedElements {
                selectionType: region
                region: @locations
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    process delete-location (
        name: DELETE_LOCATION
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                l_type varchar2 := 'LOCATION';
                BEGIN
                    DELETE_PKG.delete_location(
                        p_id => apex_application.g_x01
                    );
                    AUDIT_PKG.record_event('REFERENCE_LOCATION_DELETE', l_type,  apex_application.g_x01, null);
                
                apex_json.open_object;
                apex_json.write('msg', 'ok') ;
                apex_json.close_object;
                
                END;
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 71549304487537244
        }
    )

)
