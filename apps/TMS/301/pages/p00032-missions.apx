                selectionType: items
                items: [
                    P32_EMPLOYEE_NUMBER
                    P32_LOCATIONS
                    P32_DEPARTMENTS
                    P32_FROM
                    P32_TO
                ]
            }
            execution {
                sequence: 30
            }
        )

    )

    dynamicAction new_2 (
        name: New
        execution {
            sequence: 40
        }
        when {
            event: ready
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    $(document).on('click', '.delete-btn', function () {
                    
                        var id = $(this).data("id");
                        apex.message.confirm("Are you sure you want to proceed?", function (okPressed) {
                            if (okPressed) {
                    
                                apex.server.process(
                                    "DELETE_MISSION",
                                    {
                                        x01: id
                                    },
                                    {
                                        success: function () {
                    
                                            // console.log('ya hamada');
                                            apex.region("mission_report").refresh();
                                        },
                                        error: function (pError) {
                                            console.error(pError);
                                        }
                                    }
                                );
                            }
                        });
                    
                    
                    
                    
                    });
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    dynamicAction refresh-missions-after-dialog (
        name: Refresh after dialog close
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosecanceldialog
            selectionType: region
            region: @missions
        }

        action refresh-report (
            action: refresh
            affectedElements {
                selectionType: region
                region: @missions
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process delete-mission (
        name: DELETE_MISSION
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_status   VARCHAR2(30);
                    l_message  VARCHAR2(4000);
                    l_type varchar2 := 'MISSION';
                BEGIN
                    DELETE_PKG.delete_mission(
                        p_id => apex_application.g_x01
                    );
                
                    AUDIT_PKG.record_event('REFERENCE_MISSION_DELETE', l_type,  apex_application.g_x01, null);
                
                    IF l_status = 'REJECTED' THEN
                        RAISE_APPLICATION_ERROR(
                            -20001,
                            l_message
                        );
                    END IF;
                
                
                
                    apex_json.open_object;
                    apex_json.write('msg', 'ok') ;
                    apex_json.close_object;
                END;
                
                ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
        advanced {
            executionMappingIdentifier: 78265977261676810
        }
    )

)
