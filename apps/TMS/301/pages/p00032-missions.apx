    css {
        fileUrls: #APP_FILES#style#MIN#.css
    }
    security {
        authorizationScheme: @tms-authenticated
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Missions
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region filter-region (
        name: Filter Region
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader js-removeLandmark
                t-Region--stacked
                t-Region--scrollBody
            ]
        }
    )

    region missions (
        name: Missions_data
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select m.ID, e.EMPLOYEE_NUMBER, e.NAME AS EMPLOYEE_NAME, m.FROM_DATE, m.TO_DATE, l.name as location_name, m.IS_INSERTED_BY_APEX, m.DESCRIPTION, apex_page.get_url(p_page => 1141, p_items => 'P1141_ENTITY_ID', p_values => to_char(m.ID)) AS EDIT_URL,
                apex_page.get_url(p_page => 1149, p_items => 'P1149_ENTITY_ID', p_values => to_char(m.ID)) AS VIEW_URL ,
                'Delete' as DELETE_BUTTON,
                m.CREATION_DATE
                 from MISSION m 
                 join EMPLOYEE e on e.ID=m.EMPLOYEE_ID 
                  join location l on l.id = e.location_id
                
                 where e.LOCATION_ID in (select to_number(column_value) from table(apex_string.split(:APP_USER_LOCATION_IDS, ':'))) 
                 AND :P32_SUBMIT_FLAG = 'Y'
                 AND (
                    :P32_EMPLOYEE_NUMBER IS NULL
                    OR e.EMPLOYEE_NUMBER = :P32_EMPLOYEE_NUMBER
                )
                 AND (
                    :P32_LOCATIONS IS NULL
                    OR e.LOCATION_ID = :P32_LOCATIONS
                )
                 AND (
                    :P32_FROM IS NULL
                    OR m.FROM_DATE >= to_date(:P32_FROM, 'dd-mm-yyyy')
                 )
                  AND (
                    :P32_TO IS NULL
                    OR m.TO_DATE <= to_date(:P32_TO, 'dd-mm-yyyy')
                 )
                 order by m.FROM_DATE desc
                ```
            pageItemsToSubmit: [
                P32_SUBMIT_FLAG
                P32_EMPLOYEE_NUMBER
                P32_LOCATIONS
                P32_FROM
                P32_TO
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: mission_report
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.CAN_READ_SQL('ReadMissions') = 1
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000
        }
        messages {
            whenNoDataFound: No matching rows are available in your permitted scope.
            whenMoreDataFound: Apply filters to reduce the result set before exporting.
        }
        searchBar {
            rowsPerPageSelector: true
        }
        actionsMenu {
            savePublicReport: true
        }
        advanced {
            savedReportMappingIdentifier: 47967062307343142
        }

