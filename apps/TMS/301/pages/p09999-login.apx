page 9999 (
    name: Login Page
    alias: LOGIN
    title: &APP_TITLE. - Log In
    appearance {
        pageTemplate: @/login
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region app-name (
        name: Login
        title: &APP_TITLE.
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/login
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

    region password-reset (
        name: Password Reset
        title: Choose a new password
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/login
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: AUTH_PKG.IS_PASSWORD_RESET_REQUIRED
        }
    )

    pageItem P9999_CONFIRM_PASSWORD (
        type: password
        label {
            label: Confirm new password
            alignment: right
        }
        layout {
            sequence: 30
            region: @password-reset
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            icon: fa-key
            width: 40
        }
        validation {
            maxLength: 512
        }
        advanced {
            customAttributes: autocomplete="new-password"
        }
        sessionState {
            storage: request
        }
    )

    pageItem P9999_CURRENT_PASSWORD (
        type: password
        label {
            label: Current temporary password
            alignment: right
        }
        layout {
            sequence: 10
            region: @password-reset
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            icon: fa-key
            width: 40
        }
        validation {
            maxLength: 512
        }
        advanced {
            customAttributes: autocomplete="current-password"
        }
        sessionState {
            storage: request
        }
    )

    pageItem P9999_NEW_PASSWORD (
        type: password
        label {
            label: New password
            alignment: right
        }
        layout {
            sequence: 20
            region: @password-reset
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            icon: fa-key
            width: 40
        }
        validation {
            maxLength: 512
        }
        advanced {
            customAttributes: autocomplete="new-password"
        }
        sessionState {
            storage: request
        }
    )

    pageItem P9999_PASSWORD (
        type: password
        label {
            label: Password
            alignment: right
        }
        layout {
            sequence: 20
            region: @app-name
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            icon: fa-key
            width: 40
            valuePlaceholder: Password
        }
        validation {
            maxLength: 100
        }
        advanced {
            customAttributes: autocomplete="current-password"
        }
        sessionState {
            storage: request
        }
        serverSideCondition {
            type: expression
            plsqlExpression: not AUTH_PKG.IS_PASSWORD_RESET_REQUIRED
        }
    )

    pageItem P9999_REMEMBER (
        type: checkbox
        label {
            label: Remember username
            alignment: right
        }
        layout {
            sequence: 30
            region: @app-name
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: expression
            plsqlExpression: apex_authentication.persistent_cookies_enabled and not AUTH_PKG.IS_PASSWORD_RESET_REQUIRED
        }
    )

    pageItem P9999_USERNAME (
        type: textField
        label {
            label: Username
            alignment: left
        }
        settings {
            submitWhenEnterPressed: true
        }
        layout {
            sequence: 10
            region: @app-name
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            icon: fa-user
            width: 40
            valuePlaceholder: Username
        }
        validation {
            maxLength: 100
        }
        advanced {
            customAttributes: autocomplete="username"
        }
        sessionState {
            storage: request
        }
        serverSideCondition {
            type: expression
            plsqlExpression: not AUTH_PKG.IS_PASSWORD_RESET_REQUIRED
        }
    )

    button change-password (
        buttonName: CHANGE_PASSWORD
        label: Change Password
        layout {
            sequence: 40
            region: @password-reset
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button login (
        buttonName: LOGIN
        label: Sign In
        layout {
            sequence: 40
            region: @app-name
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: expression
            plsqlExpression: not AUTH_PKG.IS_PASSWORD_RESET_REQUIRED
        }
    )

    process change-password (
        name: Change Password
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P9999_NEW_PASSWORD is null
                   or :P9999_NEW_PASSWORD <> :P9999_CONFIRM_PASSWORD then
                    raise_application_error(-20065, 'New password confirmation does not match');
                end if;
                AUTH_PKG.CHANGE_PASSWORD(
                    p_current_password => :P9999_CURRENT_PASSWORD,
                    p_new_password => :P9999_NEW_PASSWORD
                );
                apex_util.redirect_url(
                    'f?p=' || :APP_ID || ':1:' || :APP_SESSION
                );
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Password changed.
        }
        advanced {
            executionMappingIdentifier: 48012581723343393
        }
        serverSideCondition {
            whenButtonPressed: @change-password
        }
    )

    process clear-page-s-cache (
        name: Clear Page(s) Cache
        type: clearSessionState
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 3073906448829089
        }
    )

    process get-username-cookie (
        name: Get Username Cookie
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P9999_USERNAME := apex_authentication.get_login_username_cookie;
                :P9999_REMEMBER := case when :P9999_USERNAME is not null then 'Y' end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 3073526297829089
        }
    )

    process login (
        name: Login
        type: invokeApi
        invoke {
            package: APEX_AUTHENTICATION
            procedureOrFunction: LOGIN
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 3070275942829086
        }
        serverSideCondition {
            whenButtonPressed: @login
        }

        parameter p_password (
            value {
                type: item
                item: P9999_PASSWORD
            }
            advanced {
                displaySequence: 2
            }
        )

        parameter p_set_persistent_auth (
            parameter {
                dataType: boolean
                hasDefault: true
            }
            value {
                type: apiDefault
            }
            advanced {
                displaySequence: 3
            }
        )

        parameter p_username (
            value {
                type: item
                item: P9999_USERNAME
            }
            advanced {
                displaySequence: 1
            }
        )

    )

    process set-username-cookie (
        name: Set Username Cookie
        type: invokeApi
        invoke {
            package: APEX_AUTHENTICATION
            procedureOrFunction: SEND_LOGIN_USERNAME_COOKIE
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 3072157592829088
        }
        serverSideCondition {
            whenButtonPressed: @login
        }

        parameter p_consent (
            parameter {
                dataType: boolean
            }
            value {
                type: item
                item: P9999_REMEMBER
            }
            advanced {
                displaySequence: 2
            }
        )

        parameter p_username (
            value {
                type: expression
                plsqlExpression: lower( :P9999_USERNAME )
            }
            advanced {
                displaySequence: 1
            }
        )

    )

)
